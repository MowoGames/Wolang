// The platform floor for a server: the handful of calls a socket needs.
//
// Everything above this file is Wolang. These are the only lines in
// `wolang-http` that leave the language, which is the same arrangement
// `std.io` has with `write` -- and the reason both declare `uses unsafe`
// and take responsibility for it rather than passing it upwards.
//
// What they leave into is the runtime's own socket calls rather than the
// system's: Berkeley's interface is the same everywhere except on
// Windows, and a language with no conditional compilation cannot write a
// binding twice (D158).

extern "C" fun wolang_socket_open() -> s64 uses net
extern "C" fun wolang_socket_listen(
    socket: s64,
    address: u32,
    port: u32,
    backlog: s32) -> s32 uses net
extern "C" fun wolang_socket_accept(socket: s64) -> s64 uses net
extern "C" fun wolang_socket_send(socket: s64, bytes: *u8, count: s64) -> s64 uses net
extern "C" fun wolang_socket_receive(socket: s64, bytes: *mut u8, room: s64) -> s64 uses net
extern "C" fun wolang_socket_close(socket: s64) -> s32 uses net
extern "C" fun wolang_socket_reuse(socket: s64, on: s32) -> s32 uses net
extern "C" fun wolang_socket_nodelay(socket: s64, on: s32) -> s32 uses net

/// Opens a listening socket on `port`, or a negative number on failure.
offer fun Listen(port: int, backlog: int) -> s32 uses net, unsafe {
  const fd = wolang_socket_open()
  if fd < 0 {
    return -1
  }
  // Let the port be reused, or a restarted server waits for the system
  // to let go of the last one. On a system that has `SO_REUSEPORT` this
  // also asks for it, which is what makes `ListenShared` work (D135).
  const _option = wolang_socket_reuse(fd, 1)
  if wolang_socket_listen(fd, 0, port as u32, backlog as s32) < 0 {
    const _closed = wolang_socket_close(fd)
    return -2
  }
  return fd as s32
}

/// The same, with the port shared between threads.
///
/// `SO_REUSEPORT` gives each listener its own accept queue on the same
/// port and lets the system spread connections across them: one listener
/// per thread is what makes a multi-threaded server scale, and sharing
/// one listener instead makes every thread wake for every connection
/// (D135). On a system without it this is one listener, which still
/// works with one thread.
offer fun ListenShared(port: int, backlog: int) -> s32 uses net, unsafe {
  return Listen(port, backlog)
}

/// Waits for the next connection.
offer fun Accept(listener: s32) -> s32 uses net, unsafe {
  const fd = wolang_socket_accept(listener as s64)
  if fd >= 0 {
    // Send what we write when we write it. Without this a small response
    // waits for the previous one to be acknowledged, which on a local
    // connection is most of the time a request takes.
    const _option = wolang_socket_nodelay(fd, 1)
  }
  return fd as s32
}

offer fun Close(fd: s32) -> s32 uses net, unsafe {
  return wolang_socket_close(fd as s64)
}

/// Reads into `buffer` and returns how many bytes arrived, or a negative
/// number. The buffer is the caller's, which is what makes this allocate
/// nothing per request.
offer unsafe fun Read(fd: s32, buffer: *mut u8, capacity: int) -> int uses net {
  return wolang_socket_receive(fd as s64, buffer, capacity as s64) as int
}

/// Writes all of `message`, which may take more than one call: a socket
/// is allowed to accept part of what it was given.
offer fun WriteAll(fd: s32, message: text) -> bool uses net, unsafe {
  var sent = 0
  const total = message.len
  while sent < total {
    // From where the last call stopped: a socket is allowed to take part
    // of what it was given, and starting over would send the beginning
    // twice.
    const written = wolang_socket_send(
        fd as s64,
        message.data + sent,
        (total - sent) as s64) as int
    if written <= 0 {
      return false
    }
    sent = sent + written
  }
  return true
}
