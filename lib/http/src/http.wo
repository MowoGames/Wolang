// HTTP/1.1, enough of it to serve an API.
//
// The parser works on the bytes the socket gave us and makes no copies: a
// method and a path are views into the request buffer, which is the whole
// reason they cost nothing. What a handler returns is a string, and a
// string that was built comes from the arena the connection opened -- so a
// request pays for its allocations once and gives them all back.

need std.io.{Print}
need std.mem.{BytesFromRaw}
need std.text.{Bytes, BuilderNew, TextFromRaw}
need std.time.{HttpDate, WallClock}

// `socket.wo` is the same module -- a package's files link into one -- so
// the floor it declares needs no import here.

/// One name and one value: a header, a query parameter, a path
/// parameter. The same shape for all three, because the work -- find the
/// one called this -- is the same (D112).
offer struct Pair {
  var name: text = ""
  var value: text = ""
}

// How many headers and path parameters a request holds.
//
// Fixed rather than grown: a request *is* views into the connection's
// buffer, and a list that owns its storage would make a request something
// that has to be destroyed -- which a value handed to a handler, rebuilt
// by a router and dropped at the end of a turn is a bad fit for (D112).
// A request with more headers than this keeps the first ones.
offer const kMostHeaders: int = 24
offer const kMostParams: int = 8

/// A request, as views into the buffer it was read from.
///
/// Everything here is a view: the bytes stay in the connection's buffer
/// until the turn is over, which is what makes reading a request cost no
/// allocation at all.
offer struct Request {
  var method: text = ""
  var path: text = ""
  // What came after `?`, unparsed. `Query` is what reads it.
  var query: text = ""
  var body: text = ""
  var headers: [24]Pair
  var header_count: int = 0
  // What the router matched: `/users/:id` against `/users/7` puts `id`
  // here.
  var params: [8]Pair
  var param_count: int = 0
  var length: int = 0
  // Which version the client spoke. It decides what happens to the
  // connection when the client says nothing: 1.1 keeps it, 1.0 closes
  // it, and a 1.0 client left waiting for an end that never comes is
  // what `ab` reported as a timeout (D136).
  var http_11: bool = true
}

/// An empty request, to fill in.
///
/// The arrays are not written here: an element nobody filled is never
/// read, because the counts say how many there are.
offer fun RequestNew() -> Request {
  var headers: [24]Pair
  var params: [8]Pair
  return Request("", "", "", "", headers, 0, params, 0, 0, true)
}

/// What a handler answers with.
///
/// Its headers are a fixed run for the same reason a request's are: a
/// response is built, handed on and written, and a list that owns its
/// storage would make every one of those a question about who frees it
/// (D112).
offer const kMostAnswerHeaders: int = 8

offer struct Response {
  var status: int
  var body: text
  var kind: text
  var headers: [8]Pair
  var header_count: int
}

fun Answering(status: int, body: text, kind: text) -> Response {
  var headers: [8]Pair
  return Response(status, body, kind, headers, 0)
}

/// The value of the header called `name`, or `fallback`.
///
/// Compared without regard to case, because a client may send
/// `Content-Type` or `content-type` and both mean the same header.
offer fun Header(request: &Request, name: text, fallback: text) -> text
    uses unsafe {
  var i = 0
  while i < request.header_count {
    const held = request.headers[i]
    if SameName(held.name, name) {
      return held.value
    }
    i = i + 1
  }
  return fallback
}

/// The query parameter called `name`, or `fallback`.
///
/// `?a=1&b=two` is read on demand rather than up front: most handlers
/// want one of them, and splitting the rest costs a pass over bytes
/// nobody reads.
offer fun Query(request: &Request, name: text, fallback: text) -> text
    uses unsafe {
  const bytes = Bytes(request.query)
  var at = 0
  while at < bytes.len {
    const equals = SpanToAny(bytes, at, 61, 38)
    const end = SpanTo(bytes, at, 38)
    if equals < end {
      const key = Slice(bytes, at, equals) as text
      if key == name {
        return Slice(bytes, equals + 1, end) as text
      }
    }
    at = end + 1
  }
  return fallback
}

/// The path parameter called `name`, or `fallback`: what the router
/// matched for `:name`.
offer fun Param(request: &Request, name: text, fallback: text) -> text
    uses unsafe {
  var i = 0
  while i < request.param_count {
    const held = request.params[i]
    if held.name == name {
      return held.value
    }
    i = i + 1
  }
  return fallback
}

// Whether two header names are the same, ignoring case.
fun SameName(left: text, right: text) -> bool uses unsafe {
  const a = Bytes(left)
  const b = Bytes(right)
  if a.len != b.len {
    return false
  }
  var i = 0
  while i < a.len {
    if Lower(a[i]) != Lower(b[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

fun Lower(byte: u8) -> u8 {
  if byte >= 65 && byte <= 90 {
    return byte + 32
  }
  return byte
}

// ---------------------------------------------------------- answering ---

/// `200 OK`, as plain text.
offer fun Ok(body: text) -> Response {
  return Answering(200, body, "text/plain")
}

/// `200 OK`, as a JSON document. The body is written as it is: a handler
/// that has a `Json` value writes it with `json.Write` first.
offer fun OkJson(body: text) -> Response {
  return Answering(200, body, "application/json")
}

/// `201 Created`, with where the thing was created.
offer fun Created(location: text, body: text) -> Response {
  return WithHeader(Answering(201, body, "application/json"), "Location",
                    location)
}

offer fun NoContent() -> Response {
  return Answering(204, "", "text/plain")
}

offer fun NotFound() -> Response {
  return Answering(404, "not found\n", "text/plain")
}

offer fun BadRequest(why: text) -> Response {
  return Answering(400, why, "text/plain")
}

offer fun Status(status: int, body: text) -> Response {
  return Answering(status, body, "text/plain")
}

/// The same response with one more header on it. Answers the response, so
/// calls chain.
offer fun WithHeader(answer: Response, name: text, value: text)
    -> Response {
  var held = answer
  if held.header_count < kMostAnswerHeaders {
    held.headers[held.header_count] = Pair(name, value)
    held.header_count = held.header_count + 1
  }
  return held
}

/// The same response with a different content type.
offer fun WithType(answer: Response, kind: text) -> Response {
  var held = answer
  held.kind = kind
  return held
}

/// Finds the end of the request line's first word, starting at `from`.
fun SpanTo(bytes: []u8, from: int, stop: u8) -> int {
  var at = from
  while at < bytes.len {
    if bytes[at] == stop {
      return at
    }
    at = at + 1
  }
  return bytes.len
}

/// Splits `GET /path HTTP/1.1` into its first two words.
///
/// Returns a request whose `length` is zero when the line is not one: a
/// parser that cannot say "this is not a request" is not a parser.
offer fun ParseRequest(bytes: []u8, received: int) -> Request uses unsafe {
  var request = RequestNew()
  if received <= 0 {
    return request
  }
  const line = SpanTo(bytes, 0, 13)
  const method_end = SpanTo(bytes, 0, 32)
  if method_end >= line {
    return request
  }
  const target_end = SpanTo(bytes, method_end + 1, 32)
  request.method = Slice(bytes, 0, method_end) as text
  // `HTTP/1.1` or `HTTP/1.0`, after the target. Anything else is read as
  // 1.0, which is the cautious reading: close when in doubt.
  if target_end + 8 <= bytes.len {
    request.http_11 = bytes[target_end + 6] == 49 &&
                      bytes[target_end + 8] == 49
  }
  // The target is `/path?query`, and the query is whatever follows the
  // first `?`.
  const question = SpanToAny(bytes, method_end + 1, 63, 32)
  request.path = Slice(bytes, method_end + 1, question) as text
  if question < target_end {
    request.query = Slice(bytes, question + 1, target_end) as text
  }

  // The headers, one per line, up to the empty line that ends them.
  var at = line + 2
  while at < received {
    const end = SpanTo(bytes, at, 13)
    if end <= at {
      // The empty line: the body starts after it.
      at = end + 2
      break
    }
    const colon = SpanToAny(bytes, at, 58, 13)
    if colon < end && request.header_count < kMostHeaders {
      var value = colon + 1
      // One space after the colon is the convention, and both forms are
      // legal.
      while value < end && bytes[value] == 32 {
        value = value + 1
      }
      request.headers[request.header_count] =
          Pair(Slice(bytes, at, colon) as text,
               Slice(bytes, value, end) as text)
      request.header_count = request.header_count + 1
    }
    at = end + 2
  }

  // The body is what the headers said there would be, as far as it
  // arrived: a handler that wants all of it checks the length.
  request.length = received
  if at < received {
    const said = ParseInt(Header(&request, "Content-Length", ""))
    var size = received - at
    if said > 0 && said < size {
      size = said
    }
    request.body = Slice(bytes, at, at + size) as text
  }
  return request
}

/// The number `value` spells, or zero. Stops at the first byte that is
/// not a digit, which is what a `Content-Length` with anything after it
/// deserves.
offer fun ParseInt(value: text) -> int uses unsafe {
  const bytes = Bytes(value)
  var total = 0
  var i = 0
  var seen = 0
  while i < bytes.len {
    const byte = bytes[i]
    if byte < 48 || byte > 57 {
      break
    }
    total = total * 10 + (byte - 48) as int
    seen = seen + 1
    i = i + 1
  }
  if seen == 0 {
    return 0
  }
  return total
}

/// Where the first `stop` or `other` is, from `from`.
fun SpanToAny(bytes: []u8, from: int, stop: u8, other: u8) -> int {
  var at = from
  while at < bytes.len {
    if bytes[at] == stop || bytes[at] == other {
      return at
    }
    at = at + 1
  }
  return bytes.len
}

/// A view of `bytes` from `from` up to `to`. The one place that needs to
/// make a view out of part of a buffer, so the one place that is unsafe.
fun Slice(bytes: []u8, from: int, to: int) -> []u8 uses unsafe {
  if from >= to || from < 0 || to > bytes.len {
    return BytesFromRaw(bytes.data, 0)
  }
  return BytesFromRaw(&bytes[from], to - from)
}

/// Serves a connection until the client stops asking.
///
/// One request per turn, each inside an arena of its own: everything a
/// request allocates -- its response, the strings it interpolated -- comes
/// from there and goes back at the end of the turn. Keep-alive is what
/// makes that worth doing, because the connection outlives the arena.
offer fun Serve(connection: s32, handle: fun(Request) -> Response) -> int
    uses io, unsafe {
  return ServeWith(connection, handle, LimitsDefault())
}

/// The same, with limits of the caller's choosing.
///
/// One connection, served until the client stops asking or breaks the
/// rules: every request is read whole before the handler sees it, and
/// what arrived after it stays for the next turn (D122).
offer fun ServeWith(connection: s32, handle: fun(Request) -> Response,
                    limits: Limits) -> int uses io, unsafe {
  var pool = ConnectionsNew(1, limits)
  const slot = pool.Open(connection as int)
  var served = 0
  loop {
    const turn = Turn(&mut pool, slot, handle)
    if turn > 0 {
      served = served + 1
      if !pool.IsClosing(slot) {
        continue
      }
    }
    const _closed = Close(connection)
    return served
  }
}

/// One turn on one connection: read what is there, answer every whole
/// request in it, and say whether the connection is still worth holding.
///
/// `1` when a request was answered, `0` when more is wanted, and `-1`
/// when the connection is finished. A server that polls calls this once
/// per readable connection; a blocking one calls it in a loop.
offer fun Turn(pool: &mut Connections, slot: int,
               handle: fun(Request) -> Response) -> int uses io, unsafe {
  const fd = pool.Fd(slot)
  if fd < 0 {
    return -1
  }
  const received = pool.Fill(slot)
  if received < 0 {
    // -2 is "no room and not allowed to grow", which is a request bigger
    // than the server takes rather than a broken connection.
    if received == -2 {
      const _said = WriteAnswer(fd as s32, Status(413, "too large\n"),
                                true, false)
    }
    return -1
  }
  if received == 0 && pool.Filled(slot) == 0 {
    return -1
  }

  var answered = 0
  loop {
    const length =
        RequestLength(pool.Bytes(slot), pool.Filled(slot), pool.limits)
    if length == -1 {
      // Not all here yet. The next read continues where this one stopped.
      if answered > 0 {
        return 1
      }
      return 0
    }
    if length == -3 {
      const _said = WriteAnswer(fd as s32, Status(413, "too large\n"),
                                true, false)
      pool.SetClosing(slot, true)
      return -1
    }
    if length <= 0 {
      const _said = WriteAnswer(fd as s32, BadRequest("bad request\n"),
                                true, false)
      pool.SetClosing(slot, true)
      return -1
    }

    var ok = false
    arena {
      ok = Answer(fd as s32, pool.Bytes(slot), length, handle,
                  pool.limits.keep_alive)
    }
    pool.Consume(slot, length)
    answered = answered + 1
    if !ok {
      pool.SetClosing(slot, true)
      return 1
    }
    if pool.Filled(slot) == 0 {
      return 1
    }
    // Another request arrived in the same read: answer it now rather than
    // waiting for the client to say something it already said.
  }
}

/// One request: parse it, hand it to the handler, write the answer.
///
/// Answers whether the connection is worth keeping: false when the
/// request was not one, or when either side asked for it to close.
fun Answer(
    connection: s32,
    buffer: []u8,
    received: int,
    handle: fun(Request) -> Response,
    keep_alive: bool) -> bool uses io, unsafe {
  const request = ParseRequest(buffer, received)
  if request.length == 0 {
    const _bad = WriteAll(
        connection,
        "HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\n\r\n")
    return false
  }
  // What the client wants to happen to the connection after this. A 1.1
  // client that says nothing means keep it; a 1.0 client that says
  // nothing means close it (D136).
  var holding = keep_alive && request.http_11
  const said = Header(&request, "Connection", "")
  if SameName(said, "close") {
    holding = false
  } else if keep_alive && SameName(said, "keep-alive") {
    holding = true
  }
  const answer = handle(request)
  // A `HEAD` asks for the headers a `GET` would give, body length and
  // all, and gets none of the body.
  const with_body = !SameName(request.method, "HEAD") &&
                    answer.status != 204 && answer.status != 304
  if !WriteAnswer(connection, answer, with_body, holding) {
    return false
  }
  return holding
}

/// Writes a response: the status line, the headers it carries, and the
/// body.
///
/// One write, because two writes of a small response wait for each other
/// on a socket -- the second is held back until the first is
/// acknowledged -- which costs more than building the string does.
offer fun WriteResponse(connection: s32, answer: Response) -> bool
    uses io, unsafe {
  return WriteAnswer(connection, answer, /*with_body=*/true,
                     /*keep_alive=*/true)
}

/// The same, told whether to write the body and whether the connection
/// stays open.
///
/// A `HEAD` is a `GET` whose body is not written -- the length still says
/// what it would have been, which is the whole point of asking -- and a
/// client that said `Connection: close` is told the server agrees before
/// the socket goes away (D122).
offer fun WriteAnswer(connection: s32, answer: Response, with_body: bool,
                      keep_alive: bool) -> bool uses io, unsafe {
  var message = BuilderNew()
  message.Append("HTTP/1.1 {answer.status} {Reason(answer.status)}\r\n")
  message.Append("Content-Length: {answer.body.len}\r\n")
  message.Append("Content-Type: {answer.kind}\r\n")
  if keep_alive {
    message.Append("Connection: keep-alive\r\n")
  } else {
    message.Append("Connection: close\r\n")
  }
  message.Append("Date: {Date()}\r\n")
  var i = 0
  while i < answer.header_count {
    const held = answer.headers[i]
    message.Append("{held.name}: {held.value}\r\n")
    i = i + 1
  }
  message.Append("\r\n")
  if with_body {
    message.Append(answer.body)
  }
  return WriteAll(connection, message.Text())
}

// The date, and the second it was written for.
//
// An HTTP date has one-second resolution, so a server answering
// thousands of requests a second writes it once and hands out the same
// bytes -- a calendar calculation and several allocations per response
// saved (D134).
//
// In a *buffer*, not in a string: a string built inside a request's
// `arena` block belongs to that block, so a global holding one points at
// reclaimed memory as soon as the request is over. Which is exactly what
// happened, and what `ab` saw as responses of differing length (D136).
var date_bytes: [40]u8
var date_length: int = 0
var date_second: s64 = -1

/// The date header, in the format HTTP wants.
offer fun Date() -> text uses unsafe {
  const now = WallClock().seconds
  if now != date_second {
    date_second = now
    const built = HttpDate(now)
    const bytes = Bytes(built)
    var i = 0
    while i < bytes.len && i < 40 {
      date_bytes[i] = bytes[i]
      i = i + 1
    }
    date_length = i
  }
  return TextFromRaw(&date_bytes[0], date_length)
}

fun Reason(status: int) -> text {
  if status == 200 {
    return "OK"
  }
  if status == 201 {
    return "Created"
  }
  if status == 204 {
    return "No Content"
  }
  if status == 400 {
    return "Bad Request"
  }
  if status == 401 {
    return "Unauthorized"
  }
  if status == 403 {
    return "Forbidden"
  }
  if status == 404 {
    return "Not Found"
  }
  if status == 405 {
    return "Method Not Allowed"
  }
  if status == 409 {
    return "Conflict"
  }
  if status == 422 {
    return "Unprocessable Content"
  }
  if status == 301 {
    return "Moved Permanently"
  }
  if status == 302 {
    return "Found"
  }
  if status == 303 {
    return "See Other"
  }
  if status == 304 {
    return "Not Modified"
  }
  if status == 307 {
    return "Temporary Redirect"
  }
  if status == 308 {
    return "Permanent Redirect"
  }
  if status == 206 {
    return "Partial Content"
  }
  if status == 402 {
    return "Payment Required"
  }
  if status == 406 {
    return "Not Acceptable"
  }
  if status == 408 {
    return "Request Timeout"
  }
  if status == 410 {
    return "Gone"
  }
  if status == 413 {
    return "Content Too Large"
  }
  if status == 415 {
    return "Unsupported Media Type"
  }
  if status == 429 {
    return "Too Many Requests"
  }
  if status == 501 {
    return "Not Implemented"
  }
  if status == 502 {
    return "Bad Gateway"
  }
  if status == 503 {
    return "Service Unavailable"
  }
  if status == 504 {
    return "Gateway Timeout"
  }
  if status == 500 {
    return "Internal Server Error"
  }
  return "Error"
}

/// Listens on `port` and serves one connection after another, each inside
/// an arena of its own.
offer fun Run(port: int, handle: fun(Request) -> Response) -> s32 uses io, unsafe {
  const listener = Listen(port, 128)
  if listener < 0 {
    Print("http: cannot listen")
    return listener
  }
  Print("http: listening")
  loop {
    const connection = Accept(listener)
    if connection < 0 {
      continue
    }
    // The connection is served until the client stops asking; each
    // request inside it gets an arena of its own.
    const _served = Serve(connection, handle)
  }
}

/// The same server, holding many connections at once.
///
/// One loop, one thread, and a poller that says which connections have
/// something to say (D95). A blocking `Serve` holds one client no matter
/// how fast the rest of the server is; this holds as many as the system
/// will give descriptors for, and the cost per idle connection is one
/// entry in a kernel table.
///
/// `most` is how many ready descriptors one wait may report. Everything
/// else waits for the next turn, which is what keeps one noisy client
/// from starving the rest.
offer fun RunPolled(port: int, most: int,
                    handle: fun(Request) -> Response) -> s32
    uses io, unsafe {
  return RunServer(port, most, handle, LimitsDefault())
}

/// The polled server, with limits of the caller's choosing.
///
/// One loop, one thread, and a poller that says which connections have
/// something to say (D95). Each connection has a buffer of its own, so a
/// request that arrives in pieces is put together rather than parsed in
/// halves (D122).
offer fun RunServer(port: int, most: int,
                    handle: fun(Request) -> Response,
                    limits: Limits) -> s32 uses io, unsafe {
  return RunServerOn(Listen(port, 128), most, handle, limits)
}

/// The same loop, on a listener the caller opened.
///
/// What a multi-threaded server needs: each thread opens its own
/// listener on the same port and runs this (D135).
offer fun RunServerOn(listener: s32, most: int,
                      handle: fun(Request) -> Response,
                      limits: Limits) -> s32 uses io, unsafe {
  if listener < 0 {
    Print("http: cannot listen")
    return listener
  }
  var poller = PollerNew(most)
  if !poller.IsOpen() {
    Print("http: cannot poll")
    return -1
  }
  var pool = ConnectionsNew(most, limits)
  const _listening = SetNonBlocking(listener)
  if !poller.Watch(listener) {
    Print("http: cannot watch the listener")
    return -1
  }
  Print("http: listening, polled")

  loop {
    const ready = poller.Wait(1000)
    if ready <= 0 {
      continue
    }
    var i = 0
    while i < ready {
      const fd = poller.At(i)
      i = i + 1
      if fd == listener {
        // Everything waiting to be accepted, not just one: the listener
        // reports readable once per turn however many arrived.
        loop {
          const connection = Accept(listener)
          if connection < 0 {
            break
          }
          const _client = SetNonBlocking(connection)
          const slot = pool.Open(connection as int)
          if slot < 0 || !poller.Watch(connection) {
            // Nowhere to put it: refuse rather than hold a connection
            // whose bytes have no home. That is the server's back
            // pressure, and saying so beats a silent close.
            const _said = WriteAnswer(
                connection, Status(503, "too many connections\n"), true,
                false)
            if slot >= 0 {
              pool.Release(slot)
            }
            const _closed = Close(connection)
          }
        }
        continue
      }
      const slot = pool.Find(fd)
      if slot < 0 {
        const _forgotten = poller.Forget(fd)
        const _closed = Close(fd as s32)
        continue
      }
      // One turn per ready connection, so a client that keeps asking
      // does not hold the loop.
      const turn = Turn(&mut pool, slot, handle)
      if turn < 0 || pool.IsClosing(slot) {
        pool.Release(slot)
        const _forgotten = poller.Forget(fd)
        const _closed = Close(fd as s32)
      }
    }
  }
}

// ------------------------------------------------------------- tests ---

@Test
fun KeepsOrClosesAsTheClientAsked() -> bool uses unsafe {
  const closing = "GET / HTTP/1.1\r\nConnection: close\r\n\r\n"
  const bytes = Bytes(closing)
  const request = ParseRequest(bytes, bytes.len)
  return SameName(Header(&request, "connection", ""), "close") &&
         !SameName(Header(&request, "connection", ""), "keep-alive")
}

@Test
fun ReadsABodyThatArrivedWhole() -> bool uses unsafe {
  // What a split read puts together: the length says five, and five are
  // here.
  const text = "POST /x HTTP/1.1\r\nContent-Length: 5\r\n\r\nhello"
  const bytes = Bytes(text)
  const request = ParseRequest(bytes, bytes.len)
  return request.body == "hello" && request.method == "POST"
}
