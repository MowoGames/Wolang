// An application: routes, layers, and the loop around them.
//
// `Router` says what answers what and `Layers` says what happens around
// it; this is the pair, and `Serve(app, port)` is the one call a program
// makes. Which is as close to `axum::serve(listener, app)` as a language
// without closures gets -- and the difference is that the state a
// handler needs is a module-level `var` rather than something cloned into
// every closure.

need std.list.{ListNew}
need std.log.{At, Level}
need std.thread.{Parallelism, Spawn, Thread}

/// Routes and the layers around them.
offer class App {
  var router: Router
  var layers: Layers
  var limits: Limits

  /// A route for `GET`. The same names a router has, so an application
  /// can be built without reaching inside it.
  fun Get(pattern: text, handle: keep fun(Request) -> Response) uses unsafe {
    router.Get(pattern, handle)
  }

  fun Post(pattern: text, handle: keep fun(Request) -> Response) uses unsafe {
    router.Post(pattern, handle)
  }

  fun Put(pattern: text, handle: keep fun(Request) -> Response) uses unsafe {
    router.Put(pattern, handle)
  }

  fun Patch(pattern: text, handle: keep fun(Request) -> Response) uses unsafe {
    router.Patch(pattern, handle)
  }

  fun Delete(pattern: text, handle: keep fun(Request) -> Response) uses unsafe {
    router.Delete(pattern, handle)
  }

  fun Any(pattern: text, handle: keep fun(Request) -> Response) uses unsafe {
    router.Any(pattern, handle)
  }

  fun Otherwise(handle: keep fun(Request) -> Response) uses unsafe {
    router.Otherwise(handle)
  }

  fun Mount(prefix: text, inner: &Router) uses unsafe {
    router.Mount(prefix, inner)
  }

  /// A layer that runs before every handler, and may answer instead.
  fun Use(run: keep fun(&mut Request) -> Response?) uses unsafe {
    layers.Use(run)
  }

  /// A layer that runs after every handler.
  fun Then(run: keep fun(&Request, Response) -> Response) uses unsafe {
    layers.Then(run)
  }
}

offer fun AppNew() -> App uses unsafe {
  return App(RouterNew(), LayersNew(), LimitsDefault())
}

// The application the server loop answers from. A module-level `var` for
// the same reason the router was one: a loop cannot carry it in a closure
// (D106, D112).
var running: App = App(
    Router(ListNew<Route>(), NotFoundHandler, false),
    Layers(ListNew<Before>(), ListNew<After>()),
    Limits(1048576, 16384, true, 10, 60))

fun Handle(request: Request) -> Response uses io, time, unsafe {
  return Through(&running.layers, request, Routed)
}

fun Routed(request: Request) -> Response uses io, unsafe {
  return Dispatch(&running.router, request)
}

/// Serves `app` on `port` until the program stops.
///
/// `Serve` is taken by the one-connection loop, so the application's
/// entry point says what it serves.
///
/// `most` connections at once, each with a buffer of its own.
offer fun ServeApp(app: App, port: int, most: int) -> s32 uses io, net, time, unsafe {
  running = app
  At(Level.Info, "serving on port {port}")
  return RunServer(port, most, Handle, app.limits)
}

/// The same, with the usual layers already on: a line per request, the
/// security headers, and CORS.
///
/// What a program that has not decided anything yet should call, because
/// every one of those is something a server wants and none of them is
/// something a handler should have to remember.
offer fun ServeWithDefaults(app: App, port: int, most: int) -> s32 uses io, net, time, unsafe {
  var held = app
  held.layers.Use(Timing)
  held.layers.Use(Preflight)
  held.layers.Then(Logged)
  held.layers.Then(SecurityHeaders)
  held.layers.Then(Cors)
  return ServeApp(held, port, most)
}

// --------------------------------------------------------- many threads ---

// What the threads serve, and on what. Globals for the same reason the
// application is one: a thread's body takes no arguments (D135).
var serving_port: int = 0
var serving_most: int = 256

fun ServeOneThread() uses io, net, time, unsafe {
  // One listener per thread, on the same port: the kernel spreads
  // connections across them, so no two threads wake for the same one.
  const listener = ListenShared(serving_port, 512)
  if listener < 0 {
    At(Level.Error, "cannot listen on port {serving_port}")
    return
  }
  const _code = RunServerOn(listener, serving_most, Handle, running.limits)
}

/// Serves `app` on `port` from `threads` threads at once.
///
/// Zero threads means one per core. Every thread runs the same
/// application: a handler that keeps state in a module-level `var` is
/// sharing it across threads, and whether that is safe is the program's
/// business -- a counter wants `std.thread.AtomicAdd` and a table wants
/// a `Mutex` (D135).
offer fun ServeMany(app: App, port: int, most: int, threads: int) -> s32 uses io, net, time, unsafe {
  running = app
  serving_port = port
  serving_most = most
  var wanted = threads
  if wanted <= 0 {
    wanted = Parallelism()
  }
  At(Level.Info, "serving on port {port} from {wanted} threads")

  var started: [64]Thread
  var count = 0
  var i = 1
  while i < wanted && i < 64 {
    started[count] = Spawn(ServeOneThread)
    count = count + 1
    i = i + 1
  }
  // This thread serves too, so a one-thread server spawns nothing.
  ServeOneThread()
  var j = 0
  while j < count {
    started[j].Join()
    j = j + 1
  }
  return 0
}

// ------------------------------------------------------------- tests ---

fun Greet(_request: Request) -> Response {
  return Ok("hello")
}

fun Show(request: Request) -> Response uses unsafe {
  return Ok(Param(&request, "id", "none"))
}

fun Missing(_request: Request) -> Response {
  return Status(418, "nothing here\n")
}

@Test
fun RoutesThroughAnApplication() -> bool uses io, unsafe {
  var app = AppNew()
  app.Get("/health", Greet)
  app.Get("/users/:id", Show)
  app.Otherwise(Missing)

  var health = RequestNew()
  health.method = "GET"
  health.path = "/health"
  var user = RequestNew()
  user.method = "GET"
  user.path = "/users/7"
  var nothing = RequestNew()
  nothing.method = "GET"
  nothing.path = "/nowhere"

  const first = Dispatch(&app.router, health)
  const second = Dispatch(&app.router, user)
  const third = Dispatch(&app.router, nothing)
  return first.body == "hello" && second.body == "7" && third.status == 418
}

@Test
fun AnswersHeadAndOptionsItself() -> bool uses io, unsafe {
  var app = AppNew()
  app.Get("/thing", Greet)
  app.Post("/thing", Greet)

  var head = RequestNew()
  head.method = "HEAD"
  head.path = "/thing"
  var options = RequestNew()
  options.method = "OPTIONS"
  options.path = "/thing"
  var wrong = RequestNew()
  wrong.method = "DELETE"
  wrong.path = "/thing"

  const answered = Dispatch(&app.router, head)
  const said = Dispatch(&app.router, options)
  const refused = Dispatch(&app.router, wrong)
  return answered.status == 200 && said.status == 204 && said.headers[0].name == "Allow" && said.headers[0].value == "GET, POST, HEAD, OPTIONS" && refused.status == 405 && refused.headers[0].name == "Allow"
}

@Test
fun MountsOneRouterInsideAnother() -> bool uses io, unsafe {
  var inner = RouterNew()
  inner.Get("/users/:id", Show)
  var app = AppNew()
  app.Mount("/api/v1", &inner)

  var request = RequestNew()
  request.method = "GET"
  request.path = "/api/v1/users/9"
  const answer = Dispatch(&app.router, request)
  return answer.body == "9" && Together("/api/", "/x") == "/api/x" && Together(
      "/",
      "/x") == "/x" && Together("/api", "x") == "/api/x"
}

@Test
fun RunsLayersInAnApplication() -> bool uses io, time, unsafe {
  var app = AppNew()
  app.Get("/health", Greet)
  app.Then(SecurityHeaders)
  var request = RequestNew()
  request.method = "GET"
  request.path = "/health"
  const answer = Through(&app.layers, request, Greet)
  return answer.body == "hello" && answer.header_count == 3
}
