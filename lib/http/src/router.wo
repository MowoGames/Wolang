// Routing.
//
// A list of routes, each a method and a pattern, matched in the order
// they were added. A pattern is the path with `:name` where a value goes
// -- `/users/:id/posts/:post` -- and what matched is in the request's
// params for the handler to read (D112).
//
// No tree and no regular expressions: an API has tens of routes, the
// match is a walk over segments, and the walk is what makes `:id` cost
// nothing but a pair in a list.

need std.list.{List, ListNew}
need std.text.{BuilderNew, Bytes, EndsWith, StartsWith, Substring}

/// One route: which method, which pattern, and what answers it.
offer struct Route {
  var method: text
  var pattern: text
  var handle: fun(Request) -> Response
}

/// A list of routes, tried in order.
offer class Router {
  var routes: List<Route>
  var fallback: fun(Request) -> Response = NotFoundHandler
  var has_fallback: bool = false

  /// Adds a route. Answers nothing: a router is built once, at the top of
  /// a program, so the calls read as a list rather than as a chain.
  fun Add(method: text, pattern: text, handle: fun(Request) -> Response) uses unsafe {
    routes.Push(Route(method, pattern, handle))
  }

  fun Get(pattern: text, handle: fun(Request) -> Response) uses unsafe {
    Add("GET", pattern, handle)
  }

  fun Post(pattern: text, handle: fun(Request) -> Response) uses unsafe {
    Add("POST", pattern, handle)
  }

  fun Put(pattern: text, handle: fun(Request) -> Response) uses unsafe {
    Add("PUT", pattern, handle)
  }

  fun Delete(pattern: text, handle: fun(Request) -> Response) uses unsafe {
    Add("DELETE", pattern, handle)
  }

  fun Patch(pattern: text, handle: fun(Request) -> Response) uses unsafe {
    Add("PATCH", pattern, handle)
  }

  /// A route for `HEAD`. Rarely needed: a `GET` route answers `HEAD` by
  /// itself, with the body left off (D122).
  fun Head(pattern: text, handle: fun(Request) -> Response) uses unsafe {
    Add("HEAD", pattern, handle)
  }

  fun Options(pattern: text, handle: fun(Request) -> Response) uses unsafe {
    Add("OPTIONS", pattern, handle)
  }

  /// One handler for every method on a pattern.
  fun Any(pattern: text, handle: fun(Request) -> Response) uses unsafe {
    Add("*", pattern, handle)
  }

  /// What answers when nothing else matches. Without one, `404`.
  fun Otherwise(handle: fun(Request) -> Response) uses unsafe {
    fallback = handle
    has_fallback = true
  }

  /// Another router's routes, with `prefix` in front of each.
  ///
  /// Copied rather than nested: a route is a pattern and a function, so
  /// mounting is prefixing -- and the match stays one walk over segments
  /// instead of a walk per level (D126).
  fun Mount(prefix: text, inner: &Router) uses unsafe {
    var i = 0
    while i < inner.routes.Len() {
      const route = inner.routes.At(i)
      Add(route.method, Together(prefix, route.pattern), route.handle)
      i = i + 1
    }
  }

  /// The methods a path has routes for, as `GET, POST`.
  ///
  /// What `405` and `OPTIONS` both have to say, and the one question a
  /// list of routes cannot answer without walking it twice.
  fun Allowed(path: text) -> text uses unsafe {
    var builder = BuilderNew()
    var found = 0
    var i = 0
    while i < routes.Len() {
      const route = routes.At(i)
      var probe = RequestNew()
      if Matches(route.pattern, path, &mut probe) {
        if found != 0 {
          builder.Append(", ")
        }
        builder.Append(route.method)
        found = found + 1
      }
      i = i + 1
    }
    if found != 0 {
      builder.Append(", HEAD, OPTIONS")
    }
    return builder.Release()
  }

  /// How many routes there are.
  fun Len() -> int {
    return routes.Len()
  }
}

/// What a router answers with when it has no route and no fallback.
offer fun NotFoundHandler(_request: Request) -> Response {
  return NotFound()
}

offer fun RouterNew() -> Router uses unsafe {
  return Router(ListNew<Route>(), NotFoundHandler, false)
}

/// Two path pieces with one slash between them.
offer fun Together(prefix: text, pattern: text) -> text uses unsafe {
  if prefix.len == 0 || prefix == "/" {
    return pattern
  }
  var head = prefix
  if EndsWith(head, "/") {
    head = Substring(head, 0, head.len - 1)
  }
  if pattern.len == 0 || pattern == "/" {
    return head
  }
  if StartsWith(pattern, "/") {
    return head + pattern
  }
  return head + "/" + pattern
}

/// Finds the route for `request`, fills in its path parameters, and
/// answers with what the handler said.
///
/// `404` when no pattern matches the path, and `405` when one does but
/// not for this method -- which is the difference between "no such thing"
/// and "not like that".
offer fun Dispatch(router: &Router, request: Request) -> Response uses io, unsafe {
  var subject = request
  var matched_path = false
  var i = 0
  while i < router.Len() {
    const route = router.routes.At(i)
    // Written into the request rather than handed alongside it: a
    // handler takes a request and nothing else, and `:id` is part of
    // what the request was (D112).
    subject.param_count = 0
    if Matches(route.pattern, subject.path, &mut subject) {
      matched_path = true
      if route.method == subject.method || route.method == "*" {
        return route.handle(subject)
      }
      // A `HEAD` is answered by the `GET` route; the body is left off
      // when the answer is written (D122).
      if SameName(subject.method, "HEAD") && route.method == "GET" {
        return route.handle(subject)
      }
    }
    i = i + 1
  }
  if matched_path {
    // `OPTIONS` on a path that exists is answered by saying what may be
    // done to it, which is the whole of what the method is for.
    if SameName(subject.method, "OPTIONS") {
      return WithHeader(NoContent(), "Allow", router.Allowed(subject.path))
    }
    return WithHeader(
        Status(405, "method not allowed\n"),
        "Allow",
        router.Allowed(subject.path))
  }
  if router.has_fallback {
    subject.param_count = 0
    return router.fallback(subject)
  }
  return NotFound()
}

/// Whether `pattern` matches `path`, filling `params` with what `:name`
/// stood for.
///
/// Segment by segment: `:name` takes whatever is in that segment, `*`
/// takes the rest, and anything else has to be equal.
offer fun Matches(pattern: text, path: text, into: &mut Request) -> bool uses unsafe {
  const want = Bytes(pattern)
  const have = Bytes(path)
  var at_want = 0
  var at_have = 0
  loop {
    at_want = SkipSlashes(want, at_want)
    at_have = SkipSlashes(have, at_have)
    if at_want >= want.len {
      // The pattern is finished: so must the path be.
      return at_have >= have.len
    }
    if want[at_want] == 42 {
      // `*`: the rest of the path, whatever it is.
      return true
    }
    if at_have >= have.len {
      return false
    }
    const want_end = SegmentEnd(want, at_want)
    const have_end = SegmentEnd(have, at_have)
    if want[at_want] == 58 {
      // `:name`: this segment is the value.
      const name = SliceOf(want, at_want + 1, want_end) as text
      const value = SliceOf(have, at_have, have_end) as text
      if into.param_count < kMostParams {
        into.params[into.param_count] = Pair(name, value)
        into.param_count = into.param_count + 1
      }
    } else {
      const left = SliceOf(want, at_want, want_end) as text
      const right = SliceOf(have, at_have, have_end) as text
      if left != right {
        return false
      }
    }
    at_want = want_end
    at_have = have_end
  }
}

fun SkipSlashes(bytes: []u8, from: int) -> int {
  var at = from
  while at < bytes.len && bytes[at] == 47 {
    at = at + 1
  }
  return at
}

fun SegmentEnd(bytes: []u8, from: int) -> int {
  var at = from
  while at < bytes.len && bytes[at] != 47 {
    at = at + 1
  }
  return at
}

// The same view-of-part-of-a-buffer the request parser needs, under its
// own name because a package's files share one module and `Slice` is
// already taken there.
fun SliceOf(bytes: []u8, from: int, to: int) -> []u8 uses unsafe {
  return Slice(bytes, from, to)
}

// ------------------------------------------------------------ serving ---

// A router the server loop can reach without a closure.
//
// A closure takes nothing with it (D106), so the loop cannot carry the
// router in one -- and a module-level `var` is what the language has for
// "one of these, for the program" (D88). Set by `ServeRoutes`, read by
// the handler it installs.
var serving: Router = Router(ListNew<Route>(), NotFoundHandler, false)

fun Installed(request: Request) -> Response uses io, unsafe {
  return Dispatch(&serving, request)
}

/// Listens on `port` and answers with `router`, polling for readiness.
///
/// What a program serving an API calls: the router says what answers
/// what, and this is the loop around it (D112).
offer fun ServeRoutes(port: int, most: int, router: Router) -> s32 uses io, unsafe {
  serving = router
  return RunPolled(port, most, Installed)
}

// ------------------------------------------------------------- tests ---

@Test
fun MatchesAPlainPath() -> bool uses unsafe {
  var request = RequestNew()
  return Matches("/health", "/health", &mut request) && !Matches(
      "/health",
      "/healthz",
      &mut request) && !Matches("/health", "/health/more", &mut request)
}

@Test
fun TakesWhatAPatternNames() -> bool uses unsafe {
  var request = RequestNew()
  const matched = Matches(
      "/users/:id/posts/:post",
      "/users/7/posts/hello",
      &mut request)
  return matched && Param(&request, "id", "") == "7" && Param(
      &request,
      "post",
      "") == "hello" && Param(&request, "missing", "none") == "none"
}

@Test
fun AStarTakesTheRest() -> bool uses unsafe {
  var request = RequestNew()
  return Matches("/files/*", "/files/a/b/c.txt", &mut request) && Matches(
      "/files/*",
      "/files/",
      &mut request)
}

@Test
fun ReadsAQueryAndAHeader() -> bool uses unsafe {
  const text = "GET /search?q=wolang&page=2 HTTP/1.1\r\n" + "Host: localhost\r\nContent-Type: text/plain\r\n" + "Content-Length: 5\r\n\r\nhello"
  const bytes = Bytes(text)
  const request = ParseRequest(bytes, bytes.len)
  return request.method == "GET" && request.path == "/search" && Query(
      &request,
      "q",
      "") == "wolang" && Query(&request, "page", "") == "2" && Query(
      &request,
      "missing",
      "none") == "none" && Header(&request, "host", "") == "localhost" && Header(
      &request,
      "Content-Type",
      "") == "text/plain" && request.body == "hello"
}
