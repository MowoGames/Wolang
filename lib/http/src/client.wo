// Calling somebody else's API.
//
// A server is half of HTTP; a program that cannot call one is a program
// that cannot use anything. This is the other half: a URL, a request, a
// response read back -- over `std.net`, which is the same socket floor
// the server stands on (D144).
//
// No TLS. `https` needs a TLS library, and this language has no business
// implementing one: a package binding OpenSSL or BoringSSL through
// `[link]` is where that belongs, and until there is one `Fetch` says so
// rather than pretending.

need std.net.{Connect, Socket}
need std.time.{ElapsedMillis, Now}
need tls.{Handshake, Stream}
need std.text.{Builder, Bytes, BuilderNew, IndexOf, Length, StartsWith, Substring, Trim}

// What went wrong with a call that never got an answer.
//
// `BadUrl` is a URL this does not understand, `NeedsTls` is `https`,
// `Unreachable` is a host that refused or is not there, `Truncated` is a
// connection that closed mid-answer, and `NotHttp` is an answer that is
// not one.
offer error BadUrl, NeedsTls, Unreachable, Truncated, NotHttp

/// A URL taken apart.
offer struct Url {
  var host: text = ""
  var port: int = 80
  /// The path and the query together, which is what a request line
  /// carries.
  var target: text = "/"
  var secure: bool = false
}

/// `http://host:port/path?query` taken apart.
offer fun ParseUrl(url: text) -> Url! uses unsafe {
  var rest = url
  var parsed = Url("", 80, "/", false)
  if StartsWith(rest, "http://") {
    rest = Substring(rest, 7, Length(rest))
  } else if StartsWith(rest, "https://") {
    parsed.secure = true
    parsed.port = 443
    rest = Substring(rest, 8, Length(rest))
  } else if IndexOf(rest, "://") >= 0 {
    return BadUrl
  }

  const slash = IndexOf(rest, "/")
  var authority = rest
  if slash >= 0 {
    authority = Substring(rest, 0, slash)
    parsed.target = Substring(rest, slash, Length(rest))
  }
  if Length(authority) == 0 {
    return BadUrl
  }

  const colon = IndexOf(authority, ":")
  if colon >= 0 {
    parsed.host = Substring(authority, 0, colon)
    const said = ParseSigned(
        Substring(authority, colon + 1, Length(authority)),
        -1)
    if said <= 0 || said > 65535 {
      return BadUrl
    }
    parsed.port = said
  } else {
    parsed.host = authority
  }
  if Length(parsed.host) == 0 {
    return BadUrl
  }
  return parsed
}

/// What came back. `Reply` rather than `Answer`, because a server's
/// answer is already called that (D144).
offer struct Reply {
  var status: int = 0
  var body: text = ""
  var headers: [24]Pair
  var header_count: int = 0
}

/// The header called `name`, or `fallback`. Case does not matter.
offer fun ReplyHeader(answer: &Reply, name: text, fallback: text) -> text uses unsafe {
  var i = 0
  while i < answer.header_count {
    if SameName(answer.headers[i].name, name) {
      return answer.headers[i].value
    }
    i = i + 1
  }
  return fallback
}

/// `GET url`.
offer fun Fetch(url: text) -> Reply! uses io, net, time, unsafe {
  return Perform(CallNew("GET", url))
}

/// `POST url` with a JSON body.
offer fun PostJson(url: text, body: text) -> Reply! uses io, net, time, unsafe {
  return Perform(WithBody(CallNew("POST", url), body, "application/json"))
}

/// `PUT`, `PATCH` and `DELETE`, for an API that uses them.
offer fun PutJson(url: text, body: text) -> Reply! uses io, net, time, unsafe {
  return Perform(WithBody(CallNew("PUT", url), body, "application/json"))
}

offer fun PatchJson(url: text, body: text) -> Reply! uses io, net, time, unsafe {
  return Perform(WithBody(CallNew("PATCH", url), body, "application/json"))
}

offer fun Delete(url: text) -> Reply! uses io, net, time, unsafe {
  return Perform(CallNew("DELETE", url))
}

/// A form submission: `a=1&b=two`, escaped, as a browser sends it.
offer fun PostForm(url: text, body: text) -> Reply! uses io, net, time, unsafe {
  return Perform(
      WithBody(CallNew("POST", url), body, "application/x-www-form-urlencoded"))
}

/// What a built call does. `Perform`, because `Request` is what a
/// server receives and `Run` is what a server does.
///
/// Redirects are followed up to the call's limit -- a `303` becomes a
/// `GET` with no body, which is what the status means and what every
/// other client does -- and `https` goes over the system's TLS (D151).
offer fun Perform(call: Call) -> Reply! uses io, net, time, unsafe {
  var held = call
  var left = call.redirects
  loop {
    const reply = Once(held)?
    const moved = reply.status == 301 || reply.status == 302 || reply.status == 303 || reply.status == 307 || reply.status == 308
    if !moved || left <= 0 {
      return reply
    }
    const next = ReplyHeader(&reply, "Location", "")
    if Length(next) == 0 {
      return reply
    }
    left = left - 1
    held.url = Absolute(held.url, next)
    if reply.status == 303 || reply.status == 302 || reply.status == 301 {
      // What the status means: come back with a `GET` and nothing in
      // hand. `307` and `308` keep the method and the body.
      held.method = "GET"
      held.body = ""
      held.kind = ""
    }
  }
}

/// A `Location` resolved against where the request went.
///
/// Absolute stays as it is; `/path` keeps the host; anything else is
/// relative to the directory the request was in.
offer fun Absolute(from: text, location: text) -> text uses unsafe {
  if StartsWith(location, "http://") || StartsWith(location, "https://") {
    return location
  }
  match ParseUrl(from) {
    Ok(target) => {
      var scheme = "http://"
      if target.secure {
        scheme = "https://"
      }
      var authority = target.host
      if target.secure && target.port != 443 || !target.secure && target.port != 80 {
        authority = "{target.host}:{target.port}"
      }
      if StartsWith(location, "/") {
        return scheme + authority + location
      }
      // Relative: everything up to the last `/` of the target.
      var directory = target.target
      var at = Length(directory)
      while at > 0 {
        if Substring(directory, at - 1, at) == "/" {
          break
        }
        at = at - 1
      }
      return scheme + authority + Substring(directory, 0, at) + location
    }
    _ => {
      return location
    }
  }
}

/// One request, one answer, no redirects.
///
/// `Connection: close` on the way out, because a client that holds a
/// connection has to decide when to let it go -- and a function that
/// answers once has nowhere to keep it. A client that wants keep-alive
/// uses `Open` and `Ask`.
offer fun Once(call: Call) -> Reply! uses io, net, time, unsafe {
  const target = ParseUrl(call.url)?
  const request = Written(call, target, false)
  if target.secure {
    // The system's TLS, verified against its own roots unless the call
    // said otherwise (D150).
    var stream = Handshake(target.host, target.port, call.verify)
    if !stream.IsOpen() {
      return Unreachable
    }
    if !stream.Send(request) {
      stream.Close()
      return Unreachable
    }
    const answer = Secure(&mut stream, call.timeout)
    stream.Close()
    return answer?
  }
  var connection = Connect(target.host, target.port)
  if !connection.IsOpen() {
    return Unreachable
  }
  if !connection.Send(request) {
    connection.Close()
    return Unreachable
  }
  const answer = Plain(&mut connection, call.timeout)
  connection.Close()
  return answer?
}

/// The bytes of a request.
offer fun Written(call: Call, target: Url, keep_alive: bool) -> text uses unsafe {
  var request = BuilderNew()
  request.Append("{call.method} {target.target} HTTP/1.1\r\n")
  request.Append("Host: {target.host}\r\n")
  if keep_alive {
    request.Append("Connection: keep-alive\r\n")
  } else {
    request.Append("Connection: close\r\n")
  }
  var said_type = false
  var said_accept = false
  var i = 0
  while i < call.header_count {
    const held = call.headers[i]
    said_type = said_type || SameName(held.name, "Content-Type")
    said_accept = said_accept || SameName(held.name, "Accept")
    request.Append("{held.name}: {held.value}\r\n")
    i = i + 1
  }
  if Length(call.kind) != 0 && !said_type {
    request.Append("Content-Type: {call.kind}\r\n")
  }
  if !said_accept {
    request.Append("Accept: */*\r\n")
  }
  if Length(call.body) != 0 {
    request.Append("Content-Length: {call.body.len}\r\n")
  }
  request.Append("\r\n")
  if Length(call.body) != 0 {
    request.Append(call.body)
  }
  return request.Release()
}

/// A connection held open, for a program making several calls.
///
/// Plain only: a kept TLS connection is `tls.Open` and `Ask` over it,
/// which a caller that wants one can write in three lines.
offer fun Open(url: text) -> Socket! uses io, net, unsafe {
  const target = ParseUrl(url)?
  if target.secure {
    return NeedsTls
  }
  var connection = Connect(target.host, target.port)
  if !connection.IsOpen() {
    return Unreachable
  }
  return connection
}

/// One request on a connection the caller owns.
/// One request on a connection the caller owns.
offer fun Ask(
    connection: &mut Socket,
    target: Url,
    method: text,
    body: text,
    kind: text,
    keep_alive: bool) -> Reply! uses io, time, unsafe {
  var call = CallNew(method, target.target)
  call = WithBody(call, body, kind)
  if !connection.Send(Written(call, target, keep_alive)) {
    return Unreachable
  }
  return Plain(connection, call.timeout)?
}

/// Reads an answer off a plain connection.
offer fun Plain(connection: &mut Socket, timeout: int) -> Reply! uses io, time, unsafe {
  var received = BuilderNew()
  const started = Now()
  var head = -1
  var length = -1
  var chunked = false
  loop {
    const piece = connection.Receive(8192)
    if piece.len == 0 {
      break
    }
    received.Append(piece)
    const state = Progress(&mut received, &mut head, &mut length, &mut chunked)
    if state {
      break
    }
    if timeout > 0 && ElapsedMillis(started, Now()) as int > timeout {
      return Truncated
    }
  }
  return Finish(received.Release(), head, length, chunked)?
}

/// The same, over TLS.
///
/// The same loop twice rather than one loop over an ability: a stream
/// and a socket are two types with the same three methods, and an
/// ability with a method per direction is more machinery than the
/// duplication costs (D151).
offer fun Secure(stream: &mut Stream, timeout: int) -> Reply! uses io, time, unsafe {
  var received = BuilderNew()
  const started = Now()
  var head = -1
  var length = -1
  var chunked = false
  loop {
    const piece = stream.Receive(8192)
    if piece.len == 0 {
      break
    }
    received.Append(piece)
    const state = Progress(&mut received, &mut head, &mut length, &mut chunked)
    if state {
      break
    }
    if timeout > 0 && ElapsedMillis(started, Now()) as int > timeout {
      return Truncated
    }
  }
  return Finish(received.Release(), head, length, chunked)?
}

/// Whether what has arrived is the whole answer.
///
/// The head first -- which says how the body is framed -- and then
/// either `Content-Length` bytes or chunks up to the empty one. A read
/// stops wherever it likes, which is why this is asked after every one.
offer fun Progress(
    received: &mut Builder,
    head: &mut int,
    length: &mut int,
    chunked: &mut bool) -> bool uses unsafe {
  const whole = received.Text()
  if *head < 0 {
    const blank = IndexOf(whole, "\r\n\r\n")
    if blank < 0 {
      return false
    }
    *head = blank + 4
    const top = Substring(whole, 0, *head)
    *length = ContentLength(top)
    *chunked = IsChunked(top)
  }
  if *chunked {
    return ChunkedEnd(whole, *head) >= 0
  }
  if *length < 0 {
    // Neither a length nor chunks: the body ends when the connection
    // does, which is what HTTP/1.0 did and what a `close` means.
    return false
  }
  return Length(whole) >= *head + *length
}

/// The answer, with a chunked body put back together.
offer fun Finish(whole: text, head: int, length: int, chunked: bool) -> Reply! uses unsafe {
  if head < 0 {
    return Truncated
  }
  if !chunked {
    return ParseReply(whole, head, length)?
  }
  // The chunks, joined: each is a hexadecimal size, a line break, that
  // many bytes, and a line break. The last one is zero.
  var body = BuilderNew()
  var at = head
  loop {
    const line = IndexOf(Substring(whole, at, Length(whole)), "\r\n")
    if line < 0 {
      break
    }
    const size = FromHexDigits(Substring(whole, at, at + line))
    at = at + line + 2
    if size < 0 {
      // Not a size, or one too big to be a chunk: stop rather than guess.
      return Truncated
    }
    if size == 0 {
      break
    }
    if at + size > Length(whole) {
      return Truncated
    }
    body.Append(Substring(whole, at, at + size))
    at = at + size + 2
  }
  var answer = ParseReply(whole, head, 0)?
  answer.body = body.Release()
  return answer
}

/// Where a chunked body ends, or -1 when it has not yet.
offer fun ChunkedEnd(whole: text, head: int) -> int uses unsafe {
  var at = head
  loop {
    const rest = Substring(whole, at, Length(whole))
    const line = IndexOf(rest, "\r\n")
    if line < 0 {
      return -1
    }
    const size = FromHexDigits(Substring(whole, at, at + line))
    at = at + line + 2
    if size <= 0 {
      // Zero ends the body; a malformed size ends the wait, and `Finish`
      // reports it.
      return at
    }
    at = at + size + 2
    if at > Length(whole) {
      return -1
    }
  }
}

/// The number a hexadecimal chunk header spells, or -1.
///
/// More than seven digits is -1: eight would overflow `int` and trap the
/// client on a hostile server's chunk header (D223).
///
/// A header may carry extensions after a `;`, which nothing uses and
/// everything has to skip.
offer fun FromHexDigits(line: text) -> int uses unsafe {
  const bytes = Bytes(Trim(line))
  var total = 0
  var seen = 0
  var i = 0
  while i < bytes.len {
    const byte = bytes[i]
    var digit = -1
    if byte >= 48 && byte <= 57 {
      digit = (byte - 48) as int
    } else if byte >= 97 && byte <= 102 {
      digit = (byte - 87) as int
    } else if byte >= 65 && byte <= 70 {
      digit = (byte - 55) as int
    } else if byte == 59 {
      break
    } else {
      return -1
    }
    if seen >= 7 {
      return -1
    }
    total = total * 16 + digit
    seen = seen + 1
    i = i + 1
  }
  if seen == 0 {
    return -1
  }
  return total
}

/// Whether the head says the body comes in chunks.
offer fun IsChunked(head: text) -> bool uses unsafe {
  var at = 0
  const bytes = Bytes(head)
  while at < bytes.len {
    var end = at
    while end < bytes.len && bytes[end] != 13 && bytes[end] != 10 {
      end = end + 1
    }
    const line = Substring(head, at, end)
    const colon = IndexOf(line, ":")
    if colon > 0 && SameName(Substring(line, 0, colon), "Transfer-Encoding") {
      const value = Trim(Substring(line, colon + 1, Length(line)))
      if IndexOf(Lowered(value), "chunked") >= 0 {
        return true
      }
    }
    at = end
    while at < bytes.len && (bytes[at] == 13 || bytes[at] == 10) {
      at = at + 1
    }
  }
  return false
}

fun Lowered(value: text) -> text uses unsafe {
  var builder = BuilderNew()
  const bytes = Bytes(value)
  var i = 0
  while i < bytes.len {
    var byte = bytes[i]
    if byte >= 65 && byte <= 90 {
      byte = byte + 32
    }
    builder.AppendByte(byte)
    i = i + 1
  }
  return builder.Release()
}

// What the head says the body's length is, or -1 when it says nothing.
fun ContentLength(head: text) -> int uses unsafe {
  var at = 0
  const bytes = Bytes(head)
  while at < bytes.len {
    var end = at
    while end < bytes.len && bytes[end] != 13 && bytes[end] != 10 {
      end = end + 1
    }
    const line = Substring(head, at, end)
    const colon = IndexOf(line, ":")
    if colon > 0 {
      const name = Substring(line, 0, colon)
      if SameName(name, "Content-Length") {
        return ParseSigned(Trim(Substring(line, colon + 1, Length(line))), -1)
      }
    }
    at = end
    while at < bytes.len && (bytes[at] == 13 || bytes[at] == 10) {
      at = at + 1
    }
  }
  return -1
}

/// What a response's bytes mean.
offer fun ParseReply(whole: text, head: int, length: int) -> Reply! uses unsafe {
  var answer = ReplyNew()
  const bytes = Bytes(whole)
  // `HTTP/1.1 200 OK`: the status is the second word.
  const first = IndexOf(whole, "\r\n")
  if first < 0 {
    return NotHttp
  }
  const status_line = Substring(whole, 0, first)
  const space = IndexOf(status_line, " ")
  if space < 0 {
    return NotHttp
  }
  const after = Substring(status_line, space + 1, Length(status_line))
  const second = IndexOf(after, " ")
  var number = after
  if second >= 0 {
    number = Substring(after, 0, second)
  }
  answer.status = ParseSigned(number, -1)
  if answer.status < 100 || answer.status > 599 {
    return NotHttp
  }

  // The headers, up to the blank line.
  var at = first + 2
  while at < head - 2 {
    var end = at
    while end < bytes.len && bytes[end] != 13 && bytes[end] != 10 {
      end = end + 1
    }
    const line = Substring(whole, at, end)
    const colon = IndexOf(line, ":")
    if colon > 0 && answer.header_count < kMostHeaders {
      answer.headers[answer.header_count] = Pair(
          Substring(line, 0, colon),
          Trim(Substring(line, colon + 1, Length(line))))
      answer.header_count = answer.header_count + 1
    }
    at = end
    while at < bytes.len && (bytes[at] == 13 || bytes[at] == 10) {
      at = at + 1
    }
  }

  var size = Length(whole) - head
  if length >= 0 && length < size {
    size = length
  }
  if size > 0 {
    answer.body = Substring(whole, head, head + size)
  }
  return answer
}

/// An empty answer, to fill in.
offer fun ReplyNew() -> Reply {
  var headers: [24]Pair
  return Reply(0, "", headers, 0)
}

// ------------------------------------------------------------- tests ---

@Test
fun TakesUrlsApart() -> bool uses unsafe {
  match ParseUrl("http://example.com/users?page=2") {
    Ok(target) => {
      if target.host != "example.com" || target.port != 80 || target.target != "/users?page=2" || target.secure {
        return false
      }
    }
    _ => {
      return false
    }
  }
  match ParseUrl("http://127.0.0.1:8080") {
    Ok(target) => {
      if target.host != "127.0.0.1" || target.port != 8080 || target.target != "/" {
        return false
      }
    }
    _ => {
      return false
    }
  }
  match ParseUrl("https://example.com") {
    Ok(target) => {
      if !target.secure || target.port != 443 {
        return false
      }
    }
    _ => {
      return false
    }
  }
  match ParseUrl("ftp://example.com") {
    BadUrl => {
      return true
    }
    _ => {
      return false
    }
  }
}

@Test
fun ReadsAResponse() -> bool uses unsafe {
  const whole = "HTTP/1.1 201 Created\r\nContent-Type: application/json\r\n" + "Content-Length: 13\r\nServer: wolang\r\n\r\n" + "\{\"ok\":true}\n"
  const head = IndexOf(whole, "\r\n\r\n") + 4
  match ParseReply(whole, head, 13) {
    Ok(answer) => {
      return answer.status == 201 && answer.header_count == 3 && ReplyHeader(
          &answer,
          "content-type",
          "") == "application/json" && ReplyHeader(&answer, "missing", "none") == "none" && answer.body.len == 12
    }
    _ => {
      return false
    }
  }
}

@Test
fun RefusesWhatIsNotHttp() -> bool uses unsafe {
  match ParseReply("not a response at all\r\n\r\n", 25, -1) {
    NotHttp => {
      return true
    }
    _ => {
      return false
    }
  }
}

@Test
fun ReadsAChunkSizeWithoutOverflowing() -> bool uses unsafe {
  // Eight hex digits would trap the multiplication; a hostile server must
  // not be able to choose that (D223).
  const head = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n"
  const hostile = head + "FFFFFFFFFF\r\nabc\r\n0\r\n\r\n"
  const fine = head + "3\r\nabc\r\n0\r\n\r\n"
  var broke = false
  match Finish(hostile, head.len, -1, true) {
    Truncated => {
      broke = true
    }
    _ => {}
  }
  var read = false
  match Finish(fine, head.len, -1, true) {
    Ok(answer) => {
      read = answer.body == "abc"
    }
    _ => {}
  }
  return FromHexDigits("ffffffff") == -1 && FromHexDigits("fffffff") == 268435455 && ChunkedEnd(
      hostile,
      head.len) >= 0 && broke && read
}
