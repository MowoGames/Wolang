// A window, what a person does to it, pixels, the GPU and sound.
//
// Over `libwolang_platform`, which is this project's own backend for
// each system -- Cocoa, Win32, X11 -- rather than a binding to someone
// else's windowing library (D155). What it offers is what a program
// actually needs: a window, events, a buffer of pixels to put on it, a
// GL context when the GPU is wanted, and a queue of sound.
//
// `Available()` first: a build for a machine with no display has every
// one of these and they all answer no, so a program can say something
// useful instead of failing to link.

need std.mem.{ArrayNew, Free}
need std.text.{Bytes, TextFromRaw}

// --------------------------------------------------------- the library ---

extern "C" fun wolang_platform_available() -> s32
extern "C" fun wolang_platform_backend() -> *u8
extern "C" fun wolang_platform_time() -> f64
extern "C" fun wolang_platform_sleep(seconds: f64)
extern "C" fun wolang_window_open(
    title: *u8,
    width: s32,
    height: s32,
    flags: u32) -> *mut u8
extern "C" fun wolang_window_close(window: *mut u8)
extern "C" fun wolang_window_poll(window: *mut u8, out: *mut Event) -> s32
extern "C" fun wolang_window_size(
    window: *mut u8,
    width: *mut s32,
    height: *mut s32)
extern "C" fun wolang_window_scale(window: *mut u8) -> f64
extern "C" fun wolang_window_set_title(window: *mut u8, title: *u8)
extern "C" fun wolang_window_present(
    window: *mut u8,
    pixels: *u32,
    width: s32,
    height: s32)
extern "C" fun wolang_window_gl_start(window: *mut u8) -> s32
extern "C" fun wolang_window_swap(window: *mut u8, interval: s32)
extern "C" fun wolang_gl_proc(name: *u8) -> *mut u8
extern "C" fun wolang_clipboard_text() -> *u8
extern "C" fun wolang_clipboard_set(text: *u8)
extern "C" fun wolang_audio_open(rate: s32, channels: s32) -> *mut u8
extern "C" fun wolang_audio_close(audio: *mut u8)
extern "C" fun wolang_audio_queue(audio: *mut u8, samples: *f32, frames: s32) -> s32
extern "C" fun wolang_audio_queued(audio: *mut u8) -> s32
extern "C" fun wolang_audio_room(audio: *mut u8) -> s32
extern "C" fun wolang_window_cursor_visible(window: *mut u8, visible: s32)
extern "C" fun wolang_window_cursor_shape(window: *mut u8, shape: s32)
extern "C" fun wolang_window_cursor_lock(window: *mut u8, locked: s32) -> s32
extern "C" fun wolang_window_set_fullscreen(window: *mut u8, fullscreen: s32)
extern "C" fun wolang_window_is_fullscreen(window: *mut u8) -> s32
extern "C" fun wolang_window_set_size(window: *mut u8, width: s32, height: s32)
extern "C" fun wolang_window_set_min_size(
    window: *mut u8,
    width: s32,
    height: s32)
extern "C" fun wolang_window_set_position(window: *mut u8, x: s32, y: s32)
extern "C" fun wolang_window_position(window: *mut u8, x: *mut s32, y: *mut s32)
extern "C" fun wolang_window_drop_path(window: *mut u8, index: s32) -> *u8
extern "C" fun wolang_gamepad_poll(out: *mut Event) -> s32
extern "C" fun wolang_gamepad_connected(index: s32) -> s32
extern "C" fun wolang_gamepad_name(index: s32) -> *u8
extern "C" fun wolang_gamepad_button(index: s32, button: s32) -> s32
extern "C" fun wolang_gamepad_axis(index: s32, axis: s32) -> f64
extern "C" fun wolang_dialog_available() -> s32
extern "C" fun wolang_dialog_message(
    title: *u8,
    text: *u8,
    level: s32,
    buttons: s32) -> s32
extern "C" fun wolang_dialog_open_file(title: *u8) -> *u8
extern "C" fun wolang_dialog_save_file(title: *u8, start_name: *u8) -> *u8

/// Whether this build can open a window at all.
offer fun Available() -> bool uses unsafe {
  return wolang_platform_available() != 0
}

/// Which backend it is: "cocoa", "win32", "x11" or "none".
offer fun Backend() -> text uses unsafe {
  return TextFromC(wolang_platform_backend())
}

/// Seconds from a clock that does not jump.
offer fun Time() -> f64 uses unsafe {
  return wolang_platform_time()
}

/// Waits, which is what a frame loop does with the time it has left.
offer fun Sleep(seconds: f64) uses unsafe {
  wolang_platform_sleep(seconds)
}

// ------------------------------------------------------------- events ---

/// What happened.
///
/// One struct for every kind, laid out exactly as the C one: a flat
/// shape costs a few unused fields and saves every program from taking
/// a tagged union apart.
offer struct Event {
  var kind: s32 = 0
  /// A key for a key event, a button for a mouse one.
  var key: s32 = 0
  var x: s32 = 0
  var y: s32 = 0
  var scroll_x: f64 = 0.0
  var scroll_y: f64 = 0.0
  var width: s32 = 0
  var height: s32 = 0
  var modifiers: u32 = 0
  /// What was typed, for a `kText` event.
  var code_point: u32 = 0
  var repeat: s32 = 0
}

offer const kNone: s32 = 0
offer const kClosed: s32 = 1
offer const kResized: s32 = 2
offer const kPressed: s32 = 3
offer const kReleased: s32 = 4
offer const kMouseDown: s32 = 5
offer const kMouseUp: s32 = 6
offer const kMouseMoved: s32 = 7
offer const kScrolled: s32 = 8
offer const kText: s32 = 9
offer const kFocus: s32 = 10
offer const kBlur: s32 = 11
/// Files were dropped on the window: `key` is how many, and
/// `Window.DropPath` answers each one.
offer const kDropped: s32 = 12
/// The pixel scale changed (another display, a new setting): `scroll_x`
/// is the new scale.
offer const kScaleChanged: s32 = 13
/// A pad appeared or went away: `key` is its slot, 0 to 3.
offer const kGamepadConnected: s32 = 14
offer const kGamepadDisconnected: s32 = 15

offer const kMouseLeft: s32 = 1
offer const kMouseRight: s32 = 2
offer const kMouseMiddle: s32 = 3

offer const kModShift: u32 = 1
offer const kModControl: u32 = 2
offer const kModAlt: u32 = 4
offer const kModSuper: u32 = 8

// Where a key is, not what it prints: what a person typed arrives as a
// `kText` event, because a layout is theirs and not the program's.
offer const kKeyA: s32 = 1
offer const kKeyB: s32 = 2
offer const kKeyC: s32 = 3
offer const kKeyD: s32 = 4
offer const kKeyE: s32 = 5
offer const kKeyF: s32 = 6
offer const kKeyG: s32 = 7
offer const kKeyH: s32 = 8
offer const kKeyI: s32 = 9
offer const kKeyJ: s32 = 10
offer const kKeyK: s32 = 11
offer const kKeyL: s32 = 12
offer const kKeyM: s32 = 13
offer const kKeyN: s32 = 14
offer const kKeyO: s32 = 15
offer const kKeyP: s32 = 16
offer const kKeyQ: s32 = 17
offer const kKeyR: s32 = 18
offer const kKeyS: s32 = 19
offer const kKeyT: s32 = 20
offer const kKeyU: s32 = 21
offer const kKeyV: s32 = 22
offer const kKeyW: s32 = 23
offer const kKeyX: s32 = 24
offer const kKeyY: s32 = 25
offer const kKeyZ: s32 = 26
offer const kKey0: s32 = 27
offer const kKey1: s32 = 28
offer const kKey2: s32 = 29
offer const kKey3: s32 = 30
offer const kKey4: s32 = 31
offer const kKey5: s32 = 32
offer const kKey6: s32 = 33
offer const kKey7: s32 = 34
offer const kKey8: s32 = 35
offer const kKey9: s32 = 36
offer const kKeySpace: s32 = 37
offer const kKeyEnter: s32 = 38
offer const kKeyEscape: s32 = 39
offer const kKeyTab: s32 = 40
offer const kKeyBackspace: s32 = 41
