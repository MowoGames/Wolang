// TLS, as the system implements it.
//
// This is a binding, not an implementation: Schannel on Windows and
// OpenSSL elsewhere, which the machine already has and already patches.
// A language that shipped its own cryptography would be shipping its own
// CVEs, and nobody wants that from a language (D150). Both are reached
// through the runtime, which loads OpenSSL only when a stream is opened,
// so a program that never speaks TLS links nothing for it (D211).
//
// What is here is the little that a client needs: a connection over a
// socket, read, write, close -- and the verification that makes TLS worth
// having. `Stream` is the shape `std.net.Socket` has, so code that speaks
// one can speak the other.

need std.net.{Connect, Socket}
need std.mem.{ArrayNew, Free}
need std.text.{BuilderNew, Bytes}

extern "C" fun wolang_tls_open(socket: s64, host: *u8, length: u64, verify: s32) -> s64
extern "C" fun wolang_tls_write(session: s64, bytes: *u8, count: s64) -> s64
extern "C" fun wolang_tls_read(session: s64, bytes: *mut u8, room: s64) -> s64
extern "C" fun wolang_tls_close(session: s64)

/// A TLS connection over a socket.
///
/// The socket is held so that closing the stream closes both: a TLS
/// connection whose socket outlives it is a descriptor nobody owns.
offer class Stream {
  var session: s64
  var socket: Socket
  var open: bool = false

  deinit  {
    Close()
  }

  fun IsOpen() -> bool {
    return open
  }

  /// Sends everything in `message`. False when the connection broke.
  fun Send(message: text) -> bool uses unsafe {
    if !open {
      return false
    }
    const bytes = Bytes(message)
    if bytes.len == 0 {
      return true
    }
    return wolang_tls_write(session, &bytes[0], bytes.len as s64) == bytes.len as s64
  }

  /// Reads up to `limit` bytes. "" when the other end closed.
  fun Receive(limit: int) -> text uses unsafe {
    if !open || limit <= 0 {
      return ""
    }
    var buffer = ArrayNew<u8>(limit)
    const received = wolang_tls_read(session, &mut buffer[0], limit as s64)
    if received <= 0 {
      Free(buffer)
      return ""
    }
    var builder = BuilderNew()
    var i = 0
    while i < received as int {
      builder.AppendByte(buffer[i])
      i = i + 1
    }
    Free(buffer)
    return builder.Release()
  }

  fun Close() uses unsafe {
    if !open {
      return
    }
    open = false
    wolang_tls_close(session)
    socket.Close()
  }
}

/// A closed stream, which is what a failure answers with.
offer fun StreamNone() -> Stream {
  return Stream(0, Socket(-1), false)
}

/// Connects to `host` on `port` and shakes hands.
///
/// `Handshake` rather than `Open`, because a program that speaks both
/// HTTP and TLS imports both and this language has no import aliases
/// (D150).
///
/// The certificate is verified against the system's own roots, and the
/// name is checked against it: TLS that does not check the name is TLS
/// that any server can answer (D150). `verify = false` is for a
/// development server with a certificate it signed itself, and says so
/// at the call.
offer fun Handshake(host: text, port: int, verify: bool) -> Stream uses unsafe {
  var socket = Connect(host, port)
  if !socket.IsOpen() {
    return StreamNone()
  }
  const name = Bytes(host)
  if name.len == 0 {
    socket.Close()
    return StreamNone()
  }
  const session = wolang_tls_open(
      socket.fd as s64,
      &name[0],
      name.len as u64,
      if verify {
        1
      } else {
        0
      })
  if session == 0 {
    socket.Close()
    return StreamNone()
  }
  return Stream(session, socket, true)
}

// ------------------------------------------------------------- tests ---

@Test
fun RefusesAHostThatIsNotThere() -> bool uses unsafe {
  // No network needed: a name nothing resolves cannot be connected to,
  // and what comes back is a closed stream rather than a trap.
  var stream = Handshake("this.name.does.not.exist.invalid", 443, true)
  const closed = !stream.IsOpen()
  stream.Close()
  return closed
}
