need std.list.{List, ListNew}
need std.utf8.{Walk}
need image.{Image}

offer struct Placement {
  var glyph: int
  var code: int
  var x: float
  var y: float
  var line: int
}

offer class Layout {
  var items: List<Placement>
  var width: float
  var height: float
  var lines: int
  var line_height: float

  fun Count() -> int {
    return items.Len()
  }

  fun At(index: int) -> Placement {
    return items.At(index)
  }
}

offer fun LineHeight(font: Font, size: float) -> float {
  const scale = font.Scale(size)
  return (font.Ascent() - font.Descent() + font.LineGap()) as float * scale
}

fun EmitLine(items: List<Placement>, glyphs: List<int>, codes: List<int>, kerns: List<float>, advances: List<float>, from: int, to: int, line: int, baseline: float) -> float uses unsafe {
  var x = 0.0
  var j = from
  var reach = 0.0
  while j < to {
    if j > from {
      x = x + kerns.At(j)
    }
    items.Push(Placement(glyphs.At(j), codes.At(j), x, baseline, line))
    x = x + advances.At(j)
    if codes.At(j) != 32 {
      reach = x
    }
    j = j + 1
  }
  return reach
}

offer fun LayoutText(font: Font, value: text, size: float, wrap: float) -> Layout uses unsafe {
  const scale = font.Scale(size)
  var glyphs = ListNew<int>()
  var codes = ListNew<int>()
  var kerns = ListNew<float>()
  var advances = ListNew<float>()
  var previous = -1
  for code in Walk(value) {
    const glyph = font.GlyphIndex(code)
    glyphs.Push(glyph)
    codes.Push(code)
    var kern = 0.0
    if previous >= 0 {
      kern = font.Kerning(previous, glyph) as float * scale
    }
    kerns.Push(kern)
    advances.Push(font.Advance(glyph) as float * scale)
    previous = glyph
  }
  const height = LineHeight(font, size)
  const ascent = font.Ascent() as float * scale
  var items = ListNew<Placement>()
  var widest = 0.0
  var line = 0
  var start = 0
  var i = 0
  var x = 0.0
  var last_break = -1
  const n = codes.Len()
  while i < n {
    const code = codes.At(i)
    if code == 10 {
      const reach = EmitLine(items, glyphs, codes, kerns, advances, start, i, line, ascent + line as float * height)
      widest = MaxOf(widest, reach)
      line = line + 1
      start = i + 1
      i = start
      x = 0.0
      last_break = -1
    } else {
      var step = advances.At(i)
      if i > start {
        step = step + kerns.At(i)
      }
      if wrap > 0.0 && i > start && x + step > wrap {
        var cut = i
        if last_break > start {
          cut = last_break
        }
        const reach = EmitLine(items, glyphs, codes, kerns, advances, start, cut, line, ascent + line as float * height)
        widest = MaxOf(widest, reach)
        line = line + 1
        start = cut
        while start < n && codes.At(start) == 32 {
          start = start + 1
        }
        i = start
        x = 0.0
        last_break = -1
      } else {
        if code == 32 {
          last_break = i + 1
        }
        x = x + step
        i = i + 1
      }
    }
  }
  if start < n || n == 0 || line == 0 {
    const reach = EmitLine(items, glyphs, codes, kerns, advances, start, n, line, ascent + line as float * height)
    widest = MaxOf(widest, reach)
    line = line + 1
  }
  return Layout(items, widest, line as float * height, line, height)
}

fun MaxOf(a: float, b: float) -> float {
  if a > b {
    return a
  }
  return b
}

offer fun Measure(font: Font, value: text, size: float) -> float uses unsafe {
  return LayoutText(font, value, size, 0.0).width
}

offer fun DrawText(target: Image, font: Font, value: text, size: float, x: int, y: int, colour: u32) uses unsafe {
  const layout = LayoutText(font, value, size, 0.0)
  var i = 0
  while i < layout.Count() {
    const place = layout.At(i)
    match Rasterize(font, place.glyph, size) {
      Ok(glyph) => DrawGlyph(target, glyph, x + (place.x + 0.5) as int, y + place.y as int, colour),
      _ => {},
    }
    i = i + 1
  }
}

fun LayoutOf(which: int, value: text, size: float, wrap: float) -> Layout? uses unsafe {
  if const font = Fixture(which) {
    return LayoutText(font, value, size, wrap)
  }
  return null
}

@Test
fun MeasuresAdvancesAndKerning() -> bool uses unsafe {
  if const font = Fixture(0) {
    return Near(Measure(font, "A", 1000.0), 600.0, 0.01) && Near(Measure(font, "AB", 1000.0), 1350.0, 0.01) && Near(Measure(font, "BA", 1000.0), 1400.0, 0.01) && Near(Measure(font, "AB", 100.0), 135.0, 0.01) && Measure(font, "", 100.0) == 0.0
  }
  return false
}

@Test
fun ComputesTheLineHeightFromTheMetrics() -> bool uses unsafe {
  if const font = Fixture(0) {
    return Near(LineHeight(font, 1000.0), 1100.0, 0.01) && Near(LineHeight(font, 100.0), 110.0, 0.01)
  }
  return false
}

@Test
fun PlacesEachGlyphAfterTheOneBefore() -> bool uses unsafe {
  if const layout = LayoutOf(0, "AB", 1000.0, 0.0) {
    const first = layout.At(0)
    const second = layout.At(1)
    return layout.Count() == 2 && layout.lines == 1 && first.glyph == 2 && first.code == 65 && first.x == 0.0 && Near(second.x, 550.0, 0.01) && second.glyph == 3 && Near(first.y, 800.0, 0.01) && Near(layout.height, 1100.0, 0.01)
  }
  return false
}

@Test
fun StartsANewLineAtANewlineCharacter() -> bool uses unsafe {
  if const layout = LayoutOf(0, "A\nA", 1000.0, 0.0) {
    return layout.lines == 2 && layout.Count() == 2 && layout.At(1).line == 1 && Near(layout.At(1).y, 1900.0, 0.01) && Near(layout.height, 2200.0, 0.01) && Near(layout.width, 600.0, 0.01)
  }
  return false
}

@Test
fun WrapsAtSpacesWhenALineIsTooLong() -> bool uses unsafe {
  if const wrapped = LayoutOf(0, "A A A", 1000.0, 1400.0) {
    if const loose = LayoutOf(0, "A A A", 1000.0, 0.0) {
      return wrapped.lines == 3 && Near(wrapped.width, 600.0, 0.01) && wrapped.At(wrapped.Count() - 1).line == 2 && loose.lines == 1 && Near(loose.width, 2400.0, 0.01)
    }
  }
  return false
}

@Test
fun BreaksAWordThatIsLongerThanTheLine() -> bool uses unsafe {
  if const layout = LayoutOf(0, "AAAA", 1000.0, 1000.0) {
    return layout.lines == 4 && layout.Count() == 4
  }
  return false
}

@Test
fun AnEmptyTextIsOneEmptyLine() -> bool uses unsafe {
  if const layout = LayoutOf(0, "", 1000.0, 500.0) {
    return layout.lines == 1 && layout.Count() == 0 && layout.width == 0.0
  }
  return false
}

@Test
fun LaysOutACodePointOutsideTheBasicPlane() -> bool uses unsafe {
  if const font = Fixture(1) {
    return Near(Measure(font, "😀", 2048.0), 500.0, 0.01) && LayoutText(font, "😀.", 2048.0, 0.0).Count() == 2
  }
  return false
}

@Test
fun DrawsTextIntoAnImage() -> bool uses unsafe {
  if const font = Fixture(0) {
    if const image = Blank(200, 100) {
      DrawText(image, font, "A", 80.0, 10, 5, 4294967295)
      var lit = 0
      var y = 0
      while y < 100 {
        var x = 0
        while x < 200 {
          if image.Get(x, y) != 0 {
            lit = lit + 1
          }
          x = x + 1
        }
        y = y + 1
      }
      return lit > 500 && image.Get(190, 90) == 0 && image.Get(0, 0) == 0
    }
  }
  return false
}
