need std.list.{List, ListNew}
need std.math.{AbsFloat, Ceil, Floor, MaxFloat, MinFloat, Sqrt}
need std.mem.{ArrayNew, Free}
need image.{Image, ImageNew}

offer error BadSize

offer const kMaxBitmapSide: int = 4096

offer class Glyph {
  var coverage: []mut u8
  var width: int
  var height: int
  var left: int
  var top: int
  var advance: float

  deinit  {
    Free(coverage)
  }

  fun At(x: int, y: int) -> int {
    if x < 0 || y < 0 || x >= width || y >= height {
      return 0
    }
    return coverage[y * width + x] as int
  }

  fun Total() -> int {
    var sum = 0
    var i = 0
    while i < width * height {
      sum = sum + coverage[i] as int
      i = i + 1
    }
    return sum
  }

  fun ToImage(red: int, green: int, blue: int) -> Image? uses unsafe {
    if width < 1 || height < 1 {
      return null
    }
    match ImageNew(width, height) {
      Ok(image) => {
        var y = 0
        while y < height {
          var x = 0
          while x < width {
            image.Set(
                x,
                y,
                Pack(red, green, blue, coverage[y * width + x] as int))
            x = x + 1
          }
          y = y + 1
        }
        return image
      }
      _ => {
        return null
      }
    }
  }
}

fun Pack(red: int, green: int, blue: int, alpha: int) -> u32 {
  return alpha as u32 << 24 | red as u32 << 16 | green as u32 << 8 | blue as u32
}

fun Add(acc: []mut float, index: int, value: float) {
  if index >= 0 && index < acc.len {
    acc[index] = acc[index] + value
  }
}

fun Segment(edges: List<float>, x0: float, y0: float, x1: float, y1: float) uses unsafe {
  if y0 == y1 {
    return
  }
  edges.Push(x0)
  edges.Push(y0)
  edges.Push(x1)
  edges.Push(y1)
}

fun Quad(
    edges: List<float>,
    x0: float,
    y0: float,
    cx: float,
    cy: float,
    x1: float,
    y1: float) uses unsafe {
  const dx = x0 - 2.0 * cx + x1
  const dy = y0 - 2.0 * cy + y1
  var n = Ceil(Sqrt(Sqrt(dx * dx + dy * dy) * 2.5)) as int
  if n < 1 {
    n = 1
  }
  if n > 64 {
    n = 64
  }
  var px = x0
  var py = y0
  var i = 1
  while i <= n {
    const t = i as float / n as float
    const u = 1.0 - t
    const qx = u * u * x0 + 2.0 * u * t * cx + t * t * x1
    const qy = u * u * y0 + 2.0 * u * t * cy + t * t * y1
    Segment(edges, px, py, qx, qy)
    px = qx
    py = qy
    i = i + 1
  }
}

offer fun Flatten(outline: Outline, scale: float, edges: List<float>) uses unsafe {
  var first = 0
  var contour = 0
  while contour < outline.ends.Len() {
    const last = outline.ends.At(contour)
    const count = last - first + 1
    var sx = 0.0
    var sy = 0.0
    var from = first
    var to = last
    if outline.on.At(first) {
      sx = outline.xs.At(first) * scale
      sy = outline.ys.At(first) * scale
      from = first + 1
    } else if outline.on.At(last) {
      sx = outline.xs.At(last) * scale
      sy = outline.ys.At(last) * scale
      to = last - 1
    } else {
      sx = (outline.xs.At(first) + outline.xs.At(last)) * 0.5 * scale
      sy = (outline.ys.At(first) + outline.ys.At(last)) * 0.5 * scale
    }
    var cx = sx
    var cy = sy
    var qx = 0.0
    var qy = 0.0
    var pending = false
    var i = from
    while i <= to && count > 1 {
      const px = outline.xs.At(i) * scale
      const py = outline.ys.At(i) * scale
      if outline.on.At(i) {
        if pending {
          Quad(edges, cx, cy, qx, qy, px, py)
          pending = false
        } else {
          Segment(edges, cx, cy, px, py)
        }
        cx = px
        cy = py
      } else {
        if pending {
          const mx = (qx + px) * 0.5
          const my = (qy + py) * 0.5
          Quad(edges, cx, cy, qx, qy, mx, my)
          cx = mx
          cy = my
        }
        qx = px
        qy = py
        pending = true
      }
      i = i + 1
    }
    if pending {
      Quad(edges, cx, cy, qx, qy, sx, sy)
    } else {
      Segment(edges, cx, cy, sx, sy)
    }
    first = last + 1
    contour = contour + 1
  }
}

offer fun AccumulateLine(
    acc: []mut float,
    w: int,
    h: int,
    ax: float,
    ay: float,
    bx: float,
    by: float) {
  if ay == by {
    return
  }
  var dir = 1.0
  var x0 = ax
  var y0 = ay
  var x1 = bx
  var y1 = by
  if ay > by {
    dir = -1.0
    x0 = bx
    y0 = by
    x1 = ax
    y1 = ay
  }
  const dxdy = (x1 - x0) / (y1 - y0)
  var x = x0
  if y0 < 0.0 {
    x = x - y0 * dxdy
  }
  var row = 0
  if y0 > 0.0 {
    row = y0 as int
  }
  var stop = y1 as int
  if (stop as float) < y1 {
    stop = stop + 1
  }
  if stop > h {
    stop = h
  }
  const limit = (w - 1) as float
  while row < stop {
    const line = row * w
    const top = MaxFloat(row as float, y0)
    const bottom = MinFloat((row + 1) as float, y1)
    const dy = bottom - top
    const xnext = x + dxdy * dy
    const d = dy * dir
    var left = x
    var right = xnext
    if xnext < x {
      left = xnext
      right = x
    }
    left = MinFloat(MaxFloat(left, 0.0), limit)
    right = MinFloat(MaxFloat(right, 0.0), limit)
    const left_i = left as int
    const left_floor = left_i as float
    var right_i = right as int
    if (right_i as float) < right {
      right_i = right_i + 1
    }
    if right_i <= left_i + 1 {
      const mid = 0.5 * (left + right) - left_floor
      Add(acc, line + left_i, d - d * mid)
      Add(acc, line + left_i + 1, d * mid)
    } else {
      const s = 1.0 / (right - left)
      const lf = left - left_floor
      const a0 = 0.5 * s * (1.0 - lf) * (1.0 - lf)
      const rf = right - right_i as float + 1.0
      const am = 0.5 * s * rf * rf
      Add(acc, line + left_i, d * a0)
      if right_i == left_i + 2 {
        Add(acc, line + left_i + 1, d * (1.0 - a0 - am))
      } else {
        const a1 = s * (1.5 - lf)
        Add(acc, line + left_i + 1, d * (a1 - a0))
        var xi = left_i + 2
        while xi < right_i - 1 {
          Add(acc, line + xi, d * s)
          xi = xi + 1
        }
        const a2 = a1 + (right_i - left_i - 3) as float * s
        Add(acc, line + right_i - 1, d * (1.0 - a2 - am))
      }
      Add(acc, line + right_i, d * am)
    }
    x = xnext
    row = row + 1
  }
}

offer fun Rasterize(font: Font, glyph: int, size: float) -> Glyph!(Malformed, TooLarge, BadSize) uses unsafe {
  if size <= 0.0 || size > 100000.0 {
    return BadSize
  }
  const outline = font.GlyphOutline(glyph)?
  const scale = font.Scale(size)
  const advance = font.Advance(glyph) as float * scale
  var edges = ListNew<float>()
  Flatten(outline, scale, edges)
  if edges.Len() == 0 {
    return Glyph(ArrayNew<u8>(0), 0, 0, 0, 0, advance)
  }
  var min_x = edges.At(0)
  var max_x = min_x
  var min_y = edges.At(1)
  var max_y = min_y
  var i = 0
  while i < edges.Len() {
    const x = edges.At(i)
    const y = edges.At(i + 1)
    min_x = MinFloat(min_x, x)
    max_x = MaxFloat(max_x, x)
    min_y = MinFloat(min_y, y)
    max_y = MaxFloat(max_y, y)
    i = i + 2
  }
  if max_x - min_x > 8192.0 || max_y - min_y > 8192.0 {
    return TooLarge
  }
  const origin_x = Floor(min_x) as int - 1
  const origin_y = Ceil(max_y) as int + 1
  const width = Ceil(max_x) as int + 1 - origin_x
  const height = origin_y - (Floor(min_y) as int - 1)
  if width > kMaxBitmapSide || height > kMaxBitmapSide {
    return TooLarge
  }
  var acc = ArrayNew<float>(width * height + 4)
  i = 0
  while i < acc.len {
    acc[i] = 0.0
    i = i + 1
  }
  i = 0
  while i < edges.Len() {
    AccumulateLine(
        acc,
        width,
        height,
        edges.At(i) - origin_x as float,
        origin_y as float - edges.At(i + 1),
        edges.At(i + 2) - origin_x as float,
        origin_y as float - edges.At(i + 3))
    i = i + 4
  }
  var coverage = ArrayNew<u8>(width * height)
  var sum = 0.0
  i = 0
  while i < width * height {
    sum = sum + acc[i]
    var level = AbsFloat(sum)
    if level > 1.0 {
      level = 1.0
    }
    coverage[i] = (level * 255.0 + 0.5) as int as u8
    i = i + 1
  }
  Free(acc)
  return Glyph(coverage, width, height, origin_x, origin_y, advance)
}

offer fun DrawGlyph(target: Image, glyph: Glyph, x: int, y: int, colour: u32) {
  const base_alpha = (colour >> 24) as int
  const red = ((colour >> 16) % 256) as int
  const green = ((colour >> 8) % 256) as int
  const blue = (colour % 256) as int
  var row = 0
  while row < glyph.height {
    var column = 0
    while column < glyph.width {
      const level = glyph.coverage[row * glyph.width + column] as int
      if level > 0 {
        BlendPixel(
            target,
            x + glyph.left + column,
            y - glyph.top + row,
            red,
            green,
            blue,
            level * base_alpha / 255)
      }
      column = column + 1
    }
    row = row + 1
  }
}

offer fun BlendPixel(
    target: Image,
    x: int,
    y: int,
    red: int,
    green: int,
    blue: int,
    alpha: int) {
  if !target.Contains(x, y) || alpha <= 0 {
    return
  }
  const below = target.Get(x, y)
  const below_alpha = (below >> 24) as int
  const below_red = ((below >> 16) % 256) as int
  const below_green = ((below >> 8) % 256) as int
  const below_blue = (below % 256) as int
  const keep = (255 - alpha) * below_alpha / 255
  const total = alpha + keep
  if total <= 0 {
    return
  }
  const out_red = (red * alpha + below_red * keep) / total
  const out_green = (green * alpha + below_green * keep) / total
  const out_blue = (blue * alpha + below_blue * keep) / total
  target.Set(x, y, Pack(out_red, out_green, out_blue, total))
}

fun RasterOf(which: int, glyph: int, size: float) -> Glyph? uses unsafe {
  if const font = Fixture(which) {
    match Rasterize(font, glyph, size) {
      Ok(bitmap) => {
        return bitmap
      }
      _ => {
        return null
      }
    }
  }
  return null
}

fun RasterCode(glyph: int, size: float) -> int uses unsafe {
  if const font = Fixture(0) {
    match Rasterize(font, glyph, size) {
      Ok(_bitmap) => {
        return 0
      }
      Malformed => {
        return 1
      }
      TooLarge => {
        return 2
      }
      BadSize => {
        return 3
      }
    }
  }
  return -1
}

fun Blank(width: int, height: int) -> Image? uses unsafe {
  match ImageNew(width, height) {
    Ok(image) => {
      return image
    }
    _ => {
      return null
    }
  }
}

fun Near(a: float, b: float, tolerance: float) -> bool {
  return AbsFloat(a - b) <= tolerance
}

@Test
fun FillsAPixelAlignedBoxExactly() -> bool uses unsafe {
  if const bitmap = RasterOf(0, 0, 100.0) {
    const total = bitmap.Total()
    return bitmap.left == 9 && bitmap.top == 71 && bitmap.width == 42 && bitmap.height == 72 && total >= 2800 * 255 - 28 && total <= 2800 * 255 + 28 && bitmap.At(
        1,
        1) == 255 && bitmap.At(40, 70) == 255 && bitmap.At(41, 70) == 0 && bitmap.At(
        0,
        0) == 0 && bitmap.At(-1, 5) == 0 && bitmap.At(5, 500) == 0
  }
  return false
}

@Test
fun CoversTheAreaUnderACurve() -> bool uses unsafe {
  if const bitmap = RasterOf(0, 2, 100.0) {
    const total = bitmap.Total()
    return total > 1300 * 255 && total < 1370 * 255 && bitmap.At(26, 40) == 255 && bitmap.At(
        26,
        0) == 0
  }
  return false
}

@Test
fun LeavesAHoleEmpty() -> bool uses unsafe {
  if const bitmap = RasterOf(1, 1, 20.48) {
    const total = bitmap.Total()
    return total > 12 * 252 && total < 12 * 258 && bitmap.At(3, 3) <= 5 && bitmap.At(
        1,
        4) >= 250
  }
  return false
}

@Test
fun AnEmptyGlyphHasNoBitmapButAnAdvance() -> bool uses unsafe {
  if const bitmap = RasterOf(0, 1, 100.0) {
    return bitmap.width == 0 && bitmap.height == 0 && bitmap.Total() == 0 && Near(
        bitmap.advance,
        30.0,
        0.01)
  }
  return false
}

@Test
fun RefusesASizeThatIsNotPositiveOrTooBig() -> bool uses unsafe {
  return RasterCode(0, 100.0) == 0 && RasterCode(0, 0.0) == 3 && RasterCode(
      0,
      -5.0) == 3 && RasterCode(0, 500000.0) == 3 && RasterCode(0, 50000.0) == 2 && RasterCode(
      99,
      10.0) == 1
}

@Test
fun SpreadsACrossingBetweenTwoCells() -> bool uses unsafe {
  var acc = ArrayNew<float>(10)
  var i = 0
  while i < 10 {
    acc[i] = 0.0
    i = i + 1
  }
  AccumulateLine(acc, 4, 2, 1.5, 0.0, 1.5, 2.0)
  const crossed = Near(acc[1], 0.5, 0.001) && Near(acc[2], 0.5, 0.001) && Near(
      acc[5],
      0.5,
      0.001) && Near(acc[6], 0.5, 0.001) && Near(acc[0], 0.0, 0.001)
  AccumulateLine(acc, 4, 2, 0.0, 1.0, 3.0, 1.0)
  const flat = Near(acc[3], 0.0, 0.001) && Near(acc[7], 0.0, 0.001)
  Free(acc)
  return crossed && flat
}

@Test
fun FlattensACurveIntoLines() -> bool uses unsafe {
  if const font = Fixture(0) {
    match font.GlyphOutline(2) {
      Ok(outline) => {
        var edges = ListNew<float>()
        Flatten(outline, 0.1, edges)
        const last = edges.Len()
        return last >= 16 && last % 4 == 0 && edges.At(0) == 0.0 && edges.At(1) == 0.0 && Near(
            edges.At(last - 2),
            50.0,
            0.001) && Near(edges.At(last - 1), 0.0, 0.001)
      }
      Malformed => {
        return false
      }
    }
  }
  return false
}

@Test
fun DrawsACoverageBitmapInAColour() -> bool uses unsafe {
  if const image = Blank(100, 100) {
    if const bitmap = RasterOf(0, 0, 100.0) {
      DrawGlyph(image, bitmap, 0, 80, 4294901760)
      return image.Get(10, 10) == 4294901760 && image.Get(0, 0) == 0 && image.Get(
          60,
          10) == 0
    }
  }
  return false
}

@Test
fun BlendsAHalfOpaquePixelOverWhite() -> bool uses unsafe {
  if const image = Blank(2, 2) {
    image.Set(0, 0, 4294967295)
    BlendPixel(image, 0, 0, 0, 0, 0, 128)
    const blended = image.Get(0, 0) == Pack(127, 127, 127, 255)
    BlendPixel(image, 0, 0, 0, 0, 0, 0)
    BlendPixel(image, 9, 9, 255, 0, 0, 255)
    return blended && image.Get(0, 0) == Pack(127, 127, 127, 255) && image.Get(
        1,
        1) == 0
  }
  return false
}

@Test
fun ConvertsACoverageBitmapToAnImage() -> bool uses unsafe {
  if const bitmap = RasterOf(0, 0, 100.0) {
    if const empty = RasterOf(0, 1, 100.0) {
      if const image = bitmap.ToImage(255, 0, 0) {
        return image.width == 42 && image.height == 72 && image.Get(1, 1) == 4294901760 && image.Get(
            0,
            0) == 16711680 && empty.ToImage(0, 0, 0) == null
      }
    }
  }
  return false
}
