// A growable sequence.
//
// The first collection, and the one everything else is written against:
// `[]T` is a view with no allocation and `[N]T` is a fixed array, so a
// list is what a program reaches for when it does not know how many
// (D91). Written in Wolang over `ArrayNew` and `Free`, which is what the
// generics and destructors were for.

need std.mem.{ArrayNew, Free, Prefix}
need std.iter.{Iterable, Iterator}

/// A sequence that grows.
///
/// Doubling, and never shrinking: an append is amortised constant and a
/// list that was big once stays ready to be big again, which is what a
/// frame loop wants. `deinit` gives the storage back, so a list that goes
/// out of scope leaves nothing behind.
offer class List<T> {
  var items: []T
  var count: int = 0

  deinit  {
    Free(items)
  }

  fun Len() -> int {
    return count
  }

  /// What `for value in list` walks with.
  fun Iterate() -> ListWalk<T> {
    return ListWalk<T>(self, -1)
  }

  /// The elements, as a slice of exactly what is in the list.
  ///
  /// A view, not a copy: writing through it writes the list. What every
  /// function taking `[]T` wants, which is most of them. The language
  /// has no slicing syntax yet, so this is a view built from where the
  /// storage is and how much of it is in use.
  ///
  /// The view is valid only until the list next grows: `Push` or `Reserve`
  /// past the capacity moves the storage and leaves the view pointing at
  /// freed memory, and so does the list dying. Take it after the last
  /// mutation and use it before the next (D227).
  fun Items() -> []T uses unsafe {
    if count == 0 {
      return ArrayNew<T>(0)
    }
    return Prefix<T>(items, count)
  }

  fun Capacity() -> int {
    return items.len
  }

  /// The element at `index`, or the first one when the index is outside
  /// the list. Reading past the end is a mistake the bounds check would
  /// catch; this is the total function the library offers instead.
  fun At(index: int) -> T {
    if index < 0 || index >= count {
      return items[0]
    }
    return items[index]
  }

  fun Set(index: int, value: T) {
    if index < 0 || index >= count {
      return
    }
    items[index] = value
  }

  /// Adds `value` to the end, growing the storage when it is full.
  fun Push(value: T) uses unsafe {
    Reserve(count + 1)
    items[count] = value
    count = count + 1
  }

  /// Drops the last element and gives it back, or the first one when the
  /// list is empty.
  fun Pop() -> T {
    if count == 0 {
      return items[0]
    }
    count = count - 1
    return items[count]
  }

  fun Clear() {
    count = 0
  }

  /// Makes room for at least `wanted` elements.
  ///
  /// Doubling rather than growing by one: a push that copies every time
  /// turns a loop into quadratic work, and the whole reason to have a list
  /// is that it does not.
  fun Reserve(wanted: int) uses unsafe {
    if wanted <= items.len {
      return
    }
    var capacity = items.len * 2
    if capacity < wanted {
      capacity = wanted
    }
    if capacity < 4 {
      capacity = 4
    }
    const grown = ArrayNew<T>(capacity)
    var i = 0
    while i < count {
      grown[i] = items[i]
      i = i + 1
    }
    Free(items)
    items = grown
  }
}

/// Walks a list from front to back.
///
/// `Next` moves and says whether there is anything there; `Value` is what
/// it is standing on. Three names and no ability, because an ability that
/// said "what I walk over" needs an associated type the language does not
/// have yet (D96).
offer class ListWalk<T> {
  var over: List<T>
  var at: int = -1

  fun Next() -> bool {
    at = at + 1
    return at < over.Len()
  }

  fun Value() -> T {
    return over.At(at)
  }
}

/// An empty list, with no storage until something is pushed.
offer fun ListNew<T>() -> List<T> uses unsafe {
  return List<T>(ArrayNew<T>(0), 0)
}

extend<T> ListWalk<T> as Iterator {
  type Item = T
}

extend<T> List<T> as Iterable {
  type Walker = ListWalk<T>
}

// ------------------------------------------------------------- tests ---

@Test
fun PushesAndReads() -> bool uses unsafe {
  var list = ListNew<int>()
  var i = 0
  while i < 10 {
    list.Push(i * i)
    i = i + 1
  }
  if list.Len() != 10 {
    return false
  }
  if list.At(0) != 0 || list.At(3) != 9 || list.At(9) != 81 {
    return false
  }
  // The storage grew by doubling, so it holds at least what was pushed.
  return list.Capacity() >= 10
}

@Test
fun PopsInReverse() -> bool uses unsafe {
  var list = ListNew<int>()
  list.Push(1)
  list.Push(2)
  list.Push(3)
  if list.Pop() != 3 || list.Pop() != 2 {
    return false
  }
  if list.Len() != 1 {
    return false
  }
  list.Clear()
  return list.Len() == 0
}

@Test
fun SetsInPlace() -> bool uses unsafe {
  var list = ListNew<float>()
  list.Push(1.5)
  list.Push(2.5)
  list.Set(1, 9.5)
  return list.At(0) == 1.5 && list.At(1) == 9.5
}

@Test
fun WalksEveryElement() -> bool uses unsafe {
  var list = ListNew<int>()
  list.Push(2)
  list.Push(3)
  list.Push(4)
  var total = 0
  var seen = 0
  for value in list {
    total = total + value
    seen = seen + 1
  }
  return total == 9 && seen == 3
}

// ------------------------------------------------------- walks and tests ---
//
// What a closure is for: `Count(xs, |x| x > limit)` reads as what it
// does, and the closure takes `limit` with it (D138). Each of these is a
// loop someone would otherwise write by hand, which is the whole
// argument for having them.

/// Whether anything in `items` satisfies `holds`.
offer fun Any<T>(items: []T, holds: fun(T) -> bool) -> bool {
  var i = 0
  while i < items.len {
    if holds(items[i]) {
      return true
    }
    i = i + 1
  }
  return false
}

/// Whether everything in `items` does.
offer fun All<T>(items: []T, holds: fun(T) -> bool) -> bool {
  var i = 0
  while i < items.len {
    if !holds(items[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

/// How many satisfy `holds`.
offer fun Count<T>(items: []T, holds: fun(T) -> bool) -> int {
  var total = 0
  var i = 0
  while i < items.len {
    if holds(items[i]) {
      total = total + 1
    }
    i = i + 1
  }
  return total
}

/// Where the first one that satisfies `holds` is, or -1.
///
/// The index rather than the value: a caller that wants the value has
/// the slice, and one that wants to write it back needs the index.
offer fun Find<T>(items: []T, holds: fun(T) -> bool) -> int {
  var i = 0
  while i < items.len {
    if holds(items[i]) {
      return i
    }
    i = i + 1
  }
  return -1
}

/// Runs `body` on each element.
offer fun Each<T>(items: []T, body: fun(T)) {
  var i = 0
  while i < items.len {
    body(items[i])
    i = i + 1
  }
}

/// Folds `items` into one value, left to right.
offer fun Fold<T, A>(items: []T, start: A, join: fun(A, T) -> A) -> A {
  var total = start
  var i = 0
  while i < items.len {
    total = join(total, items[i])
    i = i + 1
  }
  return total
}

/// Replaces each element with what `change` makes of it, in place.
///
/// In place rather than into a new list: a list that owns its storage is
/// something to free, and a caller that wants both keeps a copy.
offer fun MapInPlace<T>(items: []T, change: fun(T) -> T) {
  var i = 0
  while i < items.len {
    items[i] = change(items[i])
    i = i + 1
  }
}

/// Moves everything that satisfies `holds` to the front, and answers how
/// many there are.
///
/// What filtering is without allocating: the caller takes the first `n`
/// elements, and what was dropped is past them.
offer fun Keep<T>(items: []T, holds: fun(T) -> bool) -> int {
  var kept = 0
  var i = 0
  while i < items.len {
    if holds(items[i]) {
      const held = items[i]
      items[i] = items[kept]
      items[kept] = held
      kept = kept + 1
    }
    i = i + 1
  }
  return kept
}

@Test
fun AsksAboutEveryElement() -> bool uses unsafe {
  var list = ListNew<int>()
  var i = 1
  while i <= 5 {
    list.Push(i)
    i = i + 1
  }
  const items = list.Items()
  const limit = 3
  // The closures take `limit` with them, which is the point.
  return Any(items, |x| x > limit) && !All(items, |x| x > limit) && Count(
      items,
      |x| x > limit) == 2 && Find(items, |x| x == limit) == 2 && Find(
      items,
      |x| x == 99) == -1 && Fold(items, 0, |total, x| total + x) == 15
}

@Test
fun ChangesAndFiltersInPlace() -> bool uses unsafe {
  var list = ListNew<int>()
  var i = 1
  while i <= 6 {
    list.Push(i)
    i = i + 1
  }
  const items = list.Items()
  const factor = 10
  MapInPlace(items, |x| x * factor)
  if items[0] != 10 || items[5] != 60 {
    return false
  }
  const kept = Keep(items, |x| x > 30)
  return kept == 3 && items[0] > 30 && items[1] > 30 && items[2] > 30
}
