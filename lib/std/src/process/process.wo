// The program itself: stopping, and running another one.
//
// `Run` is the one that needs saying out loud: it hands a command line to
// the system shell, which means the caller is responsible for what is in
// it. A program that builds a command out of something a user typed has a
// hole, and `uses unsafe` is where that responsibility is recorded.

need std.env.{System}
need std.text.{BuilderNew, Bytes, IndexOf, Length, StartsWith, TextFromRaw}

extern "C" fun exit(code: s32)
extern "C" fun wolang_process_id() -> s32
extern "C" fun system(command: *u8) -> s32
extern "C" fun wolang_sleep_micros(micros: u64)

/// Stops the program with `code`. Nothing after this runs.
///
/// Destructors do not run: a program that has to tidy up should return
/// from `main` instead, and this is for the case where there is nothing
/// left to tidy.
offer fun Exit(code: int) uses unsafe {
  exit(code as s32)
}

/// This program's identifier.
offer fun Id() -> int uses unsafe {
  return wolang_process_id() as int
}

/// Runs `command` through the system shell and answers its exit code.
///
/// `unsafe` because the command is a string: what is in it is the
/// caller's responsibility, and a command built from input a program did
/// not choose is the oldest hole there is.
offer fun Run(command: text) -> int uses unsafe {
  // The shell wants a C string, and a `text` is a view with a length --
  // so a copy with a zero after it is what crosses.
  var builder = BuilderNew()
  builder.Append(command)
  builder.AppendByte(0)
  const terminated = builder.Text()
  return system(terminated.data) as int
}

/// Sleeps for `millis` milliseconds.
offer fun Sleep(millis: int) uses unsafe {
  if millis <= 0 {
    return
  }
  wolang_sleep_micros((millis * 1000) as u64)
}

// ------------------------------------------------------------- tests ---

@Test
fun KnowsItsOwnIdentifier() -> bool uses unsafe {
  return Id() > 0
}

@Test
fun RunsACommand() -> bool uses unsafe {
  // `true` and `false` are the two programs every system has, and their
  // exit codes are the whole contract.
  if System() == "windows" {
    return Run("exit 0") == 0 && Run("exit 1") != 0
  }
  return Run("true") == 0 && Run("false") != 0
}

@Test
fun SleepsAndComesBack() -> bool uses unsafe {
  Sleep(1)
  return true
}

// ------------------------------------------------ starting another program ---
//
// `Run` hands a string to the shell, which is enough for a build step
// and wrong for everything else: a tool wants the output, the error
// stream and the code, and a command built out of user input must not
// reach a shell at all (D153).

need std.mem.{ArrayNew, Free}

extern "C" fun wolang_spawn(
    command: *u8,
    length: u64,
    input: *u8,
    input_length: u64,
    out: *mut u8,
    out_room: u64,
    out_written: *mut u64,
    errors: *mut u8,
    errors_room: u64,
    errors_written: *mut u64) -> s32

/// What another program did.
offer struct Said {
  /// Its exit code, or a negative number when the system stopped it or
  /// it could not be started at all.
  var code: int = -1
  var out: text = ""
  var errors: text = ""
}

/// How much of each stream to keep. A program that says more than this
/// has the rest dropped, which beats a tool that grows without bound.
offer const kMostOutput: int = 1048576

/// Runs `command` and collects what it said.
///
/// No shell: the command is split on blanks with quoted runs kept
/// whole, and the program is started directly. Which is the difference
/// between running `git` and running whatever a `;` in an argument says
/// (D153).
offer fun Start(command: text) -> Said uses unsafe {
  return StartWith(command, "")
}

/// The same, with `input` written to the program's standard input.
offer fun StartWith(command: text, input: text) -> Said uses unsafe {
  const bytes = Bytes(command)
  if bytes.len == 0 {
    return Said(-1, "", "")
  }
  var out = ArrayNew<u8>(kMostOutput)
  var errors = ArrayNew<u8>(kMostOutput)
  var out_written: u64 = 0
  var errors_written: u64 = 0

  const given = Bytes(input)
  var input_at: *u8 = &out[0]
  var input_length: u64 = 0
  if given.len != 0 {
    input_at = &given[0]
    input_length = given.len as u64
  }

  const code = wolang_spawn(
      &bytes[0],
      bytes.len as u64,
      input_at,
      input_length,
      &mut out[0],
      kMostOutput as u64,
      &mut out_written,
      &mut errors[0],
      kMostOutput as u64,
      &mut errors_written)

  // Copied out, because the buffers go back and the text must not.
  var said = BuilderNew()
  said.Append(TextFromRaw(&out[0], out_written as int))
  var complained = BuilderNew()
  complained.Append(TextFromRaw(&errors[0], errors_written as int))
  Free(out)
  Free(errors)
  return Said(code as int, said.Release(), complained.Release())
}

/// Whether `command` exists and ran without complaint.
offer fun Works(command: text) -> bool uses unsafe {
  return Start(command).code == 0
}

// ------------------------------------------------------------- tests ---

@Test
fun CollectsWhatAProgramSaid() -> bool uses unsafe {
  if System() == "windows" {
    const said = Start("cmd /c echo hello from the child")
    const failed = Start("cmd /c exit 3")
    const missing = Start("this-program-does-not-exist")
    return said.code == 0 && said.out == "hello from the child\r\n" && said.errors == "" && failed.code == 3 && missing.code == 127
  }
  const said = Start("echo hello from the child")
  const failed = Start("sh -c 'exit 3'")
  const missing = Start("this-program-does-not-exist")
  return said.code == 0 && said.out == "hello from the child\n" && said.errors == "" && failed.code == 3 && missing.code == 127
}

@Test
fun WritesToAProgramsInput() -> bool uses unsafe {
  // `cat` gives back whatever it was given, which is the shortest round
  // trip through a pipe there is.
  if System() == "windows" {
    const sorted = StartWith("sort", "through the pipe")
    return sorted.code == 0 && StartsWith(sorted.out, "through the pipe")
  }
  const said = StartWith("cat", "through the pipe")
  const counted = StartWith("wc -c", "12345")
  return said.code == 0 && said.out == "through the pipe" && counted.code == 0 && counted.out.len > 0
}

@Test
fun KeepsQuotedWordsWhole() -> bool uses unsafe {
  // One argument with a blank in it, which is what the quoting is for.
  if System() == "windows" {
    const found = StartWith(
        "findstr '/c:one argument'",
        "has one argument in it")
    return found.code == 0 && StartsWith(found.out, "has one argument in it")
  }
  const said = Start("echo 'one argument'")
  return said.code == 0 && said.out == "one argument\n"
}

extern "C" fun wolang_spawn_in(
    command: *u8,
    length: u64,
    input: *u8,
    input_length: u64,
    directory: *u8,
    directory_length: u64,
    environment: *u8,
    environment_length: u64,
    out: *mut u8,
    out_room: u64,
    out_written: *mut u64,
    errors: *mut u8,
    errors_room: u64,
    errors_written: *mut u64) -> s32

/// Everything a caller may say about how a program runs.
///
/// Built up and handed to `StartCommand`, the way an HTTP call is
/// built up and handed to `Perform` (D151):
/// the command, what to write to it, where to run it, and what to add
/// to its environment.
offer struct Command {
  var command: text = ""
  var input: text = ""
  var directory: text = ""
  /// `NAME=value` lines, added to what this process has rather than
  /// replacing it -- a child with no `PATH` cannot find anything.
  var environment: text = ""
}

offer fun CommandNew(command: text) -> Command {
  return Command(command, "", "", "")
}

offer fun WithInput(run: Command, input: text) -> Command {
  var held = run
  held.input = input
  return held
}

offer fun WithDirectory(run: Command, directory: text) -> Command {
  var held = run
  held.directory = directory
  return held
}

/// One more `NAME=value` for the child.
offer fun WithVariable(run: Command, name: text, value: text) -> Command uses unsafe {
  var held = run
  if Length(held.environment) != 0 {
    held.environment = held.environment + "\n"
  }
  held.environment = held.environment + name + "=" + value
  return held
}

/// Runs what the `Command` describes.
offer fun StartCommand(run: Command) -> Said uses unsafe {
  const command = Bytes(run.command)
  if command.len == 0 {
    return Said(-1, "", "")
  }
  var out = ArrayNew<u8>(kMostOutput)
  var errors = ArrayNew<u8>(kMostOutput)
  var out_written: u64 = 0
  var errors_written: u64 = 0

  const input = Bytes(run.input)
  const directory = Bytes(run.directory)
  const environment = Bytes(run.environment)
  var input_at: *u8 = &out[0]
  var input_length: u64 = 0
  if input.len != 0 {
    input_at = &input[0]
    input_length = input.len as u64
  }
  var directory_at: *u8 = &out[0]
  var directory_length: u64 = 0
  if directory.len != 0 {
    directory_at = &directory[0]
    directory_length = directory.len as u64
  }
  var environment_at: *u8 = &out[0]
  var environment_length: u64 = 0
  if environment.len != 0 {
    environment_at = &environment[0]
    environment_length = environment.len as u64
  }

  const code = wolang_spawn_in(
      &command[0],
      command.len as u64,
      input_at,
      input_length,
      directory_at,
      directory_length,
      environment_at,
      environment_length,
      &mut out[0],
      kMostOutput as u64,
      &mut out_written,
      &mut errors[0],
      kMostOutput as u64,
      &mut errors_written)

  var said = BuilderNew()
  said.Append(TextFromRaw(&out[0], out_written as int))
  var complained = BuilderNew()
  complained.Append(TextFromRaw(&errors[0], errors_written as int))
  Free(out)
  Free(errors)
  return Said(code as int, said.Release(), complained.Release())
}

@Test
fun RunsSomewhereWithSomething() -> bool uses unsafe {
  // `pwd` in a directory that is not this one, and a variable the
  // child can see and this process cannot.
  if System() == "windows" {
    var windows = CommandNew("cmd /c 'cd & echo %WOLANG_TEST_MARK%'")
    windows = WithDirectory(windows, "C:\\Windows")
    windows = WithVariable(windows, "WOLANG_TEST_MARK", "seen")
    const said = StartCommand(windows)
    return said.code == 0 && IndexOf(said.out, "Windows") >= 0 && IndexOf(
        said.out,
        "seen") >= 0
  }
  var run = CommandNew("sh -c 'pwd; echo $WOLANG_TEST_MARK'")
  run = WithDirectory(run, "/tmp")
  run = WithVariable(run, "WOLANG_TEST_MARK", "seen")
  const said = StartCommand(run)
  return said.code == 0 && IndexOf(said.out, "tmp") >= 0 && IndexOf(
      said.out,
      "seen") >= 0
}
