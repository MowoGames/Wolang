// A hash map, open addressed.
//
// Keys are compared and hashed through function values the map is built
// with, rather than through an ability with a `Self` type the language does
// not have yet (D91). That is not a workaround so much as the honest
// shape: `MapNew(IntHash, IntEquals)` says what it does, and a map keyed
// by something unusual needs no new declaration anywhere.

need std.mem.{ArrayNew, Free}
need std.iter.{Iterable, Iterator}
need std.hash.{TextEquals, TextHash}

/// A map from `K` to `V`.
///
/// Open addressing with linear probing and a load factor of a half: one
/// allocation per table rather than one per entry, which is what makes a
/// lookup a couple of cache lines instead of a pointer chase. `deinit`
/// gives the three arrays back.
offer class Map<K, V> {
  var keys: []mut K
  var values: []mut V
  var filled: []mut bool
  var count: int = 0
  var hash: fun(K) -> int
  var equals: fun(K, K) -> bool

  deinit  {
    Free(keys)
    Free(values)
    Free(filled)
  }

  fun Len() -> int {
    return count
  }

  /// What `for key in map` walks with: the keys, and `Get` for the rest.
  fun Iterate() -> MapWalk<K, V> {
    return MapWalk<K, V>(self, -1)
  }

  /// Where `key` is, or where it would go. -1 when there is no room,
  /// which cannot happen while the load factor is kept under one.
  fun Slot(key: K) -> int {
    const size = filled.len
    if size == 0 {
      return -1
    }
    var index = hash(key) % size
    if index < 0 {
      index = index + size
    }
    var steps = 0
    while steps < size {
      if !filled[index] {
        return index
      }
      if equals(keys[index], key) {
        return index
      }
      index = index + 1
      if index >= size {
        index = 0
      }
      steps = steps + 1
    }
    return -1
  }

  fun Has(key: K) -> bool {
    const at = Slot(key)
    if at < 0 {
      return false
    }
    return filled[at]
  }

  /// The value for `key`, or `fallback` when it is not there. A total
  /// function rather than an optional, because `V` may be anything and an
  /// optional of it would be a second allocation shape to lay out.
  fun Get(key: K, fallback: V) -> V {
    const at = Slot(key)
    if at < 0 || !filled[at] {
      return fallback
    }
    return values[at]
  }

  fun Put(key: K, value: V) uses unsafe {
    Reserve(count + 1)
    const at = Slot(key)
    if at < 0 {
      return
    }
    if !filled[at] {
      filled[at] = true
      keys[at] = key
      count = count + 1
    }
    values[at] = value
  }

  /// Takes `key` out. Answers whether it was there.
  ///
  /// By shifting the run that follows back rather than by leaving a
  /// tombstone: a probe stops at the first empty slot, so a hole in the
  /// middle of a run would hide everything after it. Shifting keeps the
  /// invariant that every key is reachable from where it hashes to,
  /// which is what makes a lookup a walk and not a search.
  fun Remove(key: K) -> bool {
    const size = filled.len
    const at = Slot(key)
    if at < 0 || !filled[at] {
      return false
    }
    filled[at] = false
    count = count - 1

    // Everything in the run after the hole is reinserted where it
    // belongs, which for most of them is where they already are.
    var hole = at
    var next = at + 1
    if next >= size {
      next = 0
    }
    while filled[next] {
      var wanted = hash(keys[next]) % size
      if wanted < 0 {
        wanted = wanted + size
      }
      // Whether this entry may move back into the hole: it may when the
      // hole is between where it wants to be and where it is.
      const moves = Between(wanted, hole, next, size)
      if moves {
        keys[hole] = keys[next]
        values[hole] = values[next]
        filled[hole] = true
        filled[next] = false
        hole = next
      }
      next = next + 1
      if next >= size {
        next = 0
      }
    }
    return true
  }

  /// Makes room for `wanted` entries, keeping the table at most half
  /// full: linear probing degrades sharply past that, and the whole
  /// reason to probe rather than chain is that it does not chase
  /// pointers.
  fun Reserve(wanted: int) uses unsafe {
    if wanted * 2 <= filled.len {
      return
    }
    var size = filled.len * 2
    if size < 8 {
      size = 8
    }
    while size < wanted * 2 {
      size = size * 2
    }

    const old_keys = keys
    const old_values = values
    const old_filled = filled
    keys = ArrayNew<K>(size)
    values = ArrayNew<V>(size)
    filled = ArrayNew<bool>(size)
    count = 0

    var i = 0
    while i < old_filled.len {
      if old_filled[i] {
        // Rehashed rather than copied: where an entry goes depends on the
        // size of the table it is in.
        Put(old_keys[i], old_values[i])
      }
      i = i + 1
    }
    Free(old_keys)
    Free(old_values)
    Free(old_filled)
  }
}

/// Walks the entries of a map, in whatever order the table holds them.
///
/// A map is a table with holes, so walking it means skipping them: that
/// is why this is a class with a position rather than an index into
/// anything the caller can see.
offer class MapWalk<K, V> {
  var over: Map<K, V>
  var at: int = -1

  fun Next() -> bool {
    at = at + 1
    while at < over.filled.len {
      if over.filled[at] {
        return true
      }
      at = at + 1
    }
    return false
  }

  fun Value() -> K {
    return over.keys[at]
  }
}

/// An empty map, with no table until something is put in it.
fun Between(wanted: int, hole: int, at: int, _size: int) -> bool {
  // Whether `hole` is in the stretch from `wanted` to `at`, going round the
  // table. The one question backward-shift deletion asks.
  if wanted <= at {
    return wanted <= hole && hole < at
  }
  // The run wrapped round the end of the table.
  return wanted <= hole || hole < at
}

offer fun MapNew<K, V>(hash: keep fun(K) -> int, equals: keep fun(K, K) -> bool) -> Map<K, V> uses unsafe {
  return Map<K, V>(
      ArrayNew<K>(0),
      ArrayNew<V>(0),
      ArrayNew<bool>(0),
      0,
      hash,
      equals)
}

/// Hashing and comparing for `int` keys, which is most of them.
offer fun IntHash(key: int) -> int {
  // A multiplicative hash, masked back.
  //
  // Arithmetic traps on overflow in this language, and `int` is 64 bits
  // (D238), so a plain multiply of a key above 3.4e9 would trap. The result
  // only keeps 31 bits, and those depend on the low 31 bits of the key, so
  // the key is cut to them first: the value is the old one for every key
  // that fit 32 bits. A key outside that range folds its higher bits in so
  // that keys 2^31 apart do not all collide. The mask keeps the result
  // positive: a map takes it modulo the table size, and a negative
  // remainder would index backwards.
  var low = key & 2147483647
  const high = key >> 31
  if high != 0 && high != -1 {
    low = low ^ (high & 2147483647)
  }
  return (low * 2654435761) & 2147483647
}

offer fun IntEquals(left: int, right: int) -> bool {
  return left == right
}

/// A map keyed by `int`, with the hashing already chosen.
offer fun IntMapNew<V>() -> Map<int, V> uses unsafe {
  return MapNew<int, V>(IntHash, IntEquals)
}

/// A map keyed by `text`: what a symbol table is (D250).
offer fun TextMapNew<V>() -> Map<text, V> uses unsafe {
  return MapNew<text, V>(TextHash, TextEquals)
}

extend<K, V> MapWalk<K, V> as Iterator {
  type Item = K
}

extend<K, V> Map<K, V> as Iterable {
  type Walker = MapWalk<K, V>
}

// ------------------------------------------------------------- tests ---

@Test
fun HashesAKeyPastThirtyTwoBitsWithoutTrapping() -> bool {
  const big = 1099511627776
  return IntHash(big) >= 0 && IntHash(big + 1) != IntHash(big) && IntHash(-big) >= 0
}

@Test
fun KeepsTheHashOfASmallKey() -> bool {
  return IntHash(1) == 506952113 && IntHash(-1) == 1640531535
}

@Test
fun PutsAndGets() -> bool uses unsafe {
  var map = MapNew<int, int>(IntHash, IntEquals)
  var i = 0
  while i < 50 {
    map.Put(i, i * 3)
    i = i + 1
  }
  if map.Len() != 50 {
    return false
  }
  if map.Get(0, -1) != 0 || map.Get(7, -1) != 21 || map.Get(49, -1) != 147 {
    return false
  }
  return map.Get(50, -1) == -1 && !map.Has(50) && map.Has(7)
}

@Test
fun TakesAKeyOutAndKeepsTheRestFindable() -> bool uses unsafe {
  var map = MapNew<int, int>(IntHash, IntEquals)
  var i = 0
  // Enough keys that several share a run, which is where a removal that
  // left a hole would lose one.
  while i < 40 {
    map.Put(i, i * 3)
    i = i + 1
  }
  var removed = 0
  i = 0
  while i < 40 {
    if i % 3 == 0 && map.Remove(i) {
      removed = removed + 1
    }
    i = i + 1
  }
  var found = 0
  i = 0
  while i < 40 {
    if i % 3 != 0 && map.Get(i, -1) == i * 3 {
      found = found + 1
    }
    i = i + 1
  }
  const gone = !map.Has(0) && !map.Has(3) && map.Has(1)
  const left = map.Len()
  return removed == 14 && found == 26 && gone && left == 26
}

@Test
fun WalksEveryKey() -> bool uses unsafe {
  var map = MapNew<int, int>(IntHash, IntEquals)
  var i = 0
  while i < 20 {
    map.Put(i, i * 2)
    i = i + 1
  }
  var keys = 0
  var sum = 0
  for key in map {
    keys = keys + 1
    sum = sum + map.Get(key, 0)
  }
  // Every key once, and the values that go with them: 2 * (0 + ... + 19).
  return keys == 20 && sum == 380
}

@Test
fun BuildsMapsWithTheHashingChosen() -> bool uses unsafe {
  var words = TextMapNew<int>()
  words.Put("let", 1)
  words.Put("fun", 2)
  words.Put("let", 3)
  var numbers = IntMapNew<text>()
  numbers.Put(7, "seven")
  return words.Len() == 2 && words.Get("let", -1) == 3 && words.Get("fun", -1) == 2 && !words.Has("var") && numbers.Get(7, "") == "seven"
}

@Test
fun OverwritesAKey() -> bool uses unsafe {
  var map = MapNew<int, int>(IntHash, IntEquals)
  map.Put(3, 1)
  map.Put(3, 2)
  return map.Len() == 1 && map.Get(3, -1) == 2
}
