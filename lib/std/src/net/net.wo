// Sockets: a client that connects, and a listener that accepts.
//
// The floor is the runtime's own socket calls rather than the system's.
// Berkeley's interface is the same everywhere except on Windows, where a
// socket is a handle rather than a descriptor, closing one has another
// name, and the library has to be started first -- and a language with
// no conditional compilation cannot write a binding twice. So the
// difference lives in C, in one file, and this module is the same
// everywhere (D158).

need std.mem.{ArrayNew, Free}
need std.text.{BuilderNew, Bytes}

extern "C" fun wolang_socket_open() -> s64 uses net
extern "C" fun wolang_socket_connect(socket: s64, address: u32, port: u32) -> s32 uses net
extern "C" fun wolang_socket_listen(
    socket: s64,
    address: u32,
    port: u32,
    backlog: s32) -> s32 uses net
extern "C" fun wolang_socket_accept(socket: s64) -> s64 uses net
extern "C" fun wolang_socket_send(socket: s64, bytes: *u8, count: s64) -> s64 uses net
extern "C" fun wolang_socket_receive(socket: s64, bytes: *mut u8, room: s64) -> s64 uses net
extern "C" fun wolang_socket_close(socket: s64) -> s32 uses net
extern "C" fun wolang_socket_reuse(socket: s64, on: s32) -> s32 uses net
extern "C" fun wolang_socket_nodelay(socket: s64, on: s32) -> s32 uses net
extern "C" fun wolang_socket_blocking(socket: s64, on: s32) -> s32 uses net
extern "C" fun wolang_socket_port(socket: s64) -> s32 uses net
extern "C" fun wolang_udp_open() -> s64 uses net
extern "C" fun wolang_udp_bind(socket: s64, address: u32, port: u32) -> s32 uses net
extern "C" fun wolang_udp_send_to(
    socket: s64,
    address: u32,
    port: u32,
    bytes: *u8,
    count: s64) -> s64 uses net
extern "C" fun wolang_udp_receive_from(
    socket: s64,
    bytes: *mut u8,
    room: s64,
    address: *mut u32,
    port: *mut u32,
    truncated: *mut s32) -> s64 uses net
extern "C" fun wolang_udp_broadcast(socket: s64, on: s32) -> s32 uses net
extern "C" fun wolang_resolve(host: *u8, length: u64, out: *mut u32) -> s32 uses net

/// One connection, open until it is closed.
offer class Socket {
  var fd: s32 = -1

  fun IsOpen() -> bool {
    return fd >= 0
  }

  /// Sends everything in `message`. False when the other end went away.
  fun Send(message: text) -> bool uses unsafe {
    if fd < 0 {
      return false
    }
    const bytes = Bytes(message)
    var at = 0
    while at < bytes.len {
      const written = wolang_socket_send(
          fd as s64,
          &bytes[at],
          (bytes.len - at) as s64)
      if written <= 0 {
        return false
      }
      at = at + written as int
    }
    return true
  }

  /// Reads up to `limit` bytes. "" when the other end closed.
  fun Receive(limit: int) -> text uses unsafe {
    if fd < 0 || limit <= 0 {
      return ""
    }
    var buffer = ArrayNew<u8>(limit)
    const received = wolang_socket_receive(
        fd as s64,
        &mut buffer[0],
        limit as s64)
    if received <= 0 {
      Free(buffer)
      return ""
    }
    var builder = BuilderNew()
    var i = 0
    while i < received as int {
      builder.AppendByte(buffer[i])
      i = i + 1
    }
    Free(buffer)
    return builder.Release()
  }

  /// Reads until the other end closes or `limit` bytes have arrived.
  fun ReceiveAll(limit: int) -> text uses unsafe {
    var builder = BuilderNew()
    var total = 0
    while total < limit {
      const piece = Receive(4096)
      if piece.len == 0 {
        break
      }
      builder.Append(piece)
      total = total + piece.len
    }
    return builder.Release()
  }

  fun Close() uses unsafe {
    if fd >= 0 {
      const _closed = wolang_socket_close(fd as s64)
      fd = -1
    }
  }

  /// Whether small writes go out at once rather than waiting for more.
  /// What a server turns off, because a reply held back is latency
  /// nobody asked for.
  fun SetNoDelay(on: bool) uses unsafe {
    if fd < 0 {
      return
    }
    var value: s32 = 0
    if on {
      value = 1
    }
    const _set = wolang_socket_nodelay(fd as s64, value)
  }

  /// Whether a call that would wait answers instead.
  fun SetBlocking(on: bool) uses unsafe {
    if fd < 0 {
      return
    }
    var value: s32 = 0
    if on {
      value = 1
    }
    const _set = wolang_socket_blocking(fd as s64, value)
  }
}

/// The number a dotted address spells, or nothing.
///
/// No name lookup: a resolver is a protocol of its own, and a program
/// that needs one should say so rather than have it happen inside a
/// connect.
offer fun ParseAddress(host: text) -> s64? uses unsafe {
  const bytes = Bytes(host)
  var parts: [4]s64
  var count = 0
  var value: s64 = 0
  var digits = 0
  var i = 0
  while i <= bytes.len {
    // One past the end counts as a dot, so the last part is taken by the
    // same code as the three before it.
    var byte: u8 = 46
    if i < bytes.len {
      byte = bytes[i]
    }
    i = i + 1
    if byte == 46 {
      if digits == 0 || count >= 4 {
        return null
      }
      parts[count] = value
      count = count + 1
      value = 0
      digits = 0
      continue
    }
    if byte < 48 || byte > 57 {
      return null
    }
    value = value * 10 + (byte - 48) as s64
    digits = digits + 1
    if value > 255 {
      return null
    }
  }
  if count != 4 {
    return null
  }
  // Four bytes in the order a person writes them. As a 64-bit number,
  // because `128.0.0.0` already does not fit a signed 32-bit one -- which
  // is what made resolving a real host overflow (D148).
  return parts[0] * 16777216 + parts[1] * 65536 + parts[2] * 256 + parts[3]
}

/// The address `host` names, whether it is written as numbers or as a
/// name.
///
/// A dotted address is read here; a name goes to the system's resolver,
/// because that is what every other program on the machine uses (D148).
offer fun Resolve(host: text) -> s64? uses net, unsafe {
  if const number = ParseAddress(host) {
    return number
  }
  const bytes = Bytes(host)
  if bytes.len == 0 {
    return null
  }
  var found: u32 = 0
  if wolang_resolve(&bytes[0], bytes.len as u64, &mut found) != 0 {
    return null
  }
  return found as s64
}

/// Connects to `host` on `port`. A closed socket when it fails.
offer fun Connect(host: text, port: int) -> Socket uses net, unsafe {
  const address = Resolve(host)
  if const number = address {
    const fd = wolang_socket_open()
    if fd < 0 {
      return Socket(-1)
    }
    if wolang_socket_connect(fd, number as u32, port as u32) < 0 {
      const _closed = wolang_socket_close(fd)
      return Socket(-1)
    }
    return Socket(fd as s32)
  }
  return Socket(-1)
}

/// A socket listening on `port`, or a closed one.
offer fun Listen(port: int, backlog: int) -> Socket uses net, unsafe {
  const fd = wolang_socket_open()
  if fd < 0 {
    return Socket(-1)
  }
  // Let the port be reused, or a restarted program waits for the system
  // to let go of the last one.
  const _option = wolang_socket_reuse(fd, 1)
  if wolang_socket_listen(fd, 0, port as u32, backlog as s32) < 0 {
    const _closed = wolang_socket_close(fd)
    return Socket(-1)
  }
  return Socket(fd as s32)
}

/// Waits for a connection on a listening socket.
offer fun Accept(listener: Socket) -> Socket uses net, unsafe {
  if !listener.IsOpen() {
    return Socket(-1)
  }
  const taken = wolang_socket_accept(listener.fd as s64)
  if taken < 0 {
    return Socket(-1)
  }
  return Socket(taken as s32)
}

/// One datagram received: how many bytes landed in the caller's buffer,
/// who sent it, and whether it was longer than the buffer (then the rest
/// is gone, as UDP has no way to ask for it again).
offer struct Datagram {
  var count: int
  var address: s64
  var port: int
  var truncated: bool
}

/// An unconnected datagram socket (D244). Its `fd` can be given to a
/// poller like any other descriptor.
offer class UdpSocket {
  var fd: s32 = -1

  fun IsOpen() -> bool {
    return fd >= 0
  }

  /// The port the socket is bound to; how port 0 says which was picked.
  /// -1 when closed.
  fun LocalPort() -> int uses net, unsafe {
    if fd < 0 {
      return -1
    }
    return wolang_socket_port(fd as s64) as int
  }

  /// Sends `bytes` as one datagram to `address` (see `Resolve`) and
  /// `port`. The bytes sent, or -1: closed socket, no bytes, or more than
  /// 65507 (the most a datagram carries).
  fun SendTo(address: s64, port: int, bytes: []u8) -> int uses net, unsafe {
    if fd < 0 || bytes.len == 0 || port < 0 || port > 65535 {
      return -1
    }
    return wolang_udp_send_to(
        fd as s64,
        address as u32,
        port as u32,
        &bytes[0],
        bytes.len as s64) as int
  }

  /// Sends the bytes of `message`; see `SendTo`.
  fun SendTextTo(address: s64, port: int, message: text) -> int uses net, unsafe {
    return SendTo(address, port, Bytes(message))
  }

  /// Takes one datagram into `buffer`, never writing past its length. Null
  /// when a non-blocking socket has nothing yet, or on an error; a
  /// datagram longer than the buffer comes with `truncated` set.
  fun ReceiveFrom(buffer: []mut u8) -> Datagram? uses net, unsafe {
    if fd < 0 || buffer.len == 0 {
      return null
    }
    var address: u32 = 0
    var port: u32 = 0
    var cut: s32 = 0
    const got = wolang_udp_receive_from(
        fd as s64,
        &mut buffer[0],
        buffer.len as s64,
        &mut address,
        &mut port,
        &mut cut)
    if got < 0 {
      return null
    }
    return Datagram(got as int, address as s64, port as int, cut != 0)
  }

  /// Whether `ReceiveFrom` answers null at once (true) or waits (the
  /// default).
  fun SetNonBlocking(on: bool) uses net, unsafe {
    if fd < 0 {
      return
    }
    var value: s32 = 1
    if on {
      value = 0
    }
    const _set = wolang_socket_blocking(fd as s64, value)
  }

  /// Whether datagrams may be sent to the broadcast address.
  fun SetBroadcast(on: bool) -> bool uses net, unsafe {
    if fd < 0 {
      return false
    }
    var value: s32 = 0
    if on {
      value = 1
    }
    return wolang_udp_broadcast(fd as s64, value) == 0
  }

  fun Close() uses net, unsafe {
    if fd >= 0 {
      const _closed = wolang_socket_close(fd as s64)
      fd = -1
    }
  }
}

/// A UDP socket bound to `port` on every interface (0 picks a free one;
/// ask `LocalPort`), or a closed one.
offer fun BindUdp(port: int) -> UdpSocket uses net, unsafe {
  return BindUdpOn(0, port)
}

/// Like `BindUdp` but on one local `address` (e.g. 127.0.0.1 from
/// `ParseAddress`), so a test or a LAN-only game stays off other
/// interfaces.
offer fun BindUdpOn(address: s64, port: int) -> UdpSocket uses net, unsafe {
  if port < 0 || port > 65535 {
    return UdpSocket(-1)
  }
  const fd = wolang_udp_open()
  if fd < 0 {
    return UdpSocket(-1)
  }
  if wolang_udp_bind(fd, address as u32, port as u32) < 0 {
    const _closed = wolang_socket_close(fd)
    return UdpSocket(-1)
  }
  return UdpSocket(fd as s32)
}

// ------------------------------------------------------------- tests ---

@Test
fun ResolvesNamesAndNumbers() -> bool uses net, unsafe {
  // `localhost` is the one name every machine answers for, and a dotted
  // address needs no resolver at all.
  const numeric = Resolve("127.0.0.1") ?? 0
  const named = Resolve("localhost") ?? 0
  return numeric == 2130706433 && named != 0 && Resolve(
      "this.name.does.not.exist.invalid") == null
}

@Test
fun ReadsDottedAddresses() -> bool uses unsafe {
  return (ParseAddress("127.0.0.1") ?? 0) == 2130706433 && (ParseAddress(
      "255.255.255.255") ?? 0) == 4294967295 && (ParseAddress("0.0.0.0") ?? -1) == 0 && ParseAddress(
      "256.0.0.1") == null && ParseAddress("1.2.3") == null && ParseAddress("") == null && ParseAddress(
      "a.b.c.d") == null
}

@Test
fun TalksToItself() -> bool uses net, unsafe {
  // A listener and a client in one program: the loopback is the one
  // network every machine has.
  var listener = Listen(18311, 4)
  if !listener.IsOpen() {
    return false
  }
  var client = Connect("127.0.0.1", 18311)
  if !client.IsOpen() {
    listener.Close()
    return false
  }
  var served = Accept(listener)
  const sent = client.Send("hello")
  const heard = served.Receive(64)
  const answered = served.Send("world")
  const back = client.Receive(64)
  served.Close()
  client.Close()
  listener.Close()
  return sent && heard == "hello" && answered && back == "world"
}

@Test
fun UdpDeliversADatagram() -> bool uses net, unsafe {
  const lo = ParseAddress("127.0.0.1") ?? 0
  var a = BindUdpOn(lo, 0)
  var b = BindUdpOn(lo, 0)
  if !a.IsOpen() || !b.IsOpen() {
    a.Close()
    b.Close()
    return false
  }
  const sent = a.SendTextTo(lo, b.LocalPort(), "ping")
  var buffer = ArrayNew<u8>(64)
  var ok = false
  if const got = b.ReceiveFrom(buffer) {
    ok = sent == 4 && got.count == 4 && got.port == a.LocalPort() && got.address == lo && !got.truncated && buffer[0] == 112 && buffer[3] == 103
  }
  Free(buffer)
  a.Close()
  b.Close()
  return ok
}

@Test
fun UdpReportsATruncatedDatagram() -> bool uses net, unsafe {
  const lo = ParseAddress("127.0.0.1") ?? 0
  var a = BindUdpOn(lo, 0)
  var b = BindUdpOn(lo, 0)
  const _sent = a.SendTextTo(lo, b.LocalPort(), "abcdefgh")
  var buffer = ArrayNew<u8>(4)
  var ok = false
  if const got = b.ReceiveFrom(buffer) {
    ok = got.count == 4 && got.truncated && buffer[3] == 100
  }
  Free(buffer)
  a.Close()
  b.Close()
  return ok
}

@Test
fun UdpNonBlockingReceiveAnswersNothingYet() -> bool uses net, unsafe {
  var s = BindUdp(0)
  if !s.IsOpen() {
    return false
  }
  s.SetNonBlocking(true)
  var buffer = ArrayNew<u8>(16)
  const got = s.ReceiveFrom(buffer)
  Free(buffer)
  s.Close()
  return got == null
}

@Test
fun UdpRefusesAnEmptyOrClosedSend() -> bool uses net, unsafe {
  const lo = ParseAddress("127.0.0.1") ?? 0
  var s = BindUdpOn(lo, 0)
  const empty = s.SendTextTo(lo, 9, "")
  s.Close()
  return empty == -1 && s.SendTextTo(lo, 9, "x") == -1 && !s.IsOpen()
}
