// The program's arguments and its environment.
//
// Arguments are given to the runtime by whatever started the program --
// `main(argc, argv)` in a binary, whatever followed `--` when the driver
// ran it -- so asking for them is the same call either way (D115).

need std.text.{Bytes, TextFromRaw}

extern "C" fun wolang_args_count() -> s32 uses io
extern "C" fun wolang_args_at(index: s32, length: *mut u64) -> *u8 uses io
extern "C" fun wolang_env_get(name: *u8, name_length: u64, length: *mut u64) -> *u8 uses io
extern "C" fun wolang_env_set(
    name: *u8,
    name_length: u64,
    value: *u8,
    value_length: u64) -> s32 uses io
extern "C" fun wolang_system() -> s32 uses io

/// Which system this is running on: "linux", "macos" or "windows".
offer fun System() -> text uses io, unsafe {
  const which = wolang_system()
  if which == 2 {
    return "windows"
  }
  if which == 1 {
    return "macos"
  }
  return "linux"
}

/// How many arguments the program was given.
offer fun ArgCount() -> int uses io, unsafe {
  return wolang_args_count() as int
}

/// Argument `index`, counting from zero, or "".
offer fun ArgAt(index: int) -> text uses io, unsafe {
  var length: u64 = 0
  const data = wolang_args_at(index as s32, &mut length)
  if data as u64 == 0 || length == 0 {
    return ""
  }
  return TextFromRaw(data, length as int)
}

/// The environment variable called `name`, or nothing.
///
/// An optional rather than "" because a variable set to nothing and one
/// that is not there mean different things to a program reading
/// configuration.
offer fun Lookup(name: text) -> text? uses io, unsafe {
  const spelling = Bytes(name)
  var length: u64 = 0
  const data = wolang_env_get(spelling.data, spelling.len as u64, &mut length)
  // Nothing there at all, which is not the same as a variable set to
  // nothing: the address says which (D115).
  if data as u64 == 0 {
    return null
  }
  return TextFromRaw(data, length as int)
}

/// The environment variable called `name`, or `fallback`.
offer fun Get(name: text, fallback: text) -> text uses io, unsafe {
  return Lookup(name) ?? fallback
}

/// Sets one, for this program and whatever it starts. True on success.
offer fun Set(name: text, value: text) -> bool uses io, unsafe {
  const spelling = Bytes(name)
  const held = Bytes(value)
  return wolang_env_set(
      spelling.data,
      spelling.len as u64,
      held.data,
      held.len as u64) == 0
}

// ------------------------------------------------------------- tests ---

@Test
fun ReadsTheEnvironment() -> bool uses io, unsafe {
  const set = Set("WOLANG_TEST_VALUE", "seven")
  const held = Get("WOLANG_TEST_VALUE", "")
  const missing = Lookup("WOLANG_TEST_NOT_SET_ANYWHERE") == null
  return set && held == "seven" && missing
}

@Test
fun CountsItsArguments() -> bool uses io, unsafe {
  // Whatever the test runner was given, which may be none: what is being
  // checked is that asking works and that an index past the end is "".
  const count = ArgCount()
  return count >= 0 && ArgAt(count + 5) == ""
}
