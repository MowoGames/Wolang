// The console, written in Wolang over the one call the platform provides.
//
// `write` is the floor: the language cannot make a system call, and this is
// where that stops being true. Everything above it is Wolang -- which is
// what makes `Print` a function with a body rather than something the
// compiler knows about.
//
// `Write` declares `uses unsafe` and so takes responsibility for it: an
// `unsafe` effect that a declaration states is absorbed rather than
// re-exported, which is what lets a safe console be built over an unsafe
// primitive. Nothing above here is unsafe.

extern "C" fun wolang_fd_write(fd: s32, buffer: *u8, count: u64) -> s64

/// Writes `text` to standard output, with no line break.
offer fun Write(message: text) uses io, unsafe {
  const _written = wolang_fd_write(1, message.data, message.length)
}

/// Writes `text` and a line break.
offer fun Print(message: text) uses io {
  Write(message)
  Write("\n")
}

// The pieces of an interpolated string are built by the runtime, and both
// tiers call the same functions for them -- so an interpolated string
// compiles rather than dragging the program it is in into the interpreter.
// Nothing here has to declare them: lowering names them itself, the way it
// names the allocator a `class` needs.
//
// They allocate and nothing frees them yet. The collector is a later wave
// and `Owned<T>` the wave after that; until then a string that is built
// stays built, which `docs/architecture.md` says out loud.

// ------------------------------------------------------- the rest of it ---

need std.mem.{ArrayNew, Free}
need std.text.{Builder, BuilderNew}

extern "C" fun wolang_fd_read(fd: s32, buffer: *mut u8, count: u64) -> s64

/// Writes `message` to standard error, with a line break.
///
/// Its own call rather than a flag on `Print`: a program that mixes the
/// two wants them to go to different places, and "which stream" is not
/// something a caller should have to pass every time.
offer fun Warn(message: text) uses io, unsafe {
  const _written = wolang_fd_write(2, message.data, message.length)
  const _break = wolang_fd_write(2, "\n".data, 1)
}

/// Writes `message` to standard error with no line break.
offer fun WriteError(message: text) uses io, unsafe {
  const _written = wolang_fd_write(2, message.data, message.length)
}

/// Reads up to `limit` bytes of standard input.
///
/// Answers what arrived, which may be less: a pipe hands over what it
/// has. The bytes are a fresh allocation the caller owns.
offer fun ReadAll(limit: int) -> text uses io, unsafe {
  var builder = BuilderNew()
  var buffer = ArrayNew<u8>(4096)
  var total = 0
  while total < limit {
    var wanted = 4096
    if limit - total < wanted {
      wanted = limit - total
    }
    const received = wolang_fd_read(0, &mut buffer[0], wanted as u64)
    if received <= 0 {
      break
    }
    var i = 0
    while i < received as int {
      builder.AppendByte(buffer[i])
      i = i + 1
    }
    total = total + received as int
  }
  Free(buffer)
  return builder.Release()
}

/// Reads one line of standard input, without the line break.
///
/// Answers nothing at the end of input, which is what tells a loop
/// reading commands to stop -- and what "" cannot say, because an empty
/// line is a line.
offer fun ReadLine() -> text? uses io, unsafe {
  var builder = BuilderNew()
  var one = ArrayNew<u8>(1)
  var seen = 0
  loop {
    const received = wolang_fd_read(0, &mut one[0], 1)
    if received <= 0 {
      break
    }
    seen = seen + 1
    if one[0] == 10 {
      break
    }
    if one[0] != 13 {
      builder.AppendByte(one[0])
    }
  }
  Free(one)
  if seen == 0 {
    return null
  }
  return builder.Release()
}

// --------------------------------------------------------- buffered out ---
//
// `Print` is one system call per line, which is what makes a program
// that prints a hundred thousand lines spend its time in the kernel. A
// buffered writer is the usual answer: collect, then write once.
//
// Explicit rather than automatic: a program whose output is a log wants
// every line out *now*, and one writing a report wants it fast. Which it
// is is the program's decision, and `Flush` is where it says so (D145).

/// Collects output and writes it in blocks.
offer class Out {
  var held: Builder
  var fd: s32 = 1
  /// How much to collect before writing by itself.
  var most: int = 65536

  deinit  {
    // Whatever is left goes out: a writer that dropped the last line
    // would be a writer nobody could trust.
    Flush()
  }

  /// Adds `message`, writing if there is enough to be worth it.
  fun Write(message: text) uses io, unsafe {
    held.Append(message)
    if held.Len() >= most {
      Flush()
    }
  }

  /// Adds `message` and a line break.
  fun Line(message: text) uses io, unsafe {
    Write(message)
    Write("\n")
  }

  /// Writes what has been collected, if anything.
  fun Flush() uses io, unsafe {
    if held.Len() == 0 {
      return
    }
    const bytes = held.Text()
    const _written = wolang_fd_write(fd, bytes.data, bytes.length)
    held.Clear()
  }
}

/// A writer for standard output.
offer fun OutNew() -> Out uses unsafe {
  return Out(BuilderNew(), 1, 65536)
}

/// A writer for standard error.
offer fun ErrNew() -> Out uses unsafe {
  return Out(BuilderNew(), 2, 65536)
}

/// A writer for an open file descriptor.
offer fun OutTo(fd: s32) -> Out uses unsafe {
  return Out(BuilderNew(), fd, 65536)
}

// ------------------------------------------------------------- tests ---

@Test
fun BuffersUntilAsked() -> bool uses io, unsafe {
  var out = OutNew()
  // Nothing has gone out yet, which is the point: what is held is held
  // until there is enough of it or until `Flush`.
  out.Write("")
  out.Line("")
  out.Flush()
  out.Flush()
  return true
}

@Test
fun WritesToBothStreams() -> bool uses io, unsafe {
  // Nothing to assert about where they went -- the test is that they
  // return rather than trapping, which is what a wrong fd or a bad
  // pointer would do.
  Write("")
  WriteError("")
  return true
}
