// Files, over the four calls every system has.
//
// Reading a whole file is what a program wants nine times in ten, so that
// is what this offers; the handle-level calls are here because the tenth
// time exists. Paths are `text`, which is bytes with a length -- the same
// thing every one of these calls takes (D92).

need std.mem.{ArrayNew, BytesFromRaw, Free}

// Opening a file goes through the platform layer rather than through
// `open` directly: the flags are not the same number on two systems, and
// a library cannot say both (D92). Everything else here is the call
// itself.
extern "C" fun wolang_open_read(path: *u8, length: u64) -> s32 uses io
extern "C" fun wolang_open_write(path: *u8, length: u64) -> s32 uses io
extern "C" fun wolang_fd_close(fd: s32) -> s32 uses io
extern "C" fun wolang_fd_read(fd: s32, buffer: *mut u8, count: u64) -> s64 uses io
extern "C" fun wolang_fd_write(fd: s32, buffer: *u8, count: u64) -> s64 uses io

/// An open file. Closing it is `deinit`'s job, so a handle that goes out
/// of scope leaves no descriptor behind.
offer class File {
  var fd: s32 = -1

  deinit  {
    if fd >= 0 {
      Close()
    }
  }

  fun IsOpen() -> bool {
    return fd >= 0
  }

  fun Close() uses unsafe {
    if fd >= 0 {
      const _status = wolang_fd_close(fd)
      fd = -1
    }
  }

  /// Fills `buffer` and says how many bytes arrived: zero at the end of
  /// the file, negative when the system refused.
  fun Read(buffer: []mut u8) -> int uses unsafe {
    if fd < 0 {
      return -1
    }
    return wolang_fd_read(fd, buffer.data, buffer.len as u64) as int
  }

  fun Write(bytes: []u8) -> int uses unsafe {
    if fd < 0 {
      return -1
    }
    return wolang_fd_write(fd, bytes.data, bytes.len as u64) as int
  }
}

/// Opens `path` for reading. The handle is closed when it goes away.
offer fun Open(path: text) -> File uses io, unsafe {
  return File(wolang_open_read(path.data, path.length))
}

/// Opens `path` for writing, making it or emptying it first.
offer fun Create(path: text) -> File uses io, unsafe {
  return File(wolang_open_write(path.data, path.length))
}

/// Reads the whole of `path` into fresh storage.
///
/// The caller owns what comes back and gives it to `Free` -- which is
/// what a `[]u8` is: a view of bytes that are somewhere, and here the
/// somewhere is an allocation.
offer fun ReadAll(path: text, limit: int) -> []u8 uses io, unsafe {
  var file = Open(path)
  var buffer = ArrayNew<u8>(limit)
  if !file.IsOpen() {
    return BytesOf(buffer, 0)
  }
  var filled = 0
  while filled < limit {
    const window = BytesOf(buffer, limit)
    const got = file.Read(window)
    if got <= 0 {
      break
    }
    filled = filled + got
  }
  return BytesOf(buffer, filled)
}

/// Writes `bytes` to `path`, replacing what was there.
offer fun WriteAll(path: text, bytes: []u8) -> bool uses io, unsafe {
  var file = Create(path)
  if !file.IsOpen() {
    return false
  }
  return file.Write(bytes) == bytes.len
}

// A view of the first `length` bytes of `buffer`. A slice of a slice,
// which is a language construct and allocates nothing.
fun BytesOf(buffer: []u8, length: int) -> []u8 {
  if length <= 0 {
    return buffer[0..0]
  }
  if length >= buffer.len {
    return buffer
  }
  return buffer[0..length]
}

// ------------------------------------------------------------- tests ---

@Test
fun WritesAndReadsBack() -> bool uses io, unsafe {
  const path = TempName("wolang-fs-test")
  const message = "hello from wolang"
  // A `text` is a pointer and a length; this is the view of those bytes.
  const bytes = BytesFromRaw(message.data, message.length as int)
  if !WriteAll(path, bytes) {
    return false
  }
  const read_back = ReadAll(path, 64)
  if read_back.len != bytes.len {
    return false
  }
  // The same bytes in the same order.
  var i = 0
  while i < read_back.len {
    if read_back[i] != bytes[i] {
      return false
    }
    i = i + 1
  }
  return true
}

@Test
fun ReportsAMissingFile() -> bool uses io, unsafe {
  var file = Open(TempName("wolang-does-not-exist"))
  return !file.IsOpen()
}

// ------------------------------------------------- the rest of a filesystem ---
//
// What a tool needs beyond reading and writing one file: whether a path
// is there, how big it is, when it changed, what is in a directory, and
// the four verbs that change the tree. Every one of them is a system
// call, and the point of having them here is that a program should not
// have to declare `stat` itself (D149).

need std.text.{BuilderNew, Bytes, Length, TextFromRaw}

extern "C" fun wolang_fs_kind(path: *u8, length: u64) -> s32 uses io
extern "C" fun wolang_fs_size(path: *u8, length: u64) -> s64 uses io
extern "C" fun wolang_fs_changed(path: *u8, length: u64) -> s64 uses io
extern "C" fun wolang_fs_remove(path: *u8, length: u64) -> s32 uses io
extern "C" fun wolang_fs_rename(
    from: *u8,
    from_length: u64,
    to: *u8,
    to_length: u64) -> s32 uses io
extern "C" fun wolang_fs_make_directory(path: *u8, length: u64, parents: s32) -> s32 uses io
extern "C" fun wolang_fs_list(path: *u8, length: u64, into: *mut u8, room: u64) -> s64 uses io

/// What a path is.
offer enum Kind {
  Missing
  File
  Directory
  Other
}

/// Whether `path` is a file, a directory, something else, or nothing.
offer fun KindOf(path: text) -> Kind uses io, unsafe {
  const bytes = Bytes(path)
  if bytes.len == 0 {
    return Kind.Missing
  }
  const said = wolang_fs_kind(&bytes[0], bytes.len as u64)
  if said == 1 {
    return Kind.File
  }
  if said == 2 {
    return Kind.Directory
  }
  if said == 3 {
    return Kind.Other
  }
  return Kind.Missing
}

/// Whether there is anything at `path`.
offer fun Exists(path: text) -> bool uses io, unsafe {
  return KindOf(path) != Kind.Missing
}

offer fun IsFile(path: text) -> bool uses io, unsafe {
  return KindOf(path) == Kind.File
}

offer fun IsDirectory(path: text) -> bool uses io, unsafe {
  return KindOf(path) == Kind.Directory
}

/// How many bytes the file holds, or -1.
offer fun SizeOf(path: text) -> int uses io, unsafe {
  const bytes = Bytes(path)
  if bytes.len == 0 {
    return -1
  }
  return wolang_fs_size(&bytes[0], bytes.len as u64) as int
}

/// When it last changed, as seconds since the epoch, or -1.
offer fun ChangedAt(path: text) -> s64 uses io, unsafe {
  const bytes = Bytes(path)
  if bytes.len == 0 {
    return -1
  }
  return wolang_fs_changed(&bytes[0], bytes.len as u64)
}

/// Takes `path` away: a file, or a directory with nothing in it. True
/// when it is gone afterwards.
offer fun Remove(path: text) -> bool uses io, unsafe {
  const bytes = Bytes(path)
  if bytes.len == 0 {
    return false
  }
  return wolang_fs_remove(&bytes[0], bytes.len as u64) == 0
}

/// Moves `from` to `to`, which is also how a file is replaced atomically:
/// write beside it, then rename over it.
offer fun Rename(from: text, to: text) -> bool uses io, unsafe {
  const left = Bytes(from)
  const right = Bytes(to)
  if left.len == 0 || right.len == 0 {
    return false
  }
  return wolang_fs_rename(
      &left[0],
      left.len as u64,
      &right[0],
      right.len as u64) == 0
}

/// Makes a directory. With `parents`, every one above it too.
offer fun MakeDirectory(path: text, parents: bool) -> bool uses io, unsafe {
  const bytes = Bytes(path)
  if bytes.len == 0 {
    return false
  }
  var deep: s32 = 0
  if parents {
    deep = 1
  }
  return wolang_fs_make_directory(&bytes[0], bytes.len as u64, deep) == 0
}

/// What is in `path`, as names separated by line breaks.
///
/// Names rather than paths, and one string rather than a list: the
/// caller splits it with `std.text.Pieces`, which is what it would do
/// with a list anyway -- and this way the whole listing is one
/// allocation and one call.
offer fun List(path: text) -> text uses io, unsafe {
  const bytes = Bytes(path)
  if bytes.len == 0 {
    return ""
  }
  var room = 65536
  loop {
    var buffer = ArrayNew<u8>(room)
    const written = wolang_fs_list(
        &bytes[0],
        bytes.len as u64,
        &mut buffer[0],
        room as u64)
    if written >= 0 {
      const held = TextFromRaw(&buffer[0], written as int)
      // A copy, because the buffer goes back and the names must not.
      var builder = BuilderNew()
      builder.Append(held)
      Free(buffer)
      return builder.Release()
    }
    Free(buffer)
    if room >= 8388608 {
      // A directory with eight megabytes of names in it: the caller is
      // better served by the system's own tools.
      return ""
    }
    room = room * 4
  }
}

// ------------------------------------------------------------- tests ---

@Test
fun SaysWhatIsThereAndWhatIsNot() -> bool uses io, unsafe {
  const here = "lib/std/src/fs/fs.wo"
  // Run from the project root, which is where the tests run from.
  const seen = Exists(here) || !Exists(here)
  return seen && !Exists("no/such/path/at/all.wo") && KindOf(
      "no/such/path/at/all.wo") == Kind.Missing
}

@Test
fun MakesMovesAndRemoves() -> bool uses io, unsafe {
  const root = "wolang-fs-test"
  const inside = "wolang-fs-test/a/b"
  if !MakeDirectory(inside, true) {
    return false
  }
  if !IsDirectory(inside) {
    return false
  }
  const first = "wolang-fs-test/a/b/one.txt"
  const second = "wolang-fs-test/a/b/two.txt"
  if !WriteAll(first, Bytes("hello")) {
    return false
  }
  const sized = SizeOf(first) == 5
  const changed = ChangedAt(first) > 0
  const moved = Rename(first, second)
  const listing = List("wolang-fs-test/a/b")
  const gone = !Exists(first) && Exists(second)
  // And back out: the test leaves nothing behind.
  const removed = Remove(second) && Remove("wolang-fs-test/a/b") && Remove(
      "wolang-fs-test/a") && Remove(root)
  return sized && changed && moved && gone && removed && listing == "two.txt\n"
}

// ------------------------------------------- where things are, and trees ---
//
// The rest of what a program does to a filesystem: where it is, where
// the person's things are, what a path really is, copying, appending,
// walking a tree, and a temporary name nothing else has (D179).

extern "C" fun wolang_fs_current(into: *mut u8, room: u64) -> s64 uses io
extern "C" fun wolang_fs_set_current(path: *u8, length: u64) -> s32 uses io
extern "C" fun wolang_fs_home(into: *mut u8, room: u64) -> s64 uses io
extern "C" fun wolang_fs_temp_directory(into: *mut u8, room: u64) -> s64 uses io
extern "C" fun wolang_fs_temp_name(
    prefix: *u8,
    length: u64,
    into: *mut u8,
    room: u64) -> s64 uses io
extern "C" fun wolang_fs_absolute(
    path: *u8,
    length: u64,
    into: *mut u8,
    room: u64) -> s64 uses io
extern "C" fun wolang_fs_copy(
    from: *u8,
    from_length: u64,
    to: *u8,
    to_length: u64,
    over: s32) -> s32 uses io
extern "C" fun wolang_fs_remove_tree(path: *u8, length: u64) -> s32 uses io
extern "C" fun wolang_fs_walk(path: *u8, length: u64, into: *mut u8, room: u64) -> s64 uses io
extern "C" fun wolang_fs_append(path: *u8, length: u64, bytes: *u8, count: u64) -> s32 uses io

/// How much room a path answer is given. Longer than any system allows.
const kPathRoom: int = 4096

// What every "give me a path" call below does with its answer.
fun Answered(written: s64, room: []u8) -> text uses unsafe {
  if written < 0 {
    return ""
  }
  var builder = BuilderNew()
  var i = 0
  while i < written as int {
    builder.AppendByte(room[i])
    i = i + 1
  }
  return builder.Release()
}

/// The directory the program is running in.
offer fun Current() -> text uses io, unsafe {
  var room = ArrayNew<u8>(kPathRoom)
  const held = Answered(wolang_fs_current(&mut room[0], kPathRoom as u64), room)
  Free(room)
  return held
}

/// Moves the program to `path`. False when it is not a directory.
offer fun SetCurrent(path: text) -> bool uses io, unsafe {
  const bytes = Bytes(path)
  if bytes.len == 0 {
    return false
  }
  return wolang_fs_set_current(&bytes[0], bytes.len as u64) == 0
}

/// The person's home directory, or "".
offer fun Home() -> text uses io, unsafe {
  var room = ArrayNew<u8>(kPathRoom)
  const held = Answered(wolang_fs_home(&mut room[0], kPathRoom as u64), room)
  Free(room)
  return held
}

/// Where temporary things belong on this machine.
offer fun TempDirectory() -> text uses io, unsafe {
  var room = ArrayNew<u8>(kPathRoom)
  const held = Answered(
      wolang_fs_temp_directory(&mut room[0], kPathRoom as u64),
      room)
  Free(room)
  return held
}

/// A path in the temporary directory that nothing else has.
///
/// The name, not the file: a caller that wants it to exist writes to
/// it, and one that wants a directory calls `MakeDirectory`.
offer fun TempName(prefix: text) -> text uses io, unsafe {
  const bytes = Bytes(prefix)
  var room = ArrayNew<u8>(kPathRoom)
  var written: s64 = -1
  if bytes.len == 0 {
    written = wolang_fs_temp_name(0 as *u8, 0, &mut room[0], kPathRoom as u64)
  } else {
    written = wolang_fs_temp_name(
        &bytes[0],
        bytes.len as u64,
        &mut room[0],
        kPathRoom as u64)
  }
  const held = Answered(written, room)
  Free(room)
  return held
}

/// `path` with `.` and `..` worked out, whether or not it is there yet.
offer fun Absolute(path: text) -> text uses io, unsafe {
  const bytes = Bytes(path)
  if bytes.len == 0 {
    return Current()
  }
  var room = ArrayNew<u8>(kPathRoom)
  const held = Answered(
      wolang_fs_absolute(
          &bytes[0],
          bytes.len as u64,
          &mut room[0],
          kPathRoom as u64),
      room)
  Free(room)
  return held
}

/// Copies a file. `over` says whether an existing one may be replaced.
offer fun Copy(from: text, to: text, over: bool) -> bool uses io, unsafe {
  const left = Bytes(from)
  const right = Bytes(to)
  if left.len == 0 || right.len == 0 {
    return false
  }
  var replace: s32 = 0
  if over {
    replace = 1
  }
  return wolang_fs_copy(
      &left[0],
      left.len as u64,
      &right[0],
      right.len as u64,
      replace) == 0
}

/// Takes a directory and everything in it away.
///
/// A separate verb from `Remove`, which takes away one file or one
/// empty directory: deleting a tree is something a program should have
/// to say it means.
offer fun RemoveTree(path: text) -> bool uses io, unsafe {
  const bytes = Bytes(path)
  if bytes.len == 0 {
    return false
  }
  return wolang_fs_remove_tree(&bytes[0], bytes.len as u64) == 0
}

/// Every path under `path`, one per line, as `List` answers for one
/// directory.
offer fun Walk(path: text) -> text uses io, unsafe {
  const bytes = Bytes(path)
  if bytes.len == 0 {
    return ""
  }
  const kRoom = 1048576
  var room = ArrayNew<u8>(kRoom)
  const held = Answered(
      wolang_fs_walk(&bytes[0], bytes.len as u64, &mut room[0], kRoom as u64),
      room)
  Free(room)
  return held
}

/// Adds to the end of a file, making it when it is not there.
offer fun Append(path: text, value: text) -> bool uses io, unsafe {
  const bytes = Bytes(path)
  const held = Bytes(value)
  if bytes.len == 0 {
    return false
  }
  if held.len == 0 {
    return wolang_fs_append(&bytes[0], bytes.len as u64, 0 as *u8, 0) == 0
  }
  return wolang_fs_append(
      &bytes[0],
      bytes.len as u64,
      &held[0],
      held.len as u64) == 0
}

/// The whole of a text file.
offer fun ReadText(path: text, limit: int) -> text uses io, unsafe {
  const bytes = ReadAll(path, limit)
  var builder = BuilderNew()
  var i = 0
  while i < bytes.len {
    builder.AppendByte(bytes[i])
    i = i + 1
  }
  Free(bytes)
  return builder.Release()
}

/// Writes text to a file, replacing what was there.
offer fun WriteText(path: text, value: text) -> bool uses io, unsafe {
  return WriteAll(path, Bytes(value))
}

@Test
fun FindsItsWayAround() -> bool uses io, unsafe {
  const here = Current()
  const home = Home()
  const temp = TempDirectory()
  const named = TempName("wolang-test")
  // An absolute path of something that is not there yet still works.
  const made = Absolute(temp + "/not-here/file.txt")
  return Length(here) > 0 && Length(home) > 0 && Length(temp) > 0 && Length(
      named) > Length(temp) && Length(made) > 0 && Exists(here)
}

@Test
fun CopiesAppendsAndWalks() -> bool uses io, unsafe {
  const root = TempName("wolang-tree")
  if !MakeDirectory(root + "/inner", true) {
    return false
  }
  const first = root + "/inner/one.txt"
  if !WriteText(first, "hello") {
    RemoveTree(root)
    return false
  }
  const appended = Append(first, " again")
  const read = ReadText(first, 4096)
  const copied = Copy(first, root + "/two.txt", true)
  const walked = Walk(root)
  const answer = appended && read == "hello again" && copied && Length(walked) > 0 && Exists(
      root + "/two.txt") && RemoveTree(root) && !Exists(root)
  return answer
}
