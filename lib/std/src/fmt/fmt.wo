// Numbers as text, with a say in how they look.
//
// Interpolation covers the common case -- `"hp {health}"` -- and this is
// for the rest: a column that lines up, a hexadecimal byte, a price with
// two decimals. Everything here answers a `text` that owns its bytes.

need std.text.{BuilderNew, Length, PadStart, PadEnd}

/// `value` in base ten.
offer fun Int(value: int) -> text {
  return "{value}"
}

/// `value` in base ten, right-aligned in `width` with spaces.
offer fun IntWidth(value: int, width: int) -> text uses unsafe {
  return PadStart("{value}", width, " ")
}

/// `value` in base ten, right-aligned in `width` with zeros.
///
/// The sign stays in front of the zeros, which is what a reader of a
/// timestamp or an identifier expects.
offer fun IntZeros(value: int, width: int) -> text uses unsafe {
  if value < 0 {
    const digits = PadStart("{0 - value}", width - 1, "0")
    return "-{digits}"
  }
  return PadStart("{value}", width, "0")
}

/// `value` in base `base`, from 2 to 16.
offer fun Radix(value: int, base: int) -> text uses unsafe {
  if base < 2 || base > 16 {
    return "{value}"
  }
  if value == 0 {
    return "0"
  }
  var builder = BuilderNew()
  var left = value
  var negative = false
  if left < 0 {
    negative = true
    left = 0 - left
  }
  // Digits come out backwards, so they are written into a buffer and
  // reversed: a builder appends, and nothing here needs to prepend.
  var digits: [64]u8
  var count = 0
  while left > 0 && count < 64 {
    const digit = left % base
    digits[count] = Digit(digit)
    count = count + 1
    left = left / base
  }
  if negative {
    builder.AppendByte(45)
  }
  var i = count
  while i > 0 {
    builder.AppendByte(digits[i - 1])
    i = i - 1
  }
  return builder.Release()
}

fun Digit(value: int) -> u8 {
  if value < 10 {
    return (48 + value) as u8
  }
  return (87 + value) as u8
}

/// `value` in hexadecimal, with no prefix.
offer fun Hex(value: int) -> text uses unsafe {
  return Radix(value, 16)
}

/// `value` in hexadecimal, `width` digits wide.
offer fun HexWidth(value: int, width: int) -> text uses unsafe {
  return PadStart(Radix(value, 16), width, "0")
}

/// `value` in binary.
offer fun Binary(value: int) -> text uses unsafe {
  return Radix(value, 2)
}

/// `value` with `decimals` digits after the point.
///
/// Rounded half away from zero, which is what a person reading a price
/// expects -- and said here because the other roundings are defensible
/// too.
offer fun Float(value: float, decimals: int) -> text uses unsafe {
  if decimals <= 0 {
    return "{Rounded(value)}"
  }
  var scale = 1
  var i = 0
  while i < decimals {
    scale = scale * 10
    i = i + 1
  }
  const scaled = Rounded(value * scale as float)
  var whole = scaled / scale
  var fraction = scaled % scale
  if fraction < 0 {
    fraction = 0 - fraction
  }
  const digits = PadStart("{fraction}", decimals, "0")
  if scaled < 0 && whole == 0 {
    return "-0.{digits}"
  }
  return "{whole}.{digits}"
}

fun Rounded(value: float) -> int {
  if value < 0.0 {
    return (value - 0.5) as int
  }
  return (value + 0.5) as int
}

/// `value` as a percentage with `decimals` digits: `0.256` is `25.6%`.
offer fun Percent(value: float, decimals: int) -> text uses unsafe {
  return "{Float(value * 100.0, decimals)}%"
}

/// A count of bytes as a person would read it: `1536` is `1.5 KiB`.
offer fun Bytes(count: int) -> text uses unsafe {
  if count < 1024 {
    return "{count} B"
  }
  const units = ["KiB", "MiB", "GiB", "TiB"]
  var value = count as float / 1024.0
  var at = 0
  while value >= 1024.0 && at < 3 {
    value = value / 1024.0
    at = at + 1
  }
  return "{Float(value, 1)} {units[at]}"
}

/// A duration in nanoseconds as a person would read it.
offer fun Duration(nanos: s64) -> text uses unsafe {
  const value = nanos as int
  if value < 1000 {
    return "{value} ns"
  }
  if value < 1000000 {
    return "{Float(value as float / 1000.0, 1)} us"
  }
  if value < 1000000000 {
    return "{Float(value as float / 1000000.0, 1)} ms"
  }
  return "{Float(value as float / 1000000000.0, 2)} s"
}

/// `value` padded on the left to `width`.
offer fun Left(value: text, width: int) -> text uses unsafe {
  return PadEnd(value, width, " ")
}

/// `value` padded on the right to `width`.
offer fun Right(value: text, width: int) -> text uses unsafe {
  return PadStart(value, width, " ")
}

/// `value` centred in `width`.
offer fun Centre(value: text, width: int) -> text uses unsafe {
  const room = width - Length(value)
  if room <= 0 {
    return value
  }
  const left = room / 2
  return PadEnd(PadStart(value, Length(value) + left, " "), width, " ")
}

// ------------------------------------------------------------- tests ---

@Test
fun WritesNumbersInColumns() -> bool uses unsafe {
  return IntWidth(7, 4) == "   7" && IntZeros(7, 3) == "007" && IntZeros(-7, 3) == "-07" && Int(
      -42) == "-42"
}

@Test
fun WritesOtherBases() -> bool uses unsafe {
  return Hex(255) == "ff" && Hex(0) == "0" && Hex(-255) == "-ff" && HexWidth(
      10,
      4) == "000a" && Binary(5) == "101" && Radix(35, 36) == "35"
}

@Test
fun WritesFloatsWithAPoint() -> bool uses unsafe {
  return Float(1.25, 1) == "1.3" && Float(2.0, 2) == "2.00" && Float(-1.5, 1) == "-1.5" && Float(
      3.14159,
      3) == "3.142" && Float(7.0, 0) == "7" && Percent(0.256, 1) == "25.6%"
}

@Test
fun WritesSizesAndDurations() -> bool uses unsafe {
  return Bytes(512) == "512 B" && Bytes(1536) == "1.5 KiB" && Bytes(1048576) == "1.0 MiB" && Duration(
      500) == "500 ns" && Duration(1500) == "1.5 us" && Duration(2000000000) == "2.00 s"
}

@Test
fun LinesTextUp() -> bool uses unsafe {
  return Left("ab", 5) == "ab   " && Right("ab", 5) == "   ab" && Centre(
      "ab",
      6) == "  ab  " && Centre("abcdef", 3) == "abcdef"
}
