// Building and inspecting text.
//
// A `text` is a pointer and a length (D67): a view of bytes somebody else
// owns. That makes a view cheap and a *built* string somebody's
// responsibility -- so what builds one is a `Builder`, which owns its
// bytes and gives them back in `deinit` (D91).

need std.mem.{ArrayNew, BytesFromRaw, Free}
need std.iter.{Iterable, Iterator}

/// How many bytes a piece of text is. Not how many characters: UTF-8 is
/// bytes, and the two numbers differ exactly where it matters.
offer fun Length(value: text) -> int {
  return value.length as int
}

offer fun IsEmpty(value: text) -> bool {
  return value.length == 0
}

/// The bytes of `value`, as a view. Nothing is copied. The view is of text
/// that may be a literal, so it must only be read: the caller declares
/// `uses unsafe` for it (D233).
@Exposes
offer fun Bytes(value: text) -> []u8 uses unsafe {
  return BytesFromRaw(value.data, value.length as int)
}

/// Whether the two hold the same bytes.
offer fun Equals(left: text, right: text) -> bool uses unsafe {
  if left.length != right.length {
    return false
  }
  const a = Bytes(left)
  const b = Bytes(right)
  var i = 0
  while i < a.len {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  return true
}

/// Whether `value` starts with `prefix`.
offer fun StartsWith(value: text, prefix: text) -> bool uses unsafe {
  if prefix.length > value.length {
    return false
  }
  const a = Bytes(value)
  const b = Bytes(prefix)
  var i = 0
  while i < b.len {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  return true
}

/// Where `needle` first appears in `value`, or -1.
offer fun IndexOf(value: text, needle: text) -> int uses unsafe {
  if needle.length == 0 {
    return 0
  }
  if needle.length > value.length {
    return -1
  }
  const a = Bytes(value)
  const b = Bytes(needle)
  var start = 0
  while start <= a.len - b.len {
    var i = 0
    var same = true
    while i < b.len {
      if a[start + i] != b[i] {
        same = false
        i = b.len
      } else {
        i = i + 1
      }
    }
    if same {
      return start
    }
    start = start + 1
  }
  return -1
}

/// Text that owns its bytes.
///
/// Appending copies into storage the builder grew, so what comes out of
/// `Text()` stays valid until the builder goes away -- which is what a
/// destructor is for, and why this is a class and not a function.
offer class Builder {
  var bytes: []u8
  var count: int = 0

  deinit  {
    Free(bytes)
  }

  fun Len() -> int {
    return count
  }

  /// What has been built, as a view of the builder's own bytes.
  ///
  /// The view is valid only until the next `Append`, `Reserve` or `Clear`
  /// (they may move or rewrite the bytes) and until the builder dies (its
  /// destructor frees them). Returning it from the function that owns the
  /// builder, or keeping it after, dangles. A string that has to outlive
  /// the builder is `Release`, the owning one (D227).
  fun Text() -> text uses unsafe {
    return BytesAsText(bytes, count)
  }

  /// What has been built, as bytes that outlive the builder.
  ///
  /// The storage goes with the string and the builder starts again empty
  /// -- which is what a function that *returns* what it built needs, and
  /// what `Text` cannot give. Nothing frees the bytes yet: the same
  /// latitude every string that is built takes today (D67).
  fun Release() -> text uses unsafe {
    const held = BytesAsText(bytes, count)
    bytes = ArrayNew<u8>(0)
    count = 0
    return held
  }

  fun Clear() {
    count = 0
  }

  fun Append(value: text) uses unsafe {
    const source = Bytes(value)
    Reserve(count + source.len)
    var i = 0
    while i < source.len {
      bytes[count + i] = source[i]
      i = i + 1
    }
    count = count + source.len
  }

  fun AppendByte(value: u8) uses unsafe {
    Reserve(count + 1)
    bytes[count] = value
    count = count + 1
  }

  fun Reserve(wanted: int) uses unsafe {
    if wanted <= bytes.len {
      return
    }
    var capacity = bytes.len * 2
    if capacity < wanted {
      capacity = wanted
    }
    if capacity < 16 {
      capacity = 16
    }
    const grown = ArrayNew<u8>(capacity)
    var i = 0
    while i < count {
      grown[i] = bytes[i]
      i = i + 1
    }
    Free(bytes)
    bytes = grown
  }
}

offer fun BuilderNew() -> Builder uses unsafe {
  return Builder(ArrayNew<u8>(0), 0)
}

// A view of the first `length` bytes, as text. The bytes are the
// builder's and stay where they are; what this makes is the pair that
// names them.
fun BytesAsText(buffer: []u8, length: int) -> text uses unsafe {
  return TextFromRaw(buffer.data, length)
}

offer fun TextFromRaw(data: *u8, length: int) -> text uses unsafe

extend Split as Iterator {
  type Item = text
}

extend Split as Iterable {
  type Walker = Split
}

// ------------------------------------------------------------- tests ---

@Test
fun MeasuresAndCompares() -> bool uses unsafe {
  if Length("hello") != 5 || !IsEmpty("") {
    return false
  }
  if !Equals("abc", "abc") || Equals("abc", "abd") || Equals("ab", "abc") {
    return false
  }
  return StartsWith("hello world", "hello") && !StartsWith(
      "hello",
      "hello world")
}

@Test
fun FindsASubstring() -> bool uses unsafe {
  if IndexOf("hello world", "world") != 6 {
    return false
  }
  if IndexOf("hello", "l") != 2 {
    return false
  }
  return IndexOf("hello", "z") == -1 && IndexOf("hello", "") == 0
}

@Test
fun BuildsText() -> bool uses unsafe {
  var builder = BuilderNew()
  builder.Append("hello")
  builder.AppendByte(32)
  builder.Append("world")
  if builder.Len() != 11 {
    return false
  }
  const built = builder.Text()
  return Equals(built, "hello world")
}

// ------------------------------------------------- looking at a string ---

/// Whether `value` ends with `suffix`.
offer fun EndsWith(value: text, suffix: text) -> bool uses unsafe {
  const whole = Bytes(value)
  const tail = Bytes(suffix)
  if tail.len > whole.len {
    return false
  }
  var i = 0
  while i < tail.len {
    if whole[whole.len - tail.len + i] != tail[i] {
      return false
    }
    i = i + 1
  }
  return true
}

/// Whether `needle` is anywhere in `value`.
offer fun Contains(value: text, needle: text) -> bool uses unsafe {
  return IndexOf(value, needle) >= 0
}

/// Where the last `needle` is, or -1.
offer fun LastIndexOf(value: text, needle: text) -> int uses unsafe {
  const whole = Bytes(value)
  const part = Bytes(needle)
  if part.len == 0 {
    return whole.len
  }
  if part.len > whole.len {
    return -1
  }
  var at = whole.len - part.len
  loop {
    var same = true
    var i = 0
    while i < part.len {
      if whole[at + i] != part[i] {
        same = false
        break
      }
      i = i + 1
    }
    if same {
      return at
    }
    if at == 0 {
      return -1
    }
    at = at - 1
  }
}

/// The bytes from `from` up to `to`, as a view: nothing is copied, and
/// the result lasts as long as `value` does.
///
/// Out-of-range bounds are clamped rather than trapped: a slice of a
/// string is almost always computed from a search, and a search that
/// found nothing should give an empty string rather than stop the
/// program.
offer fun Substring(value: text, from: int, to: int) -> text uses unsafe {
  const bytes = Bytes(value)
  var start = from
  var end = to
  if start < 0 {
    start = 0
  }
  if end > bytes.len {
    end = bytes.len
  }
  if start >= end {
    return ""
  }
  return TextFromRaw(&bytes[start], end - start)
}

/// Everything after the first `needle`, or "" when there is none.
offer fun After(value: text, needle: text) -> text uses unsafe {
  const at = IndexOf(value, needle)
  if at < 0 {
    return ""
  }
  return Substring(value, at + Length(needle), Length(value))
}

/// Everything before the first `needle`, or the whole string.
offer fun Before(value: text, needle: text) -> text uses unsafe {
  const at = IndexOf(value, needle)
  if at < 0 {
    return value
  }
  return Substring(value, 0, at)
}

fun IsSpace(byte: u8) -> bool {
  return byte == 32 || byte == 9 || byte == 10 || byte == 13
}

/// `value` without the spaces at either end, as a view.
offer fun Trim(value: text) -> text uses unsafe {
  const bytes = Bytes(value)
  var start = 0
  while start < bytes.len && IsSpace(bytes[start]) {
    start = start + 1
  }
  var end = bytes.len
  while end > start && IsSpace(bytes[end - 1]) {
    end = end - 1
  }
  return Substring(value, start, end)
}

offer fun TrimStart(value: text) -> text uses unsafe {
  const bytes = Bytes(value)
  var start = 0
  while start < bytes.len && IsSpace(bytes[start]) {
    start = start + 1
  }
  return Substring(value, start, bytes.len)
}

offer fun TrimEnd(value: text) -> text uses unsafe {
  const bytes = Bytes(value)
  var end = bytes.len
  while end > 0 && IsSpace(bytes[end - 1]) {
    end = end - 1
  }
  return Substring(value, 0, end)
}

// --------------------------------------------------------- splitting ---

/// The pieces of a string, between one separator and the next.
///
/// A walk rather than a list: each piece is a view into the string, so
/// `for piece in Pieces(line, ",")` costs one allocation less than
/// nothing -- and the protocol is the one every type that says how to be
/// walked uses (D96).
offer class Split {
  var value: text
  var separator: text
  var at: int = 0
  var piece: text = ""
  var done: bool = false

  fun Iterate() -> Split {
    return self
  }

  fun Next() -> bool uses unsafe {
    if done {
      return false
    }
    const rest = Substring(value, at, Length(value))
    const found = IndexOf(rest, separator)
    if found < 0 || Length(separator) == 0 {
      piece = rest
      done = true
      return true
    }
    piece = Substring(rest, 0, found)
    at = at + found + Length(separator)
    return true
  }

  fun Value() -> text {
    return piece
  }
}

/// The pieces of `value` separated by `separator`.
///
/// An empty separator gives the whole string as one piece, and a string
/// with nothing in it gives one empty piece -- which is what every
/// splitter does and what a caller counting fields expects.
offer fun Pieces(value: text, separator: text) -> Split {
  return Split(value, separator, 0, "", false)
}

/// How many pieces there are.
offer fun CountPieces(value: text, separator: text) -> int uses unsafe {
  var count = 0
  for _piece in Pieces(value, separator) {
    count = count + 1
  }
  return count
}

/// The `which`th piece, counting from zero, or "".
offer fun PieceAt(value: text, separator: text, which: int) -> text uses unsafe {
  var at = 0
  for piece in Pieces(value, separator) {
    if at == which {
      return piece
    }
    at = at + 1
  }
  return ""
}

// ------------------------------------------------- making a new string ---

/// The pieces of `value` joined with `separator` between them.
///
/// Allocates: the answer is a new string, because the pieces are not next
/// to each other in memory.
offer fun Join(pieces: Split, separator: text) -> text uses unsafe {
  var builder = BuilderNew()
  var first = true
  for piece in pieces {
    if !first {
      builder.Append(separator)
    }
    builder.Append(piece)
    first = false
  }
  return builder.Release()
}

/// `value` with every `needle` replaced by `with`. Allocates.
offer fun Replace(value: text, needle: text, with: text) -> text uses unsafe {
  if Length(needle) == 0 {
    return value
  }
  var builder = BuilderNew()
  var rest = value
  loop {
    const at = IndexOf(rest, needle)
    if at < 0 {
      builder.Append(rest)
      return builder.Release()
    }
    builder.Append(Substring(rest, 0, at))
    builder.Append(with)
    rest = Substring(rest, at + Length(needle), Length(rest))
  }
}

/// `value` in upper case, for the ASCII letters. Allocates.
offer fun Upper(value: text) -> text uses unsafe {
  var builder = BuilderNew()
  const bytes = Bytes(value)
  var i = 0
  while i < bytes.len {
    const byte = bytes[i]
    if byte >= 97 && byte <= 122 {
      builder.AppendByte(byte - 32)
    } else {
      builder.AppendByte(byte)
    }
    i = i + 1
  }
  return builder.Release()
}

/// `value` in lower case, for the ASCII letters. Allocates.
offer fun Lower(value: text) -> text uses unsafe {
  var builder = BuilderNew()
  const bytes = Bytes(value)
  var i = 0
  while i < bytes.len {
    const byte = bytes[i]
    if byte >= 65 && byte <= 90 {
      builder.AppendByte(byte + 32)
    } else {
      builder.AppendByte(byte)
    }
    i = i + 1
  }
  return builder.Release()
}

/// `value` repeated `times` over. Allocates.
offer fun Repeat(value: text, times: int) -> text uses unsafe {
  var builder = BuilderNew()
  var i = 0
  while i < times {
    builder.Append(value)
    i = i + 1
  }
  return builder.Release()
}

/// `value` with `pad` added on the left until it is `width` long.
offer fun PadStart(value: text, width: int, pad: text) -> text uses unsafe {
  if Length(value) >= width || Length(pad) == 0 {
    return value
  }
  var builder = BuilderNew()
  var length = Length(value)
  while length < width {
    builder.Append(pad)
    length = length + Length(pad)
  }
  builder.Append(value)
  return builder.Release()
}

offer fun PadEnd(value: text, width: int, pad: text) -> text uses unsafe {
  if Length(value) >= width || Length(pad) == 0 {
    return value
  }
  var builder = BuilderNew()
  builder.Append(value)
  var length = Length(value)
  while length < width {
    builder.Append(pad)
    length = length + Length(pad)
  }
  return builder.Release()
}

// ----------------------------------------------------------- numbers ---

/// The whole number `value` spells, or nothing when it does not spell
/// one.
///
/// An optional rather than a fallback, because "this is not a number" and
/// "this is zero" are different answers and a program reading a
/// configuration file has to tell them apart.
offer fun ParseInt(value: text) -> int? uses unsafe {
  const bytes = Bytes(Trim(value))
  if bytes.len == 0 {
    return null
  }
  var at = 0
  var negative = false
  if bytes[0] == 45 || bytes[0] == 43 {
    negative = bytes[0] == 45
    at = 1
  }
  if at >= bytes.len {
    return null
  }
  var total = 0
  while at < bytes.len {
    const byte = bytes[at]
    if byte < 48 || byte > 57 {
      return null
    }
    total = total * 10 + (byte - 48) as int
    at = at + 1
  }
  if negative {
    return -total
  }
  return total
}

/// The number `value` spells, or nothing.
offer fun ParseFloat(value: text) -> float? uses unsafe {
  const bytes = Bytes(Trim(value))
  if bytes.len == 0 {
    return null
  }
  var at = 0
  var sign = 1.0
  if bytes[0] == 45 || bytes[0] == 43 {
    if bytes[0] == 45 {
      sign = -1.0
    }
    at = 1
  }
  var whole = 0.0
  var digits = 0
  while at < bytes.len && bytes[at] >= 48 && bytes[at] <= 57 {
    whole = whole * 10.0 + (bytes[at] - 48) as float
    at = at + 1
    digits = digits + 1
  }
  if at < bytes.len && bytes[at] == 46 {
    at = at + 1
    var scale = 0.1
    while at < bytes.len && bytes[at] >= 48 && bytes[at] <= 57 {
      whole = whole + (bytes[at] - 48) as float * scale
      scale = scale * 0.1
      at = at + 1
      digits = digits + 1
    }
  }
  if digits == 0 || at != bytes.len {
    return null
  }
  return sign * whole
}

// ------------------------------------------------------------- tests ---

@Test
fun LooksAtTheEndsOfAString() -> bool uses unsafe {
  return EndsWith("hello.wo", ".wo") && !EndsWith("hello.wo", ".c") && EndsWith(
      "x",
      "") && Contains("hello", "ell") && !Contains("hello", "z") && LastIndexOf(
      "a/b/c",
      "/") == 3 && LastIndexOf("abc", "/") == -1
}

@Test
fun TakesPartsOfAString() -> bool uses unsafe {
  return Substring("hello", 1, 3) == "el" && Substring("hello", 3, 99) == "lo" && Substring(
      "hello",
      4,
      2) == "" && After("key=value", "=") == "value" && Before("key=value", "=") == "key" && After(
      "key",
      "=") == "" && Before("key", "=") == "key"
}

@Test
fun TrimsSpace() -> bool uses unsafe {
  return Trim("  hi \n") == "hi" && Trim("   ") == "" && TrimStart(" hi ") == "hi " && TrimEnd(
      " hi ") == " hi"
}

@Test
fun WalksThePieces() -> bool uses unsafe {
  var seen = 0
  var joined = BuilderNew()
  for piece in Pieces("a,b,,c", ",") {
    seen = seen + 1
    joined.Append(piece)
  }
  return seen == 4 && joined.Text() == "abc" && CountPieces("a,b,c", ",") == 3 && CountPieces(
      "",
      ",") == 1 && PieceAt("one two three", " ", 1) == "two" && PieceAt(
      "one",
      " ",
      3) == ""
}

@Test
fun MakesNewStrings() -> bool uses unsafe {
  return Join(Pieces("a,b,c", ","), "-") == "a-b-c" && Replace(
      "a.b.c",
      ".",
      "/") == "a/b/c" && Replace("aaa", "aa", "b") == "ba" && Upper("Wolang 1") == "WOLANG 1" && Lower(
      "Wolang 1") == "wolang 1" && Repeat("ab", 3) == "ababab" && PadStart(
      "7",
      3,
      "0") == "007" && PadEnd("7", 3, ".") == "7.."
}

@Test
fun ReadsNumbers() -> bool uses unsafe {
  const seven = ParseInt("7") ?? -1
  const negative = ParseInt(" -42 ") ?? 0
  const broken = ParseInt("4a") == null
  const empty = ParseInt("") == null
  const half = ParseFloat("1.5") ?? 0.0
  const bad = ParseFloat("1.5x") == null
  return seven == 7 && negative == -42 && broken && empty && half > 1.49 && half < 1.51 && bad
}
