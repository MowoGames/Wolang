// Pictures from files: PNG, QOI and BMP, into one in-memory shape.
//
// Written here rather than bound to libpng, for the reason deflate is
// (D177): these are published byte layouts over arithmetic, and the
// code that reads them is the code a hostile file reaches first. Every
// length in a file is checked against what is left of the file, every
// size against a cap before anything is allocated, and the way out of a
// bad file is an error, never a trap (D245).
//
// The shape everything decodes to is `Image`: width, height, and four
// bytes per pixel, red, green, blue, alpha, rows top to bottom. `Get`
// hands a pixel back as `0xAARRGGBB`, which is what `gfx` canvases hold,
// so an image goes into a canvas with a loop and this package does not
// depend on `gfx`.

need std.compress.{Crc32, Deflate, InflateLimited}
need std.list.{List, ListNew}
need std.encoding.{FromHex}
need std.mem.{ArrayNew, Free, Prefix, Suffix}
need std.text.{Bytes}

/// The file is not what it says it is: bad signature, bad checksum, a
/// length that runs past the end, or data that stops early.
offer error Malformed

/// A real format feature this reader does not do (compressed BMP,
/// a PNG with an unknown critical chunk, ...).
offer error Unsupported

/// The picture is bigger than `kMaxSide` on a side or `kMaxPixels` in all.
offer error TooLarge

/// The longest side a picture may have.
offer const kMaxSide: int = 16384

/// The most pixels a picture may have (64 Mi, so 256 MiB of RGBA): a
/// header can claim any size, and the check happens before the buffer.
offer const kMaxPixels: int = 67108864

/// A picture: `width * height` pixels of RGBA, four bytes each.
///
/// Owns its storage and gives it back when it goes out of scope.
offer class Image {
  var pixels: []mut u8
  var width: int = 0
  var height: int = 0

  deinit  {
    Free(pixels)
  }

  /// Whether (x, y) is inside the picture.
  fun Contains(x: int, y: int) -> bool {
    return x >= 0 && y >= 0 && x < width && y < height
  }

  /// The pixel as `0xAARRGGBB`, or 0 outside the picture.
  fun Get(x: int, y: int) -> u32 {
    if !Contains(x, y) {
      return 0
    }
    const at = (y * width + x) * 4
    return pixels[at + 3] as u32 << 24 | pixels[at] as u32 << 16 | pixels[at + 1] as u32 << 8 | pixels[at + 2] as u32
  }

  /// Sets a pixel from `0xAARRGGBB`; outside the picture does nothing.
  fun Set(x: int, y: int, argb: u32) {
    if !Contains(x, y) {
      return
    }
    const at = (y * width + x) * 4
    pixels[at] = ((argb >> 16) % 256) as u8
    pixels[at + 1] = ((argb >> 8) % 256) as u8
    pixels[at + 2] = (argb % 256) as u8
    pixels[at + 3] = ((argb >> 24) % 256) as u8
  }
}

/// A transparent black picture of the given size, or `TooLarge`, or
/// `Malformed` when a side is not positive.
offer fun ImageNew(width: int, height: int) -> Image!(Malformed, TooLarge) uses unsafe {
  if width < 1 || height < 1 {
    return Malformed
  }
  if !SizeOk(width, height) {
    return TooLarge
  }
  var pixels = ArrayNew<u8>(width * height * 4)
  var i = 0
  while i < pixels.len {
    pixels[i] = 0
    i = i + 1
  }
  return Image(pixels, width, height)
}

fun SizeOk(width: int, height: int) -> bool {
  if width > kMaxSide || height > kMaxSide {
    return false
  }
  return width * height <= kMaxPixels
}

// ------------------------------------------------------------- helpers ---

fun Has(data: []u8, at: int, count: int) -> bool {
  return at >= 0 && count >= 0 && at <= data.len && count <= data.len - at
}

/// A big-endian 32-bit field. Anything at or above 2^31 answers 2^31 - 1
/// so every length and size check refuses it the same way (D245). `int` is
/// 64 bits (D238), and `SizeOk` bounds each side by `kMaxSide` before any
/// product is formed, so `width * height * 4` stays far below 2^63.
fun Be32(data: []u8, at: int) -> int {
  if data[at] >= 128 {
    return 2147483647
  }
  return data[at] as int * 16777216 + data[at + 1] as int * 65536 + data[at + 2] as int * 256 + data[at + 3] as int
}

/// The same field, exact, for checksums.
fun Be32u(data: []u8, at: int) -> u32 {
  return data[at] as u32 * 16777216 + data[at + 1] as u32 * 65536 + data[at + 2] as u32 * 256 + data[at + 3] as u32
}

/// A little-endian 32-bit field, clamped like `Be32`.
fun Le32(data: []u8, at: int) -> int {
  if data[at + 3] >= 128 {
    return 2147483647
  }
  return data[at + 3] as int * 16777216 + data[at + 2] as int * 65536 + data[at + 1] as int * 256 + data[at] as int
}

/// A little-endian signed 32-bit field.
fun Le32s(data: []u8, at: int) -> int {
  if data[at + 3] >= 128 {
    return (data[at + 3] as int - 256) * 16777216 + data[at + 2] as int * 65536 + data[at + 1] as int * 256 + data[at] as int
  }
  return Le32(data, at)
}

fun Le16(data: []u8, at: int) -> int {
  return data[at + 1] as int * 256 + data[at] as int
}

fun PutByte(out: &mut List<u8>, value: int) uses unsafe {
  out.Push(value as u8)
}

fun PutBe32(out: &mut List<u8>, value: int) uses unsafe {
  PutByte(out, value / 16777216 % 256)
  PutByte(out, value / 65536 % 256)
  PutByte(out, value / 256 % 256)
  PutByte(out, value % 256)
}

fun PutBe32u(out: &mut List<u8>, value: u32) uses unsafe {
  PutByte(out, (value / 16777216 % 256) as int)
  PutByte(out, (value / 65536 % 256) as int)
  PutByte(out, (value / 256 % 256) as int)
  PutByte(out, (value % 256) as int)
}

fun PutLe32(out: &mut List<u8>, value: int) uses unsafe {
  PutByte(out, value % 256)
  PutByte(out, value / 256 % 256)
  PutByte(out, value / 65536 % 256)
  PutByte(out, value / 16777216 % 256)
}

fun PutLe16(out: &mut List<u8>, value: int) uses unsafe {
  PutByte(out, value % 256)
  PutByte(out, value / 256 % 256)
}

/// A list's bytes as storage the caller owns.
fun Release(out: List<u8>) -> []u8 uses unsafe {
  var held = ArrayNew<u8>(out.Len())
  var i = 0
  while i < out.Len() {
    held[i] = out.At(i)
    i = i + 1
  }
  return held
}

fun Abs(x: int) -> int {
  if x < 0 {
    return 0 - x
  }
  return x
}

/// x modulo 256, for any int.
fun Wrap(x: int) -> int {
  return (x % 256 + 256) % 256
}

fun Adler32(data: []u8) -> u32 {
  var s1: u32 = 1
  var s2: u32 = 0
  var i = 0
  while i < data.len {
    s1 = (s1 + data[i] as u32) % 65521
    s2 = (s2 + s1) % 65521
    i = i + 1
  }
  return s2 * 65536 + s1
}

// ----------------------------------------------------------------- PNG ---

const kPngMagic: [8]int = [137, 80, 78, 71, 13, 10, 26, 10]
const kIhdr: int = 1229472850
const kPlte: int = 1347179589
const kIdat: int = 1229209940
const kIend: int = 1229278788
const kTrns: int = 1951551059

// Adam7: where each of the seven passes starts and steps.
const kPassX: [7]int = [0, 4, 0, 2, 0, 1, 0]
const kPassY: [7]int = [0, 0, 4, 0, 2, 0, 1]
const kPassDx: [7]int = [8, 8, 4, 4, 2, 2, 1]
const kPassDy: [7]int = [8, 8, 8, 4, 4, 2, 2]

/// What the header and the optional chunks said.
class PngInfo {
  var width: int = 0
  var height: int = 0
  var depth: int = 0
  var kind: int = 0
  var interlace: int = 0
  var palette: []mut u8
  var palette_count: int = 0
  /// Alpha per palette entry; 255 where a tRNS chunk did not say.
  var alpha: []mut u8
  var has_key: bool = false
  /// The colour tRNS marks as transparent, as full 16-bit samples.
  var key_r: int = 0
  var key_g: int = 0
  var key_b: int = 0
  var raw: []mut u8

  deinit  {
    Free(palette)
    Free(alpha)
    Free(raw)
  }

  fun Channels() -> int {
    if kind == 2 {
      return 3
    }
    if kind == 4 {
      return 2
    }
    if kind == 6 {
      return 4
    }
    return 1
  }
}

fun PngDepthOk(kind: int, depth: int) -> bool {
  if kind == 0 {
    return depth == 1 || depth == 2 || depth == 4 || depth == 8 || depth == 16
  }
  if kind == 3 {
    return depth == 1 || depth == 2 || depth == 4 || depth == 8
  }
  if kind == 2 || kind == 4 || kind == 6 {
    return depth == 8 || depth == 16
  }
  return false
}

/// How many bytes the inflated data of every pass must come to: a filter
/// byte and the packed row, for each row of each pass. Also the limit the
/// inflater is held to (D227).
fun PngRawSize(width: int, height: int, bits: int, interlace: int) -> int {
  var passes = 1
  if interlace == 1 {
    passes = 7
  }
  var total = 0
  var pass = 0
  while pass < passes {
    var x0 = 0
    var y0 = 0
    var dx = 1
    var dy = 1
    if interlace == 1 {
      x0 = kPassX[pass]
      y0 = kPassY[pass]
      dx = kPassDx[pass]
      dy = kPassDy[pass]
    }
    const pw = (width - x0 + dx - 1) / dx
    const ph = (height - y0 + dy - 1) / dy
    if pw > 0 && ph > 0 {
      total = total + ((pw * bits + 7) / 8 + 1) * ph
    }
    pass = pass + 1
  }
  return total
}

/// What filter `kind` predicts for byte `x` of the row at `cur`; `prev`
/// is where the row above starts, or -1 for the first row. The filtering
/// and the unfiltering share it, so they cannot drift apart.
fun Predict(data: []u8, cur: int, prev: int, x: int, bpp: int, kind: int) -> int {
  var a = 0
  var b = 0
  var c = 0
  if x >= bpp {
    a = data[cur + x - bpp] as int
  }
  if prev >= 0 {
    b = data[prev + x] as int
    if x >= bpp {
      c = data[prev + x - bpp] as int
    }
  }
  if kind == 1 {
    return a
  }
  if kind == 2 {
    return b
  }
  if kind == 3 {
    return (a + b) / 2
  }
  if kind == 4 {
    const p = a + b - c
    const pa = Abs(p - a)
    const pb = Abs(p - b)
    const pc = Abs(p - c)
    if pa <= pb && pa <= pc {
      return a
    }
    if pb <= pc {
      return b
    }
    return c
  }
  return 0
}

/// Undoes the filters of one pass in place. False for a filter type
/// that is not 0 to 4.
fun Unfilter(raw: []mut u8, start: int, rowbytes: int, rows: int, bpp: int) -> bool {
  var y = 0
  while y < rows {
    const row = start + y * (rowbytes + 1)
    const kind = raw[row] as int
    if kind > 4 {
      return false
    }
    const cur = row + 1
    var prev = -1
    if y > 0 {
      prev = cur - (rowbytes + 1)
    }
    var x = 0
    while x < rowbytes {
      raw[cur + x] = ((raw[cur + x] as int + Predict(
          raw,
          cur,
          prev,
          x,
          bpp,
          kind)) % 256) as u8
      x = x + 1
    }
    y = y + 1
  }
  return true
}

/// Sample number `index` of a row, at the file's bit depth, as the full
/// value (16-bit samples are two bytes).
fun Sample(raw: []u8, row: int, index: int, depth: int) -> int {
  if depth == 8 {
    return raw[row + index] as int
  }
  if depth == 16 {
    return raw[row + index * 2] as int * 256 + raw[row + index * 2 + 1] as int
  }
  const bit = index * depth
  const shift = 8 - depth - bit % 8
  var byte = raw[row + bit / 8] as int
  var s = 0
  while s < shift {
    byte = byte / 2
    s = s + 1
  }
  return byte % (1 << depth as int)
}

/// A sample scaled to 0..255.
fun Scale(value: int, depth: int) -> int {
  if depth == 8 {
    return value
  }
  if depth == 16 {
    return value / 256
  }
  return value * 255 / ((1 << depth as int) - 1)
}

/// Writes pixel `x` of the row at `row` as RGBA at `at`. False when a
/// palette index points past the palette.
fun PngPixel(raw: []u8, row: int, x: int, info: &PngInfo, dest: []mut u8, at: int) -> bool {
  const depth = info.depth
  var r = 0
  var g = 0
  var b = 0
  var a = 255
  if info.kind == 3 {
    const index = Sample(raw, row, x, depth)
    if index >= info.palette_count {
      return false
    }
    r = info.palette[index * 3] as int
    g = info.palette[index * 3 + 1] as int
    b = info.palette[index * 3 + 2] as int
    a = info.alpha[index] as int
  } else if info.kind == 0 {
    const v = Sample(raw, row, x, depth)
    r = Scale(v, depth)
    g = r
    b = r
    if info.has_key && v == info.key_g {
      a = 0
    }
  } else if info.kind == 2 {
    const vr = Sample(raw, row, x * 3, depth)
    const vg = Sample(raw, row, x * 3 + 1, depth)
    const vb = Sample(raw, row, x * 3 + 2, depth)
    r = Scale(vr, depth)
    g = Scale(vg, depth)
    b = Scale(vb, depth)
    if info.has_key && vr == info.key_r && vg == info.key_g && vb == info.key_b {
      a = 0
    }
  } else if info.kind == 4 {
    r = Scale(Sample(raw, row, x * 2, depth), depth)
    g = r
    b = r
    a = Scale(Sample(raw, row, x * 2 + 1, depth), depth)
  } else {
    r = Scale(Sample(raw, row, x * 4, depth), depth)
    g = Scale(Sample(raw, row, x * 4 + 1, depth), depth)
    b = Scale(Sample(raw, row, x * 4 + 2, depth), depth)
    a = Scale(Sample(raw, row, x * 4 + 3, depth), depth)
  }
  dest[at] = r as u8
  dest[at + 1] = g as u8
  dest[at + 2] = b as u8
  dest[at + 3] = a as u8
  return true
}

/// Reads a PNG: every colour type, bit depths 1 to 16 (16 is cut to 8),
/// all five filters, Adam7, `PLTE` and `tRNS`. Chunk checksums, the zlib
/// header and its Adler-32 are checked, and the inflater is held to the
/// size the header implies, so a small file cannot inflate into a large
/// one (D227, D245).
offer fun PngDecode(data: []u8) -> Image!(Malformed, TooLarge, Unsupported) uses unsafe {
  if !Has(data, 0, 8) {
    return Malformed
  }
  var i = 0
  while i < 8 {
    if data[i] as int != kPngMagic[i] {
      return Malformed
    }
    i = i + 1
  }
  var info = PngInfo(
      0,
      0,
      0,
      0,
      0,
      ArrayNew<u8>(768),
      0,
      ArrayNew<u8>(256),
      false,
      0,
      0,
      0,
      ArrayNew<u8>(0))
  i = 0
  while i < 256 {
    info.alpha[i] = 255
    i = i + 1
  }
  var idat = ListNew<u8>()
  var at = 8
  var seen_header = false
  var seen_data = false
  var seen_end = false
  while !seen_end {
    if !Has(data, at, 12) {
      return Malformed
    }
    const length = Be32(data, at)
    if !Has(data, at, 12 + length) {
      return Malformed
    }
    const kind = Be32(data, at + 4)
    const body = at + 8
    const stored = Be32u(data, body + length)
    const sum = Crc32(Prefix<u8>(Suffix<u8>(data, at + 4), length + 4))
    if sum != stored {
      return Malformed
    }
    if !seen_header && kind != kIhdr {
      return Malformed
    }
    if kind == kIhdr {
      if seen_header || length != 13 {
        return Malformed
      }
      seen_header = true
      info.width = Be32(data, body)
      info.height = Be32(data, body + 4)
      info.depth = data[body + 8] as int
      info.kind = data[body + 9] as int
      info.interlace = data[body + 12] as int
      if info.width < 1 || info.height < 1 {
        return Malformed
      }
      if data[body + 10] != 0 || data[body + 11] != 0 || info.interlace > 1 {
        return Malformed
      }
      if !PngDepthOk(info.kind, info.depth) {
        return Malformed
      }
      if !SizeOk(info.width, info.height) {
        return TooLarge
      }
    } else if kind == kPlte {
      if seen_data || length % 3 != 0 || length > 768 || length == 0 {
        return Malformed
      }
      i = 0
      while i < length {
        info.palette[i] = data[body + i]
        i = i + 1
      }
      info.palette_count = length / 3
    } else if kind == kTrns {
      if info.kind == 3 {
        if length > 256 {
          return Malformed
        }
        i = 0
        while i < length {
          info.alpha[i] = data[body + i]
          i = i + 1
        }
      } else if info.kind == 0 {
        if length != 2 {
          return Malformed
        }
        info.has_key = true
        info.key_g = data[body] as int * 256 + data[body + 1] as int
      } else if info.kind == 2 {
        if length != 6 {
          return Malformed
        }
        info.has_key = true
        info.key_r = data[body] as int * 256 + data[body + 1] as int
        info.key_g = data[body + 2] as int * 256 + data[body + 3] as int
        info.key_b = data[body + 4] as int * 256 + data[body + 5] as int
      }
    } else if kind == kIdat {
      seen_data = true
      i = 0
      while i < length {
        idat.Push(data[body + i])
        i = i + 1
      }
    } else if kind == kIend {
      seen_end = true
    } else if kind / 536870912 % 2 == 0 {
      // The top byte's fifth bit says "ancillary"; a critical chunk we
      // do not know is a file we cannot honestly read.
      return Unsupported
    }
    at = at + 12 + length
  }
  if !seen_data || idat.Len() < 7 {
    return Malformed
  }
  if info.kind == 3 && info.palette_count == 0 {
    return Malformed
  }

  const bits = info.depth * info.Channels()
  const total = PngRawSize(info.width, info.height, bits, info.interlace)
  const zlib = idat.Items()
  // CMF: deflate with a window up to 32K; FLG: header checksum and no
  // preset dictionary.
  if zlib[0] as int % 16 != 8 || zlib[0] as int / 16 > 7 {
    return Malformed
  }
  if (zlib[0] as int * 256 + zlib[1] as int) % 31 != 0 || zlib[1] as int / 32 % 2 != 0 {
    return Malformed
  }
  match InflateLimited(Prefix<u8>(Suffix<u8>(zlib, 2), zlib.len - 6), total) {
    Ok(inflated) => {
      Free(info.raw)
      info.raw = inflated
    }
    _ => {
      return Malformed
    }
  }
  if info.raw.len != total {
    return Malformed
  }
  if Adler32(info.raw) != Be32u(zlib, zlib.len - 4) {
    return Malformed
  }

  var image = ImageNew(info.width, info.height)?
  var bpp = bits / 8
  if bpp < 1 {
    bpp = 1
  }
  var passes = 1
  if info.interlace == 1 {
    passes = 7
  }
  var offset = 0
  var pass = 0
  while pass < passes {
    var x0 = 0
    var y0 = 0
    var dx = 1
    var dy = 1
    if info.interlace == 1 {
      x0 = kPassX[pass]
      y0 = kPassY[pass]
      dx = kPassDx[pass]
      dy = kPassDy[pass]
    }
    const pw = (info.width - x0 + dx - 1) / dx
    const ph = (info.height - y0 + dy - 1) / dy
    if pw > 0 && ph > 0 {
      const rowbytes = (pw * bits + 7) / 8
      if !Unfilter(info.raw, offset, rowbytes, ph, bpp) {
        return Malformed
      }
      var y = 0
      while y < ph {
        const row = offset + y * (rowbytes + 1) + 1
        var x = 0
        while x < pw {
          const at_pixel = ((y0 + y * dy) * info.width + x0 + x * dx) * 4
          if !PngPixel(info.raw, row, x, &info, image.pixels, at_pixel) {
            return Malformed
          }
          x = x + 1
        }
        y = y + 1
      }
      offset = offset + (rowbytes + 1) * ph
    }
    pass = pass + 1
  }
  return image
}

fun PngChunk(out: &mut List<u8>, kind: int, body: []u8) uses unsafe {
  PutBe32(out, body.len)
  var covered = ListNew<u8>()
  PutBe32(&mut covered, kind)
  var i = 0
  while i < body.len {
    covered.Push(body[i])
    i = i + 1
  }
  i = 0
  while i < covered.Len() {
    out.Push(covered.At(i))
    i = i + 1
  }
  PutBe32u(out, Crc32(covered.Items()))
}

/// Writes an RGBA8 PNG, choosing for each row whichever of the five
/// filters leaves the smallest sum of magnitudes (the usual heuristic),
/// then deflating. The caller owns the result.
offer fun PngEncode(image: &Image) -> []u8 uses unsafe {
  const rowbytes = image.width * 4
  var filtered = ListNew<u8>()
  var trial = ArrayNew<u8>(rowbytes)
  var best = ArrayNew<u8>(rowbytes)
  var y = 0
  while y < image.height {
    const cur = y * rowbytes
    var prev = -1
    if y > 0 {
      prev = cur - rowbytes
    }
    var best_kind = 0
    var best_cost = -1
    var kind = 0
    while kind < 5 {
      var cost = 0
      var x = 0
      while x < rowbytes {
        const v = Wrap(
            image.pixels[cur + x] as int - Predict(
                image.pixels,
                cur,
                prev,
                x,
                4,
                kind))
        trial[x] = v as u8
        if v < 128 {
          cost = cost + v
        } else {
          cost = cost + 256 - v
        }
        x = x + 1
      }
      if best_cost < 0 || cost < best_cost {
        best_cost = cost
        best_kind = kind
        x = 0
        while x < rowbytes {
          best[x] = trial[x]
          x = x + 1
        }
      }
      kind = kind + 1
    }
    PutByte(&mut filtered, best_kind)
    var x = 0
    while x < rowbytes {
      filtered.Push(best[x])
      x = x + 1
    }
    y = y + 1
  }
  Free(trial)
  Free(best)

  const scanlines = filtered.Items()
  const packed = Deflate(scanlines)
  var z = ListNew<u8>()
  PutByte(&mut z, 120)
  PutByte(&mut z, 1)
  var i = 0
  while i < packed.len {
    z.Push(packed[i])
    i = i + 1
  }
  PutBe32u(&mut z, Adler32(scanlines))
  Free(packed)

  var head = ListNew<u8>()
  PutBe32(&mut head, image.width)
  PutBe32(&mut head, image.height)
  PutByte(&mut head, 8)
  PutByte(&mut head, 6)
  PutByte(&mut head, 0)
  PutByte(&mut head, 0)
  PutByte(&mut head, 0)

  var out = ListNew<u8>()
  i = 0
  while i < 8 {
    PutByte(&mut out, kPngMagic[i])
    i = i + 1
  }
  PngChunk(&mut out, kIhdr, head.Items())
  PngChunk(&mut out, kIdat, z.Items())
  PngChunk(&mut out, kIend, ArrayNew<u8>(0))
  return Release(out)
}

// ----------------------------------------------------------------- QOI ---

const kQoiRgb: int = 254
const kQoiRgba: int = 255

fun QoiHash(r: int, g: int, b: int, a: int) -> int {
  return (r * 3 + g * 5 + b * 7 + a * 11) % 64
}

/// The signed difference `a - b` as a wrapped byte: -128 to 127.
fun Delta(a: int, b: int) -> int {
  return Wrap(a - b + 128) - 128
}

/// Reads a QOI file, all six operations. Anything after the last pixel
/// is ignored; running out of bytes before the last pixel is `Malformed`.
offer fun QoiDecode(data: []u8) -> Image!(Malformed, TooLarge) uses unsafe {
  if !Has(data, 0, 14) {
    return Malformed
  }
  if data[0] != 113 || data[1] != 111 || data[2] != 105 || data[3] != 102 {
    return Malformed
  }
  const width = Be32(data, 4)
  const height = Be32(data, 8)
  if width < 1 || height < 1 {
    return Malformed
  }
  if data[12] != 3 && data[12] != 4 {
    return Malformed
  }
  var image = ImageNew(width, height)?
  var index = ArrayNew<int>(256)
  var i = 0
  while i < 256 {
    index[i] = 0
    i = i + 1
  }
  var r = 0
  var g = 0
  var b = 0
  var a = 255
  var run = 0
  var at = 14
  var pixel = 0
  const count = width * height
  var ok = true
  while pixel < count && ok {
    if run > 0 {
      run = run - 1
    } else if !Has(data, at, 1) {
      ok = false
    } else {
      const tag = data[at] as int
      at = at + 1
      if tag == kQoiRgb {
        if Has(data, at, 3) {
          r = data[at] as int
          g = data[at + 1] as int
          b = data[at + 2] as int
          at = at + 3
        } else {
          ok = false
        }
      } else if tag == kQoiRgba {
        if Has(data, at, 4) {
          r = data[at] as int
          g = data[at + 1] as int
          b = data[at + 2] as int
          a = data[at + 3] as int
          at = at + 4
        } else {
          ok = false
        }
      } else if tag / 64 == 0 {
        const slot = tag * 4
        r = index[slot]
        g = index[slot + 1]
        b = index[slot + 2]
        a = index[slot + 3]
      } else if tag / 64 == 1 {
        r = Wrap(r + tag / 16 % 4 - 2)
        g = Wrap(g + tag / 4 % 4 - 2)
        b = Wrap(b + tag % 4 - 2)
      } else if tag / 64 == 2 {
        if Has(data, at, 1) {
          const second = data[at] as int
          at = at + 1
          const dg = tag % 64 - 32
          r = Wrap(r + dg + second / 16 - 8)
          g = Wrap(g + dg)
          b = Wrap(b + dg + second % 16 - 8)
        } else {
          ok = false
        }
      } else {
        run = tag % 64
      }
      if ok {
        const slot = QoiHash(r, g, b, a) * 4
        index[slot] = r
        index[slot + 1] = g
        index[slot + 2] = b
        index[slot + 3] = a
      }
    }
    if ok {
      image.pixels[pixel * 4] = r as u8
      image.pixels[pixel * 4 + 1] = g as u8
      image.pixels[pixel * 4 + 2] = b as u8
      image.pixels[pixel * 4 + 3] = a as u8
      pixel = pixel + 1
    }
  }
  Free(index)
  if !ok {
    return Malformed
  }
  return image
}

fun QoiFlush(out: &mut List<u8>, run: int) uses unsafe {
  if run > 0 {
    PutByte(out, 192 + run - 1)
  }
}

/// Writes a QOI file (four channels, sRGB) with the run, index, diff,
/// luma and literal operations. The caller owns the result.
offer fun QoiEncode(image: &Image) -> []u8 uses unsafe {
  var out = ListNew<u8>()
  PutByte(&mut out, 113)
  PutByte(&mut out, 111)
  PutByte(&mut out, 105)
  PutByte(&mut out, 102)
  PutBe32(&mut out, image.width)
  PutBe32(&mut out, image.height)
  PutByte(&mut out, 4)
  PutByte(&mut out, 0)
  var index = ArrayNew<int>(256)
  var i = 0
  while i < 256 {
    index[i] = 0
    i = i + 1
  }
  var pr = 0
  var pg = 0
  var pb = 0
  var pa = 255
  var run = 0
  const count = image.width * image.height
  var pixel = 0
  while pixel < count {
    const r = image.pixels[pixel * 4] as int
    const g = image.pixels[pixel * 4 + 1] as int
    const b = image.pixels[pixel * 4 + 2] as int
    const a = image.pixels[pixel * 4 + 3] as int
    if r == pr && g == pg && b == pb && a == pa {
      run = run + 1
      if run == 62 {
        QoiFlush(&mut out, run)
        run = 0
      }
    } else {
      QoiFlush(&mut out, run)
      run = 0
      const slot = QoiHash(r, g, b, a) * 4
      if index[slot] == r && index[slot + 1] == g && index[slot + 2] == b && index[slot + 3] == a {
        PutByte(&mut out, slot / 4)
      } else {
        index[slot] = r
        index[slot + 1] = g
        index[slot + 2] = b
        index[slot + 3] = a
        if a == pa {
          const dr = Delta(r, pr)
          const dg = Delta(g, pg)
          const db = Delta(b, pb)
          const drg = dr - dg
          const dbg = db - dg
          if dr >= -2 && dr <= 1 && dg >= -2 && dg <= 1 && db >= -2 && db <= 1 {
            PutByte(&mut out, 64 + (dr + 2) * 16 + (dg + 2) * 4 + db + 2)
          } else if dg >= -32 && dg <= 31 && drg >= -8 && drg <= 7 && dbg >= -8 && dbg <= 7 {
            PutByte(&mut out, 128 + dg + 32)
            PutByte(&mut out, (drg + 8) * 16 + dbg + 8)
          } else {
            PutByte(&mut out, kQoiRgb)
            PutByte(&mut out, r)
            PutByte(&mut out, g)
            PutByte(&mut out, b)
          }
        } else {
          PutByte(&mut out, kQoiRgba)
          PutByte(&mut out, r)
          PutByte(&mut out, g)
          PutByte(&mut out, b)
          PutByte(&mut out, a)
        }
      }
    }
    pr = r
    pg = g
    pb = b
    pa = a
    pixel = pixel + 1
  }
  QoiFlush(&mut out, run)
  i = 0
  while i < 7 {
    PutByte(&mut out, 0)
    i = i + 1
  }
  PutByte(&mut out, 1)
  Free(index)
  return Release(out)
}

// ----------------------------------------------------------------- BMP ---

/// Reads a BMP: 24 or 32 bits, uncompressed, bottom-up or top-down, with
/// a 40-byte or larger header. A 32-bit file's fourth byte is taken as
/// alpha. Palettes, RLE and bit fields are `Unsupported`.
offer fun BmpDecode(data: []u8) -> Image!(Malformed, TooLarge, Unsupported) uses unsafe {
  if !Has(data, 0, 26) {
    return Malformed
  }
  if data[0] != 66 || data[1] != 77 {
    return Malformed
  }
  const start = Le32(data, 10)
  const header = Le32(data, 14)
  if header < 40 || !Has(data, 14, header) {
    if header == 12 {
      return Unsupported
    }
    return Malformed
  }
  const width = Le32(data, 18)
  var height = Le32s(data, 22)
  var top_down = false
  if height < 0 {
    // -2^31 has no positive twin, so the size check comes first.
    if height < 0 - kMaxSide {
      return TooLarge
    }
    height = 0 - height
    top_down = true
  }
  if width < 1 || height < 1 {
    return Malformed
  }
  if !SizeOk(width, height) {
    return TooLarge
  }
  if Le16(data, 26) != 1 {
    return Malformed
  }
  const bits = Le16(data, 28)
  if bits != 24 && bits != 32 {
    return Unsupported
  }
  if Le32(data, 30) != 0 {
    return Unsupported
  }
  const stride = (width * bits + 31) / 32 * 4
  if !Has(data, start, stride * height) {
    return Malformed
  }
  var image = ImageNew(width, height)?
  const step = bits / 8
  var row = 0
  while row < height {
    var y = row
    if !top_down {
      y = height - 1 - row
    }
    const base = start + row * stride
    var x = 0
    while x < width {
      const from = base + x * step
      const to = (y * width + x) * 4
      image.pixels[to] = data[from + 2]
      image.pixels[to + 1] = data[from + 1]
      image.pixels[to + 2] = data[from]
      if step == 4 {
        image.pixels[to + 3] = data[from + 3]
      } else {
        image.pixels[to + 3] = 255
      }
      x = x + 1
    }
    row = row + 1
  }
  return image
}

/// Writes a 32-bit uncompressed bottom-up BMP, alpha in the fourth byte.
/// The caller owns the result.
offer fun BmpEncode(image: &Image) -> []u8 uses unsafe {
  const size = image.width * image.height * 4
  var out = ListNew<u8>()
  PutByte(&mut out, 66)
  PutByte(&mut out, 77)
  PutLe32(&mut out, 54 + size)
  PutLe32(&mut out, 0)
  PutLe32(&mut out, 54)
  PutLe32(&mut out, 40)
  PutLe32(&mut out, image.width)
  PutLe32(&mut out, image.height)
  PutLe16(&mut out, 1)
  PutLe16(&mut out, 32)
  PutLe32(&mut out, 0)
  PutLe32(&mut out, size)
  PutLe32(&mut out, 2835)
  PutLe32(&mut out, 2835)
  PutLe32(&mut out, 0)
  PutLe32(&mut out, 0)
  var y = image.height - 1
  while y >= 0 {
    var x = 0
    while x < image.width {
      const at = (y * image.width + x) * 4
      out.Push(image.pixels[at + 2])
      out.Push(image.pixels[at + 1])
      out.Push(image.pixels[at])
      out.Push(image.pixels[at + 3])
      x = x + 1
    }
    y = y - 1
  }
  return Release(out)
}

// ----------------------------------------------------------- the tests ---
//
// The PNG vectors were written by an independent encoder (a script using
// Python's zlib, with every filter type and Adam7 spelled out), and
// cross-read with Pillow; each is followed by the RGBA it must decode to.

fun Hex(value: text) -> []u8 uses unsafe {
  return Bytes(FromHex(value) ?? "")
}

fun SameBytes(a: []u8, b: []u8) -> bool {
  if a.len != b.len {
    return false
  }
  var i = 0
  while i < a.len {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fun PngIs(file: text, rgba: text) -> bool uses unsafe {
  match PngDecode(Hex(file)) {
    Ok(image) => {
      return SameBytes(image.pixels, Hex(rgba))
    }
    _ => {
      return false
    }
  }
}

@Test
fun DecodesPngGray1() -> bool uses unsafe {
  return PngIs(
      "89504e470d0a1a0a0000000d4948445200000009000000030100000000697118db0000000849444154789c6358c4c06878a4ecc5a400000009494441549ee97e03000b9403057367ff0c0000000049454e44ae426082",
      "ffffffff000000ffffffffff000000ff000000ff000000ffffffffff000000ff000000ff000000ff000000ffffffffffffffffff000000ff000000ff000000ffffffffff000000ff000000ff000000ff000000ffffffffff000000ff000000ff000000ff000000ffffffffff")
}

