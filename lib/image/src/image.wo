      "808080ff")
}

@Test
fun RefusesBrokenPngs() -> bool uses unsafe {
  return PngFails(
      "89504e470d0a1a0a0000000d49484452000000010100000108000000003a7e9b550000000a49444154789c636800000082008177cd72b60000000049454e44ae426082") && PngFails(
      "89504e470d0a1a0a773594004948445200000000000000000000000000") && PngFails(
      "89504e470d0a1a0a0000000d49484452000000010000000108000000003a7e9b550000000a49444154789ce36c00000094008a5fc0d5350000000049454e44ae426082") && PngFails(
      "89504e470d0a1a0a0000000d494844520000000100000001080300000028cb34bb00000003504c54450102030d8764d50000000a49444154789c636005000007000680cd628a0000000049454e44ae426082") && PngFails(
      "89504e470d0a1a0a0000000d494844520000000200000002080000000057dd52f80000000b49444154789c636868000001830101183522150000000049454e44ae426082") && PngFails(
      "89504e470d0a1a0a0000000d49484452000000010000000108000000003a7e9b550000000a49444154789d636800000082008160b666f50000000049454e44ae426082") && PngFails(
      "89504e470d0a1a0a0000000d49484452000000010000000108000000003a7e9b550000000a49444154789c636800000082008000ca42200000000049454e44ae426082") && PngFails(
      "89504e470d0a1a0a0000000d49484452000000010000000108000000003a7e9b550000000049454e44ae426082") && PngFails(
      "89504e470d0a1a0a0000000d4948445200000000000000010800000000d5bcf06b0000000049454e44ae426082") && PngFails(
      "89504e470d0a1a0a0000000d49484452000000010000000103000000004daeaa440000000049454e44ae426082") && PngFails(
      "") && PngFails("89504e47")
}

@Test
fun PngSaysWhyItRefused() -> bool uses unsafe {
  var seen = 0
  match PngDecode(
      Hex("89504e470d0a1a0a0000000d49484452000186a0000186a00806000000a8520bc8")) {
    Ok(_image) => seen = seen
    TooLarge => seen = seen + 1
    _ => seen = seen
  }
  match PngDecode(
      Hex("89504e470d0a1a0a0000000d4948445200004000000040000806000000a9c81084")) {
    Ok(_image) => seen = seen
    TooLarge => seen = seen + 1
    _ => seen = seen
  }
  match PngDecode(
      Hex(
          "89504e470d0a1a0a0000000d49484452000000010000000108000000003a7e9b550000000241424344787810ffab7c0000000a49444154789c636800000082008177cd72b60000000049454e44ae426082")) {
    Ok(_image) => seen = seen
    Unsupported => seen = seen + 1
    _ => seen = seen
  }
  match PngDecode(
      Hex(
          "89504e470d0a1a0a0000000d49484452000000010000000108000000003a7e9b550000000a49444154789c636800000082008177cd72b60000000049454e44ae426082")) {
    Ok(_image) => seen = seen + 1
    _ => seen = seen
  }
  return seen == 4
}

@Test
fun PngInflatesNoMoreThanItsHeaderSays() -> bool uses unsafe {
  // 200,000 zero bytes in a 1x1 picture: the limit is two bytes.
  return PngFails(
      "")
}

@Test
fun EveryTruncationOfAPngIsAnError() -> bool uses unsafe {
  const whole = Hex(
      "")
  var cut = 0
  while cut < whole.len {
    match PngDecode(Prefix<u8>(whole, cut)) {
      Ok(_image) => {
        return false
      }
      _ => cut = cut + 1
    }
  }
  return true
}

fun BmpIs(file: text, rgba: text) -> bool uses unsafe {
  match BmpDecode(Hex(file)) {
    Ok(image) => {
      return SameBytes(image.pixels, Hex(rgba))
    }
    _ => {
      return false
    }
  }
}

// Written by Pillow: 24-bit with row padding, and 32-bit.
@Test
fun DecodesBmp() -> bool uses unsafe {
  return BmpIs(
      "424d4e0000000000000036000000280000000300000002000000010018000000000018000000c40e0000c40e000000000000000000001748012b48293f48510000000302011702292b0251000000",
      "010203ff290217ff51022bff014817ff29482bff51483fff") && BmpIs(
      "424d460000000000000036000000280000000200000002000000010020000000000010000000c40e0000c40e00000000000000000000174801642b48296e030201641702296e",
      "010203642902176e0148176429482b6e")
}

@Test
fun DecodesTopDownBmp() -> bool uses unsafe {
  return BmpIs(
      "424d4e00000000000000360000002800000003000000feffffff010018000000000018000000c40e0000c40e000000000000000000000302011702292b02510000001748012b48293f4851000000",
      "010203ff290217ff51022bff014817ff29482bff51483fff")
}

@Test
fun RefusesBrokenBmps() -> bool uses unsafe {
  var refused = 0
  match BmpDecode(
      Hex(
          "424d4e0000000000000036000000280000000300000002000000010018000100000018000000c40e0000c40e000000000000000000001748012b48293f48510000000302011702292b0251000000")) {
    Ok(_image) => refused = refused
    Unsupported => refused = refused + 1
    _ => refused = refused
  }
  match BmpDecode(
      Hex(
          "424d4e000000000000003600000028000000a0860100a0860100010018000000000018000000c40e0000c40e000000000000000000001748012b48293f48510000000302011702292b0251000000")) {
    Ok(_image) => refused = refused
    TooLarge => refused = refused + 1
    _ => refused = refused
  }
  match BmpDecode(
      Hex(
          "424d4e0000000000000036000000280000000300000002000000010018000000000018000000c40e0000c40e000000000000000000001748012b48")) {
    Ok(_image) => refused = refused
    Malformed => refused = refused + 1
    _ => refused = refused
  }
  match BmpDecode(Hex("424d")) {
    Ok(_image) => refused = refused
    Malformed => refused = refused + 1
    _ => refused = refused
  }
  return refused == 4
}

@Test
fun EveryTruncationOfABmpIsAnError() -> bool uses unsafe {
  const whole = Hex(
      "424d460000000000000036000000280000000200000002000000010020000000000010000000c40e0000c40e00000000000000000000174801642b48296e030201641702296e")
  var cut = 0
  while cut < whole.len {
    match BmpDecode(Prefix<u8>(whole, cut)) {
      Ok(_image) => {
        return false
      }
      _ => cut = cut + 1
    }
  }
  return true
}

// One of every operation, worked out by hand from the specification.
@Test
fun DecodesEveryQoiOperation() -> bool uses unsafe {
  match QoiDecode(
      Hex(
          "716f696600000007000000010400fe0a141e79aaa5c109ff010203040000000000000001")) {
    Ok(image) => {
      return SameBytes(
          image.pixels,
          Hex("0a141eff0b141dff171e24ff171e24ff171e24ff0a141eff01020304"))
    }
    _ => {
      return false
    }
  }
}

@Test
fun RefusesBrokenQoi() -> bool uses unsafe {
  var refused = 0
  match QoiDecode(Hex("716f6966000186a0000186a004000000000000000000")) {
    Ok(_image) => refused = refused
    TooLarge => refused = refused + 1
    _ => refused = refused
  }
  match QoiDecode(Hex("71696f66")) {
    Ok(_image) => refused = refused
    Malformed => refused = refused + 1
    _ => refused = refused
  }
  match QoiDecode(Hex("00000000000000000000000000000000")) {
    Ok(_image) => refused = refused
    Malformed => refused = refused + 1
    _ => refused = refused
  }
  return refused == 3
}

@Test
fun EveryTruncationOfQoiIsAnError() -> bool uses unsafe {
  const whole = Hex("716f696600000007000000010400fe0a141e79aaa5c109ff01020304")
  var cut = 0
  while cut < whole.len {
    match QoiDecode(Prefix<u8>(whole, cut)) {
      Ok(_image) => {
        return false
      }
      _ => cut = cut + 1
    }
  }
  return true
}

// A picture with flat runs, gradients and noise, so every encoder
// operation (runs, index hits, diffs, lumas, literals, all five PNG
// filters) is exercised.
fun Sample37() -> Image uses unsafe {
  var image = Blank(37, 23)
  var seed = 12345
  var y = 0
  while y < 23 {
    var x = 0
    while x < 37 {
      seed = (seed * 75 + 74) % 65537
      var r = x * 6
      var g = y * 10
      var b = (x + y) * 3
      var a = 255
      if y < 5 {
        r = 200
        g = 100
        b = 50
      } else if y < 10 {
        r = seed % 256
        g = seed / 256
        b = seed * 7 % 256
        a = 255 - seed % 7
      } else if y > 18 && x % 2 == 0 {
        a = 0
      }
      image.Set(
          x,
          y,
          a as u32 << 24 | r as u32 << 16 | g as u32 << 8 | b as u32)
      x = x + 1
    }
    y = y + 1
  }
  return image
}

/// For tests, where the size is known to be fine.
fun Blank(width: int, height: int) -> Image uses unsafe {
  match ImageNew(width, height) {
    Ok(image) => {
      return image
    }
    _ => {
      return Image(ArrayNew<u8>(0), 0, 0)
    }
  }
}

fun SameImage(a: &Image, b: &Image) -> bool {
  return a.width == b.width && a.height == b.height && SameBytes(
      a.pixels,
      b.pixels)
}

@Test
fun PngRoundTrips() -> bool uses unsafe {
  const image = Sample37()
  const file = PngEncode(&image)
  match PngDecode(file) {
    Ok(back) => {
      return SameImage(&image, &back)
    }
    _ => {
      return false
    }
  }
}

@Test
fun QoiRoundTrips() -> bool uses unsafe {
  const image = Sample37()
  const file = QoiEncode(&image)
  match QoiDecode(file) {
    Ok(back) => {
      return SameImage(&image, &back) && file.len < 37 * 23 * 5
    }
    _ => {
      return false
    }
  }
}

@Test
fun BmpRoundTrips() -> bool uses unsafe {
  const image = Sample37()
  const file = BmpEncode(&image)
  match BmpDecode(file) {
    Ok(back) => {
      return SameImage(&image, &back) && file.len == 54 + 37 * 23 * 4
    }
    _ => {
      return false
    }
  }
}

@Test
fun AFlatPictureCompresses() -> bool uses unsafe {
  var image = Blank(16, 16)
  const png = PngEncode(&image)
  const qoi = QoiEncode(&image)
  return png.len < 150 && qoi.len < 60
}

@Test
fun ImageReadsAndWritesPixels() -> bool uses unsafe {
  var image = Blank(3, 2)
  image.Set(2, 1, 2148540464)
  image.Set(9, 9, 4294967295)
  return image.Get(2, 1) == 2148540464 && image.Get(0, 0) == 0 && image.Get(
      9,
      9) == 0 && image.pixels[(1 * 3 + 2) * 4] == 16 && image.pixels[(1 * 3 + 2) * 4 + 3] == 128
}

@Test
fun ImageNewRefusesWhatIsTooBig() -> bool uses unsafe {
  var seen = 0
  match ImageNew(kMaxSide + 1, 1) {
    Ok(_image) => seen = seen
    TooLarge => seen = seen + 1
    _ => seen = seen
  }
  match ImageNew(16384, 16384) {
    Ok(_image) => seen = seen
    TooLarge => seen = seen + 1
    _ => seen = seen
  }
  match ImageNew(0, 5) {
    Ok(_image) => seen = seen
    Malformed => seen = seen + 1
    _ => seen = seen
  }
  match ImageNew(4, 4) {
    Ok(_image) => seen = seen + 1
    _ => seen = seen
  }
  return seen == 4
}
