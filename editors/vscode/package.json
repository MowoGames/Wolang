{
  "name": "wolang",
  "displayName": "Wolang",
  "description": "Wolang language support: highlighting, diagnostics, hover, go to definition, symbols, formatting and completion.",
  "version": "0.1.0",
  "publisher": "mowogames",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MowoGames/Wolang"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Debuggers"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:wolang"
  ],
  "contributes": {
    "languages": [
      {
        "id": "wolang",
        "aliases": [
          "Wolang",
          "wolang"
        ],
        "extensions": [
          ".wo"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "wolang",
        "scopeName": "source.wolang",
        "path": "./syntaxes/wolang.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Wolang",
      "properties": {
        "wolang.path": {
          "type": "string",
          "default": "wolang",
          "description": "The wolang executable. `wolang lsp` is what this extension speaks to."
        },
        "wolang.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the traffic between the editor and the language server."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "wolang",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "check, test, build or run"
          },
          "package": {
            "type": "string",
            "description": "The package directory."
          }
        }
      }
    ],
    "commands": [
      {
        "command": "wolang.check",
        "title": "Wolang: Check",
        "category": "Wolang"
      },
      {
        "command": "wolang.test",
        "title": "Wolang: Test",
        "category": "Wolang"
      },
      {
        "command": "wolang.build",
        "title": "Wolang: Build",
        "category": "Wolang"
      },
      {
        "command": "wolang.run",
        "title": "Wolang: Run",
        "category": "Wolang"
      },
      {
        "command": "wolang.restart",
        "title": "Wolang: Restart the language server",
        "category": "Wolang"
      }
    ]
  },
  "scripts": {
    "package": "python3 ../../tools/package/make_vsix.py"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0E1222",
    "theme": "dark"
  },
  "keywords": [
    "wolang",
    "systems",
    "gamedev",
    "compiler",
    "lsp"
  ],
  "bugs": {
    "url": "https://github.com/MowoGames/Wolang/issues"
  },
  "homepage": "https://github.com/MowoGames/Wolang",
  "qna": "https://github.com/MowoGames/Wolang/discussions"
}
