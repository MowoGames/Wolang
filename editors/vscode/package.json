{
  "name": "wolang",
  "displayName": "Wolang",
  "description": "Wolang language support: highlighting, diagnostics, hover, go to definition, symbols, formatting and completion.",
  "version": "0.1.1",
  "publisher": "mowogroup",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MowoGames/Wolang"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Debuggers"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:wolang",
    "onDebugResolve:wolang"
  ],
  "contributes": {
    "languages": [
      {
        "id": "wolang",
        "aliases": [
          "Wolang",
          "wolang"
        ],
        "extensions": [
          ".wo"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "wolang",
        "scopeName": "source.wolang",
        "path": "./syntaxes/wolang.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Wolang",
      "properties": {
        "wolang.path": {
          "type": "string",
          "default": "wolang",
          "description": "The wolang executable. `wolang lsp` is what this extension speaks to."
        },
        "wolang.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the traffic between the editor and the language server."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "wolang",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "check, test, build or run"
          },
          "package": {
            "type": "string",
            "description": "The package directory."
          }
        }
      }
    ],
    "commands": [
      {
        "command": "wolang.check",
        "title": "Wolang: Check",
        "category": "Wolang"
      },
      {
        "command": "wolang.test",
        "title": "Wolang: Test",
        "category": "Wolang"
      },
      {
        "command": "wolang.build",
        "title": "Wolang: Build",
        "category": "Wolang"
      },
      {
        "command": "wolang.run",
        "title": "Wolang: Run",
        "category": "Wolang"
      },
      {
        "command": "wolang.restart",
        "title": "Wolang: Restart the language server",
        "category": "Wolang"
      }
    ],
    "breakpoints": [
      {
        "language": "wolang"
      }
    ],
    "debuggers": [
      {
        "type": "wolang",
        "label": "Wolang",
        "languages": [
          "wolang"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The package directory or `.wo` file whose `main` to run.",
                "default": "${workspaceFolder}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the first line.",
                "default": false
              }
            }
          },
          "attach": {
            "required": [
              "port"
            ],
            "properties": {
              "port": {
                "type": "number",
                "description": "The port a host opened with `wolang_vm_debug_listen`.",
                "default": 4711
              },
              "host": {
                "type": "string",
                "description": "Where the host runs.",
                "default": "127.0.0.1"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "wolang",
            "request": "launch",
            "name": "Wolang: run this package",
            "program": "${workspaceFolder}"
          },
          {
            "type": "wolang",
            "request": "attach",
            "name": "Wolang: attach to the engine",
            "port": 4711
          }
        ],
        "configurationSnippets": [
          {
            "label": "Wolang: Launch",
            "description": "Run a package on the interpreter and debug it.",
            "body": {
              "type": "wolang",
              "request": "launch",
              "name": "Wolang: run this package",
              "program": "^\"\\${workspaceFolder}\""
            }
          },
          {
            "label": "Wolang: Attach",
            "description": "Debug the scripts of a running host.",
            "body": {
              "type": "wolang",
              "request": "attach",
              "name": "Wolang: attach to the engine",
              "port": 4711
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "package": "py ../../tools/package/make_vsix.py"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0E1222",
    "theme": "dark"
  },
  "keywords": [
    "wolang",
    "systems",
    "gamedev",
    "compiler",
    "lsp"
  ],
  "bugs": {
    "url": "https://github.com/MowoGames/Wolang/issues"
  },
  "homepage": "https://github.com/MowoGames/Wolang",
  "qna": "https://github.com/MowoGames/Wolang/discussions"
}
