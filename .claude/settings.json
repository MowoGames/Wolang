{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opusplan",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "BASH_MAX_OUTPUT_LENGTH": "20000",
    "MAX_MCP_OUTPUT_TOKENS": "10000"
  },
  "permissions": {
    "allow": [
      "Bash(.claude/scripts/wl:*)",
      "Bash(.claude/scripts/decision:*)",
      "Bash(cmake --preset:*)",
      "Bash(cmake --build:*)",
      "Bash(ctest:*)",
      "Bash(build/debug/tools/wolang/wolang:*)",
      "Bash(build/debug/tests/wolang_tests:*)",
      "Bash(python3 tools/package/check_includes.py)",
      "Bash(python3 tools/package/check_docs.py)",
      "Bash(clang-format:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(rg:*)"
    ],
    "deny": [
      "Edit(include/wolang/base/unicode_tables.inc)",
      "Write(include/wolang/base/unicode_tables.inc)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session_start.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_big_reads.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format_wo.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
