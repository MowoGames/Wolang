// A gameplay class written in Wolang, used as the corpus the parser and the
// formatter are tested on.
//
// `wolang check` on this file reports unknown names: it is a single file, so
// its imports resolve to nothing, and class members are not resolved until
// wave 5. For an example that type checks end to end, see `examples/package`.

need engine.gameplay
need engine.math.{Vec3, Quat}

dimension Length
dimension Time

unit m: Length
unit cm = 0.01m
unit s: Time
unit ms = 0.001s

/// A turret that scans for targets and fires at the closest one.
@Spawnable
class Turret : Actor {
  @Edit @Range(1, 50) var range: float = 15.0
  @Edit var fire_rate: float = 2.0
  @Replicated var health: int = 100

  // `component` is the keyword that declares an ECS component, so attaching a
  // sub-object is an ordinary host function instead.
  let muzzle = attach<SceneComponent>("Muzzle")
  var target: Weak<Pawn>

  signal Destroyed(by: Actor?)

  derived var is_alive: bool => health > 0

  override fun BeginPlay() {
    spawn ScanLoop()
  }

  async fun ScanLoop() uses rand {
    loop {
      target = World.Overlap<Pawn>(position, range).Closest(position)

      if let t = target.alive {
        rotation = Quat.LookAt(t.position - position)
        Fire(t)
        await Wait(1.0 / fire_rate)
      } else {
        await Wait(0.25s)
      }
    }
  }

  @Server
  fun Fire(t: Pawn) {
    let direction = (t.position - muzzle.position).normalized
    World.Spawn<Projectile>(muzzle.position, direction) { speed = 40.0 }
  }

  on TakeDamage(amount: int, from: Actor?) {
    health -= amount

    if health <= 0 {
      Destroyed.Emit(from)
      Destroy()
    }
  }
}

machine Door {
  state Closed {
    on Interact -> Opening
  }
  state Opening {
    enter { await animation.Play("Open") }
    always -> Open
  }
  state Open {
    on Interact after 3s -> Closing
  }
  state Closing {
    enter { await animation.Play("Close") }
    always -> Closed
  }
}

// Layout belongs to the storage, not to the type: the same `Particle` is one
// value here and seven parallel arrays below.
struct Particle {
  var position: Vec3
  var velocity: Vec3
  var life: float
}

var burst: soa [Particle]
var prototype: Particle

error NoTarget, OutOfAmmo

// `T?` may be absent, `T!` may fail; both are postfix, so a type reads left
// to right.
fun PickTarget(candidates: [Pawn]) -> Pawn?! uses rand {
  if candidates.len == 0 {
    return NoTarget
  }
  return candidates[0]
}

extend Vec3 {
  fun Flat() -> Vec3 => Vec3(x, 0.0, z)
}

extend Barrel as Damageable {
  fun TakeDamage(amount: float, from: Actor?) {
    Explode()
  }
}

system Integrate(dt: float, q: Query<mut Transform, Velocity>) after Gravity {
  foreach (t, v) in q {
    t.position += v.value * dt
  }
}

fun Describe(count: int?) -> String {
  // Optionals need no Some/None vocabulary: the type says `int?`, the pattern
  // says `n?`, and absence is spelled `null`.
  match count {
    n? => "{n} left"
    null => "unknown"
  }
}

fun Search(grid: [[Cell]]) -> Cell? {
  outer: for row in grid {
    for cell in row[1..] {
      if cell.matches {
        return cell
      }
      if cell.blocked {
        break outer
      }
    }
  }
  return null
}

fun DescribeHealth(hp: int, max: int) -> String {
  return "hp {hp} / {max} ({hp * 100 / max}%)"
}

comptime fun Validate(rate: float) {
  assert(rate > 0.0, "fire rate must be positive")
}
