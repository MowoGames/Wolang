// An API, in Wolang.
//
// A router, path parameters, a query string, JSON in and out -- over
// `wolang-http`, which is itself Wolang over the eight socket calls in
// `http.socket`. Nothing in this file is unsafe: the responsibility stops
// at the floor, which is what `uses unsafe` on a declaration means.

need std.env.{Get}
need std.io.{Print}
need std.doc.{AsText, Member, Null, Object, OfInt, OfText, Put}
need std.json.{Malformed, Parse, Write}
need std.log.{Level, SetLevel}
need http.{AppNew, Authorize, Cors, Logged, SecurityHeaders, ServeApp,
           ServeMany, Timing, BadRequest, Created, Field, JsonOf,
           NoContent, Ok, OkJson, Param, Problem, Query, QueryInt,
           Request, RequireToken, Response, RouterNew, ServeUnder,
           ParseSigned, Unprocessable, WithCache, WithCookie}

fun Home(_request: Request) -> Response uses unsafe {
  return Ok("wolang\n")
}

fun Health(_request: Request) -> Response uses unsafe {
  return OkJson("\{\"status\":\"ok\"\}\n")
}

// `/hello?name=...`, which is what a query string is for.
fun Hello(request: Request) -> Response uses unsafe {
  const name = Query(&request, "name", "world")
  return Ok("hello, {name}\n")
}

// `/users/:id`, answered as JSON built rather than spelled.
fun User(request: Request) -> Response uses unsafe {
  const id = Param(&request, "id", "0")
  var user = Object()
  user = Put(user, "id", OfText(id))
  user = Put(user, "name", OfText("user {id}"))
  user = Put(user, "visits", OfInt(3))
  return OkJson(Write(user) + "\n")
}

// A POST with a JSON body: read a field out of it and answer with where
// the thing would be.
fun CreateUser(request: Request) -> Response uses unsafe {
  match Parse(request.body) {
    Ok(document) => {
      const name = AsText(Member(document, "name") ?? Null(), "")
      if name == "" {
        return BadRequest("a user needs a name\n")
      }
      var created = Object()
      created = Put(created, "name", OfText(name))
      created = Put(created, "id", OfInt(7))
      return Created("/users/7", Write(created) + "\n")
    },
    Malformed => { return BadRequest("that is not JSON\n") },
  }
}

fun Missing(_request: Request) -> Response uses unsafe {
  return Problem(404, "not found", "no route for that path")
}

// A page of something, which is what `?page=&size=` is for -- and the
// place a typed query parameter earns its keep.
fun ListUsers(request: Request) -> Response uses unsafe {
  const page = QueryInt(&request, "page", 1)
  const size = QueryInt(&request, "size", 20)
  if size < 1 || size > 100 {
    return Unprocessable("size has to be between 1 and 100\n")
  }
  var body = Object()
  body = Put(body, "page", OfInt(page))
  body = Put(body, "size", OfInt(size))
  body = Put(body, "total", OfInt(0))
  return WithCache(JsonOf(body), 30)
}

// A form submission, which is a body of `a=1&b=2` rather than JSON.
fun SignIn(request: Request) -> Response uses unsafe {
  const name = Field(&request, "name", "")
  const password = Field(&request, "password", "")
  if name == "" || password == "" {
    return BadRequest("a name and a password\n")
  }
  // A real one checks the password; this one shows what the answer looks
  // like when it passes.
  return WithCookie(NoContent(), "session", "token-for-{name}", 3600)
}

// Something only a request with the right token may do, through the
// layer rather than through a check here.
fun Secret(_request: Request) -> Response uses unsafe {
  return Ok("the secret\n")
}

// Everything under `/static/` off the disk, with the path checked.
fun Static(request: Request) -> Response uses unsafe {
  return ServeUnder("examples/server/public", &request, "/static/")
}

fun main() uses io, unsafe {
  var api = RouterNew()
  api.Get("/users", ListUsers)
  api.Get("/users/:id", User)
  api.Post("/users", CreateUser)

  var app = AppNew()
  // Anything the token layer is told about needs it; with no token set,
  // the layer lets everything through, which is what makes it safe to
  // install unconditionally.
  RequireToken("")
  app.Use(Authorize)
  app.Get("/", Home)
  app.Get("/health", Health)
  app.Get("/hello", Hello)
  app.Post("/sign-in", SignIn)
  app.Get("/secret", Secret)
  app.Get("/static/*", Static)
  // The same routes under a prefix, which is what versioning an API is.
  app.Mount("/api/v1", &api)
  app.Otherwise(Missing)

  Print("server: http://127.0.0.1:8080")
  // `WOLANG_QUIET` turns the usual layers off, which is how the same
  // example serves as a benchmark: a line per request to standard error
  // is most of what a small response costs.
  // `WOLANG_QUIET=1` says nothing per request, which is how the same
  // example serves as a benchmark: a line to standard error is most of
  // what a small response costs.
  if Get("WOLANG_QUIET", "") == "1" {
    SetLevel(Level.Warning)
  } else {
    app.Use(Timing)
    app.Then(Logged)
  }
  app.Then(SecurityHeaders)
  app.Then(Cors)

  // `WOLANG_THREADS=0` is one per core, anything else is that many.
  const threads = ParseSigned(Get("WOLANG_THREADS", "1"), 1)
  if threads != 1 {
    const _many = ServeMany(app, 8080, 512, threads)
    return
  }
  const _code = ServeApp(app, 8080, 512)
}
