// The root module of the package is named after the package itself: `demo`.
need demo.engine.{Report, m, s}
need demo.combat.{Falloff, TravelTime}

fun main() {
  const reach = 3m

  // Units are checked at compile time and cost nothing at runtime: swapping
  // these two arguments would not compile.
  const damage = Falloff(10.0, 1m, reach)

  const speed = 2m / 1s
  const eta = TravelTime(reach, speed)

  Report(damage, eta)
}
