need std.list.{List, ListNew}

offer fun Score(n: int, scale: float = 1.5, label: text?) -> int! uses io, unsafe {
  var total = n * 2 + 1 << 3 | 4
  const parts = [1, 2, 0x1F, 2.5e3, 10m, 7u8]
  const pair = (n, "x{n + 1}y", 'z', '\n')
  for i in 0..=n {
    if i % 2 == 0 && !(i > 9) {
      total += i
    } else if const found = label {
      total = total ?? found.len
    } else {
      continue
    }
  }
  outer: while total > 0 {
    break outer
  }
  const doubled = parts.Map(|x, mut y: int| x * 2)
  const read = Convert<List<int>>(parts)?.first?.value
  const cast = total as float
  defer { total = 0 }
  return match total {
    0 | 1 => 10
    n if n > 5 => 20
    Point { x, y: inner } => x + inner
    Shape.Circle(radius) => radius
    value? => value
    null => 0
    _ => -1
  }
}
