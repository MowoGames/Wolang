need std.map.{Map, TextMapNew}

offer enum Kind {
  EndOfFile
  Unknown
  Identifier
  IntLiteral
  FloatLiteral
  StringLiteral
  CharLiteral
  DocComment
  LeftParen
  RightParen
  LeftBrace
  RightBrace
  LeftBracket
  RightBracket
  Comma
  Semicolon
  Colon
  Dot
  DotDot
  DotDotEq
  Arrow
  FatArrow
  At
  Underscore
  Plus
  PlusEq
  Minus
  MinusEq
  Star
  StarEq
  Slash
  SlashEq
  Percent
  PercentEq
  Eq
  EqEq
  Bang
  BangEq
  Less
  LessEq
  Greater
  GreaterEq
  Shl
  ShlEq
  Shr
  ShrEq
  Amp
  AmpEq
  AmpAmp
  Pipe
  PipeEq
  PipePipe
  Caret
  CaretEq
  Tilde
  Question
  QuestionDot
  QuestionQuestion
  QuestionQuestionEq
  KwAbility
  KwAfter
  KwArena
  KwAs
  KwBefore
  KwBreak
  KwClass
  KwComponent
  KwConst
  KwComptime
  KwContinue
  KwDefer
  KwElse
  KwEnum
  KwError
  KwExtend
  KwExtern
  KwFalse
  KwFor
  KwForeach
  KwFun
  KwIf
  KwIn
  KwLoop
  KwMatch
  KwMut
  KwNeed
  KwNull
  KwOn
  KwOffer
  KwOverride
  KwPtrNull
  KwPriv
  KwReturn
  KwSelf
  KwSignal
  KwSpawn
  KwStruct
  KwSystem
  KwTag
  KwTask
  KwTrue
  KwType
  KwUnsafe
  KwUses
  KwWait
  KwVar
  KwVirtual
  KwWhere
  KwWhile
}

offer fun KindName(kind: Kind) -> text {
  return match kind {
    Kind.EndOfFile => "EndOfFile"
    Kind.Unknown => "Unknown"
    Kind.Identifier => "Identifier"
    Kind.IntLiteral => "IntLiteral"
    Kind.FloatLiteral => "FloatLiteral"
    Kind.StringLiteral => "StringLiteral"
    Kind.CharLiteral => "CharLiteral"
    Kind.DocComment => "DocComment"
    Kind.LeftParen => "LeftParen"
    Kind.RightParen => "RightParen"
    Kind.LeftBrace => "LeftBrace"
    Kind.RightBrace => "RightBrace"
    Kind.LeftBracket => "LeftBracket"
    Kind.RightBracket => "RightBracket"
    Kind.Comma => "Comma"
    Kind.Semicolon => "Semicolon"
    Kind.Colon => "Colon"
    Kind.Dot => "Dot"
    Kind.DotDot => "DotDot"
    Kind.DotDotEq => "DotDotEq"
    Kind.Arrow => "Arrow"
    Kind.FatArrow => "FatArrow"
    Kind.At => "At"
    Kind.Underscore => "Underscore"
    Kind.Plus => "Plus"
    Kind.PlusEq => "PlusEq"
    Kind.Minus => "Minus"
    Kind.MinusEq => "MinusEq"
    Kind.Star => "Star"
    Kind.StarEq => "StarEq"
    Kind.Slash => "Slash"
    Kind.SlashEq => "SlashEq"
    Kind.Percent => "Percent"
    Kind.PercentEq => "PercentEq"
    Kind.Eq => "Eq"
    Kind.EqEq => "EqEq"
    Kind.Bang => "Bang"
    Kind.BangEq => "BangEq"
    Kind.Less => "Less"
    Kind.LessEq => "LessEq"
    Kind.Greater => "Greater"
    Kind.GreaterEq => "GreaterEq"
    Kind.Shl => "Shl"
    Kind.ShlEq => "ShlEq"
    Kind.Shr => "Shr"
    Kind.ShrEq => "ShrEq"
    Kind.Amp => "Amp"
    Kind.AmpEq => "AmpEq"
    Kind.AmpAmp => "AmpAmp"
    Kind.Pipe => "Pipe"
    Kind.PipeEq => "PipeEq"
    Kind.PipePipe => "PipePipe"
    Kind.Caret => "Caret"
    Kind.CaretEq => "CaretEq"
    Kind.Tilde => "Tilde"
    Kind.Question => "Question"
    Kind.QuestionDot => "QuestionDot"
    Kind.QuestionQuestion => "QuestionQuestion"
    Kind.QuestionQuestionEq => "QuestionQuestionEq"
    Kind.KwAbility => "KwAbility"
    Kind.KwAfter => "KwAfter"
    Kind.KwArena => "KwArena"
    Kind.KwAs => "KwAs"
    Kind.KwBefore => "KwBefore"
    Kind.KwBreak => "KwBreak"
    Kind.KwClass => "KwClass"
    Kind.KwComponent => "KwComponent"
    Kind.KwConst => "KwConst"
    Kind.KwComptime => "KwComptime"
    Kind.KwContinue => "KwContinue"
    Kind.KwDefer => "KwDefer"
    Kind.KwElse => "KwElse"
    Kind.KwEnum => "KwEnum"
    Kind.KwError => "KwError"
    Kind.KwExtend => "KwExtend"
    Kind.KwExtern => "KwExtern"
    Kind.KwFalse => "KwFalse"
    Kind.KwFor => "KwFor"
    Kind.KwForeach => "KwForeach"
    Kind.KwFun => "KwFun"
    Kind.KwIf => "KwIf"
    Kind.KwIn => "KwIn"
    Kind.KwLoop => "KwLoop"
    Kind.KwMatch => "KwMatch"
    Kind.KwMut => "KwMut"
    Kind.KwNeed => "KwNeed"
    Kind.KwNull => "KwNull"
    Kind.KwOn => "KwOn"
