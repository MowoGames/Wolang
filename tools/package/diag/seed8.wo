fun Live() -> int uses unsafe {
  return wolang_objects_live() as int
}

fun Probe() -> int uses unsafe {
  const before = Live()
  const result = Body()
  const after = Live()
  if after != before {
    return 0 - 1000000 - (after - before)
  }
  return result
}

